---
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../components/JobCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import MonetizationSlot from '../../components/MonetizationSlot.astro';
import { PROVINCE_HUBS } from '../../content/province-hubs';
import { SALARY_GUIDES } from '../../content/salary-guides';
import { ARTICLES } from '../../content/resources';
import { getJobs, getEmployers, slugify } from '../../lib/pocketbase';
import { SITE_URL } from '../../lib/constants';

const { slug } = Astro.params;
const hub = PROVINCE_HUBS.find(h => h.slug === slug);
if (!hub) return Astro.redirect('/404');

// Live data from PocketBase
const { items: jobs, totalItems } = await getJobs({ province: hub.name, perPage: 6 });
const employersResult = await getEmployers({ province: hub.name, perPage: 6 }).catch(() => ({ items: [] as any[] }));
const employers = (employersResult as any).items || [];

// Related content
const salaryPicks = SALARY_GUIDES.slice(0, 4);
const articlePicks = ARTICLES.filter(a => a.featured).slice(0, 4);

const canonical = `${SITE_URL}/province/${hub.hubSlug}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Provinces', item: `${SITE_URL}/provinces` },
    { '@type': 'ListItem', position: 3, name: `${hub.name} Careers` },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Careers & Jobs in ${hub.name}`,
  description: hub.description,
  dateModified: '2026-07-01',
  datePublished: '2026-07-01',
  author: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hub.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={hub.title} description={hub.description} canonicalUrl={canonical} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <main>
      <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gray-900">Home</a> &rsaquo;
        <a href="/provinces" class="hover:text-gray-900">Provinces</a> &rsaquo;
        <span class="text-gray-900 font-medium">{hub.name} Careers</span>
      </nav>

      <header class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Careers &amp; Jobs in {hub.name}</h1>
        <p class="text-sm text-gray-500">{totalItems.toLocaleString()} live jobs in {hub.name} on Edubuzz</p>
      </header>

      <MonetizationSlot zone="content-top" />

      <section class="prose prose-sm max-w-none prose-p:text-gray-700 mb-8" set:html={hub.overview} />

      <!-- Fast-growing industries -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Fast-growing industries in {hub.name}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {hub.industries.map(ind => (
            <div class="border border-gray-200 rounded-md p-4">
              <h3 class="text-sm font-semibold text-gray-900 mb-1">{ind.name}</h3>
              <p class="text-xs text-gray-600">{ind.note}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Major employers -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Major employers in {hub.name}</h2>
        <div class="flex flex-wrap gap-2">
          {hub.majorEmployers.map(emp => (
            <span class="inline-block px-3 py-1.5 bg-gray-50 border border-gray-200 rounded-full text-xs text-gray-700">{emp}</span>
          ))}
        </div>
      </section>

      <!-- Live jobs -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Latest jobs in {hub.name}</h2>
        {jobs.length > 0 ? (
          <div class="space-y-3">
            {jobs.map(job => <JobCard job={job} />)}
          </div>
        ) : (
          <p class="text-sm text-gray-500">No live jobs in {hub.name} right now. Check back soon or browse all jobs.</p>
        )}
        <a href={`/province/${hub.slug}`} class="inline-block mt-3 text-sm text-green-800 hover:underline font-medium">View all {hub.name} jobs &rarr;</a>
      </section>

      <MonetizationSlot zone="in-content" />

      <!-- Featured employers with pages -->
      {employers.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Companies hiring in {hub.name}</h2>
          <div class="flex flex-wrap gap-2">
            {employers.map((emp: any) => (
              <a href={`/company/${emp.company_slug}`} class="inline-block px-3 py-1.5 bg-green-50 border border-green-200 rounded-full text-xs text-green-800 hover:bg-green-100">{emp.company_name}</a>
            ))}
          </div>
        </section>
      )}

      <!-- Opportunity types -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Opportunities in {hub.name}</h2>
        <div class="flex flex-wrap gap-2">
          <a href="/learnerships" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">Learnerships</a>
          <a href="/internships" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">Internships</a>
          <a href="/graduate-jobs" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">Graduate Jobs</a>
          <a href="/remote-jobs" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">Remote Jobs</a>
          <a href="/resources/tvet-colleges-and-nsfas-guide" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">TVET & NSFAS</a>
          <a href="/bursaries" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">Bursaries</a>
        </div>
      </section>

      <!-- Related salary guides -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Salary guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {salaryPicks.map(g => (
            <a href={`/salary/${g.slug}`} class="border border-gray-200 rounded-md p-3 hover:border-green-800">
              <span class="text-sm font-semibold text-gray-900">{g.occupation}</span>
              <span class="block text-xs text-green-800">{g.averageSalary}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Related resources -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Career resources</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {articlePicks.map(a => (
            <a href={`/resources/${a.slug}`} class="border border-gray-200 rounded-md p-3 hover:border-green-800">
              <span class="text-sm font-semibold text-gray-900">{a.h1}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {hub.faqs.map(faq => (
            <details class="border border-gray-200 rounded-md p-4 group">
              <summary class="font-medium text-sm text-gray-900 cursor-pointer group-open:mb-2">{faq.q}</summary>
              <p class="text-sm text-gray-600 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Other provinces -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Careers in other provinces</h2>
        <div class="flex flex-wrap gap-2">
          {PROVINCE_HUBS.filter(p => p.slug !== hub.slug).map(p => (
            <a href={`/province/${p.hubSlug}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">{p.name}</a>
          ))}
        </div>
      </section>

      <MonetizationSlot zone="content-bottom" />
    </main>

    <aside class="hidden lg:block"><Sidebar /></aside>
  </div>
</Layout>
