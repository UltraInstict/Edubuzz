---
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../components/JobCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getJobs, PROVINCES } from '../../lib/pocketbase';

const { slug } = Astro.params;
const province = PROVINCES.find(p => p.toLowerCase().replace(/\s+/g, '-') === slug);
if (!province) return Astro.redirect('/');

const page = parseInt(Astro.url.searchParams.get('page') || '1');
const { items: jobs, totalItems, totalPages } = await getJobs({ page, perPage: 20, province });
---

<Layout
  title={`Jobs in ${province} | Edubuzz`}
  description={`Find ${totalItems} jobs in ${province}, South Africa. Browse full-time, part-time and government roles in ${province}.`}
  canonicalUrl={page > 1 ? Astro.url.href : Astro.url.origin + Astro.url.pathname}
  prevPage={page > 1 ? `${Astro.url.origin}/province/${slug}?page=${Math.max(1, page - 1)}` : undefined}
  nextPage={page < totalPages ? `${Astro.url.origin}/province/${slug}?page=${page + 1}` : undefined}
>
  <div class="bg-white border-b border-gray-200 py-10 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="mb-4">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Provinces', href: '/provinces' },
          { label: `Jobs in ${province}` },
        ]} />
      </div>
      <h1 class="text-2xl font-semibold text-navy">Jobs in {province}</h1>
      <p class="text-gray-500 text-sm">{totalItems.toLocaleString()} jobs available in {province}</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <div>
      <div class="space-y-3">
        {jobs.map(job => <JobCard job={job} />)}
      </div>
      {jobs.length === 0 && (
        <div class="card text-center py-12">
          <p class="text-gray-500">No jobs in {province} right now. Check back soon!</p>
        </div>
      )}
      {totalPages > 1 && (
        <div class="flex gap-1.5 mt-6 flex-wrap">
          {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
            const p = i + 1;
            return (
              <a href={`/province/${slug}?page=${p}`}
                class={`w-9 h-9 flex items-center justify-center rounded-md text-sm border transition-colors ${p === page ? 'border-green-800 text-green-800 bg-green-800-light font-bold' : 'border-gray-200 text-gray-500 hover:border-green-800 bg-white'}`}>
                {p}
              </a>
            );
          })}
        </div>
      )}
    </div>
    <aside class="hidden lg:block"><Sidebar /></aside>
  </div>
</Layout>
