---
import Layout from '../layouts/Layout.astro';
import { generateToken } from '../lib/csrf';
const csrfToken = generateToken();
const serverError = Astro.url.searchParams.get('error') || '';
---

<Layout title="Login" description="Log in to your Edubuzz account." canonicalUrl="/login">
  <div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white border border-gray-200 rounded-md p-8">
      <h1 class="text-2xl font-bold text-gray-900 mb-6">Login</h1>
      <div id="error-msg" class="bg-red-50 border border-red-200 rounded-md p-3 text-sm text-red-800 mb-4" hidden={!serverError}>{serverError}</div>
      <form id="login-form" action="/api/auth/login" method="post" class="space-y-4">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Email</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="email" name="email" required autocomplete="email" /></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Password</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="password" name="password" required autocomplete="current-password" /></div>
        <button type="submit" id="submit-btn" class="w-full bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Login</button>
        <p class="text-sm text-gray-600 text-center">No account yet? <a href="/register" class="text-green-800 hover:text-green-900 hover:underline font-medium">Register</a></p>
      </form>
    </div>
  </div>
</Layout>

<script>
document.getElementById('login-form').addEventListener('submit', async e => {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const btn = form.querySelector('button') as HTMLButtonElement;
  const err = document.getElementById('error-msg') as HTMLDivElement;
  btn.disabled = true; btn.textContent = 'Logging in...'; err.hidden = true;
  try {
    const res = await fetch('/api/auth/login', { method: 'POST', headers: { Accept: 'application/json' }, credentials: 'same-origin', body: new FormData(form) });
    const d = await res.json().catch(() => ({}));
    if (d.success) {
      const next = new URLSearchParams(location.search).get('next');
      const adminRoles = ['admin', 'superadmin', 'moderator'];
      location.href = next || (adminRoles.includes(d.role) ? '/admin' : d.role === 'employer' ? '/employer/dashboard' : '/');
    } else { err.textContent = d.error || 'Login failed.'; err.hidden = false; btn.disabled = false; btn.textContent = 'Login'; }
  } catch { err.textContent = 'Network error. Try again.'; err.hidden = false; btn.disabled = false; btn.textContent = 'Login'; }
});
</script>
