---
import Layout from '../layouts/Layout.astro';
import { generateToken } from '../lib/csrf';
const csrfToken = generateToken();
const serverError = Astro.url.searchParams.get('error') || '';
---

<Layout title="Login" description="Log in to your Edubuzz account." canonicalUrl="/login">
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>Login</h1>
      <div id="error-msg" class="error-msg" aria-live="polite" hidden={!serverError}>{serverError}</div>
      <form id="login-form" action="/api/auth/login" method="post">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <label>Email<input type="email" name="email" required autocomplete="email" /></label>
        <label>Password<input type="password" name="password" required autocomplete="current-password" /></label>
        <button type="submit" id="submit-btn">Login</button>
        <p>No account yet? <a href="/register">Register</a></p>
      </form>
    </div>
  </div>
</Layout>

<script>
document.getElementById('login-form').addEventListener('submit', async e => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  const err = document.getElementById('error-msg');
  btn.disabled = true; btn.textContent = 'Logging in\u2026'; err.hidden = true;
  try {
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { Accept: 'application/json' },
      credentials: 'same-origin',
      body: new FormData(e.target),
    });
    const d = await res.json().catch(() => ({}));
    if (d.success) {
      const next = new URLSearchParams(location.search).get('next');
      const adminRoles = ['admin', 'superadmin', 'moderator'];
      const dest = next || (adminRoles.includes(d.role) ? '/admin' : d.role === 'employer' ? '/employer/dashboard' : '/');
      location.href = dest;
    } else {
      err.textContent = d.error || 'Login failed.'; err.hidden = false;
      btn.disabled = false; btn.textContent = 'Login';
    }
  } catch {
    err.textContent = 'Network error. Try again.'; err.hidden = false;
    btn.disabled = false; btn.textContent = 'Login';
  }
});
</script>

<style>
  .auth-wrap { max-width: 480px; margin: 3rem auto; padding: 0 1rem; }
  .auth-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 6px; padding: 2rem; }
  h1 { font-size: 20px; font-weight: 600; margin: 0 0 1.5rem; letter-spacing: -0.3px; }
  .error-msg { background: #fcebeb; border: 1px solid #f09595; border-radius: 4px; padding: 10px 14px; font-size: 13px; color: #a32d2d; margin-bottom: 1rem; }
  label { display: block; color: #444; font-size: 13px; margin-bottom: 4px; }
  input { width: 100%; border: 1px solid #ddd; border-radius: 4px; padding: 8px 10px; font-size: 14px; margin: 4px 0 14px; }
  input:focus { border-color: #2d6a4f; outline: none; }
  button { width: 100%; background: #2d6a4f; color: #fff; border: 0; border-radius: 4px; padding: 10px; font-size: 14px; font-weight: 500; cursor: pointer; }
  p { font-size: 13px; color: #666; text-align: center; margin-top: 1rem; }
  a { color: #2d6a4f; }
</style>
