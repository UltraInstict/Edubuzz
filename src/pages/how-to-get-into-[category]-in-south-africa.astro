---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getJobs, getCategoryBySlug, getCategoriesWithCounts } from '../lib/pocketbase';
import { titleFromSlug, slugify } from '../lib/slugify';

const { category: categorySlug } = Astro.params;
const category = await getCategoryBySlug(categorySlug || '');
if (!category) return Astro.redirect('/404');

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
const perPage = 10;
const { items: jobs, totalItems } = await getJobs({ page, perPage, category: category.name });
const categoriesWithJobs = (await getCategoriesWithCounts()).filter(c => c.count > 0).slice(0, 8);

const faq = [
  { q: `What qualifications do I need to get into ${category.name.toLowerCase()} in South Africa?`, a: `Entry requirements vary, but most ${category.name.toLowerCase()} roles require a relevant degree or diploma from a recognized South African institution. Some positions accept equivalent experience and industry certifications.` },
  { q: `How long does it take to build a career in ${category.name.toLowerCase()}?`, a: `Entry-level positions typically require 0-2 years of experience. Mid-level roles need 3-5 years, and senior positions require 5+ years of proven experience in the ${category.name.toLowerCase()} field.` },
  { q: `What is the average salary for ${category.name.toLowerCase()} jobs in South Africa?`, a: `Salaries in the ${category.name.toLowerCase()} sector vary based on experience, location, and qualifications. Entry-level positions typically start with competitive packages, growing significantly with experience and specialization.` },
  { q: `Which South African companies hire for ${category.name.toLowerCase()} positions?`, a: `Major employers include government departments, private sector companies, NGOs, and consulting firms across all provinces. Check our job listings for current opportunities.` },
];
---

<Layout
  title={`How to Get Into ${category.name} in South Africa | Career Guide`}
  description={`Complete career guide for breaking into the ${category.name.toLowerCase()} industry in South Africa. Qualifications, skills, salary ranges, and top employers. Updated for 2026.`}
  canonicalUrl={Astro.url.href}
>
  <div class="bg-white border-b border-border py-10 px-6">
    <div class="max-w-6xl mx-auto">
      <nav class="text-xs text-muted mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-navy">Home</a> &rsaquo; <a href="/resources" class="hover:text-navy">Resources</a> &rsaquo; <span class="text-navy font-medium">Careers in {category.name}</span>
      </nav>
      <h1 class="text-2xl font-semibold text-navy">How to Get Into {category.name} in South Africa</h1>
      <p class="text-muted text-sm mt-2">Your complete guide to starting and advancing a career in {category.name.toLowerCase()} in South Africa</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <div>
      <article class="prose max-w-none mb-8">
        <p class="text-muted">The {category.name.toLowerCase()} sector in South Africa offers diverse career opportunities across both public and private sectors. Whether you're a school leaver, graduate, or career changer, this guide will help you navigate your path into the {category.name.toLowerCase()} industry.</p>

        <h2 class="text-lg font-semibold text-navy mt-6">Educational Requirements</h2>
        <p class="text-muted">Most {category.name.toLowerCase()} positions require a minimum of a Grade 12/Matric certificate. For professional roles, a relevant degree or diploma from a South African university or TVET college is typically required. Key qualifications include:</p>
        <ul class="list-disc pl-5 text-muted space-y-1 mt-2">
          <li>National Senior Certificate (Grade 12) with relevant subject passes</li>
          <li>Degree or diploma in {category.name.toLowerCase()}-related field</li>
          <li>Industry-specific certifications</li>
          <li>Professional registration where applicable (e.g., HPCSA, SANC, ECSA, SAQA)</li>
        </ul>

        <h2 class="text-lg font-semibold text-navy mt-6">Key Skills for Success</h2>
        <ul class="list-disc pl-5 text-muted space-y-1">
          <li>Strong communication in English and at least one African language</li>
          <li>Relevant technical skills for the {category.name.toLowerCase()} field</li>
          <li>Problem-solving and critical thinking abilities</li>
          <li>Computer literacy and familiarity with industry software</li>
          <li>Professional ethics and attention to detail</li>
        </ul>

        <h2 class="text-lg font-semibold text-navy mt-6">Career Progression Path</h2>
        <ol class="list-decimal pl-5 text-muted space-y-1 mt-2">
          <li><strong>Entry Level (0-2 years):</strong> Junior roles, internships, learnerships, or graduate programmes</li>
          <li><strong>Mid Level (3-5 years):</strong> Specialist roles with increased responsibility</li>
          <li><strong>Senior Level (5+ years):</strong> Management, senior specialist, or consulting positions</li>
          <li><strong>Executive Level (10+ years):</strong> Director, head of department, or C-suite roles</li>
        </ol>
      </article>

      <section class="mb-8">
        <h2 class="text-lg font-semibold text-navy mb-4">Explore Other Career Paths</h2>
        <div class="flex flex-wrap gap-2">
          {categoriesWithJobs.map(cat => (
            <a href={`/how-to-get-into-${cat.slug}-in-south-africa`} class="inline-flex items-center px-3 py-1.5 bg-[#e8f4f0] text-[#2d6a4f] text-xs font-medium rounded-full hover:bg-[#d0ebe0] transition-colors">
              {cat.name} Career Guide
            </a>
          ))}
        </div>
      </section>

      <section class="mb-8">
        <h2 class="text-lg font-semibold text-navy mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4" itemscope itemtype="https://schema.org/FAQPage">
          {faq.map(item => (
            <div class="card p-4" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <h3 class="font-medium text-navy text-sm mb-1" itemprop="name">{item.q}</h3>
              <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p class="text-muted text-xs" itemprop="text">{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      {totalItems > 0 && (
        <section>
          <h2 class="text-lg font-semibold text-navy mb-4">Latest {category.name} Jobs</h2>
          <div class="space-y-3">{jobs.map(job => <JobCard job={job} />)}</div>
        </section>
      )}
    </div>

    <aside><Sidebar /></aside>
  </div>
</Layout>
