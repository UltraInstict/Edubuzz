---
import Layout from '../../../layouts/Layout.astro';
import JobCard from '../../../components/JobCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { siteBase } from '../../../lib/constants';
import { getCategories, getJobs } from '../../../lib/pocketbase';
import { provinceName, slugify, titleFromSlug } from '../../../lib/slugify';
import { JOBS_PUBLIC } from '../../../lib/featureFlags';
import { getListingRedirectTarget } from '../../../lib/jobRedirects';

if (!JOBS_PUBLIC) {
  return Astro.redirect(getListingRedirectTarget(Astro.params.category || ''), 301);
}

const categorySlug = Astro.params.category || '';
const locationSlug = Astro.params.province || '';
const categories = await getCategories();
const category = categories.find((cat) => cat.slug === categorySlug || slugify(cat.name) === categorySlug);
const categoryName = category?.name || titleFromSlug(categorySlug);
const locationName = provinceName(locationSlug);
const provinceJobs = await getJobs({ perPage: 20, category: categoryName, province: locationName });
let jobs = provinceJobs.items;
let title = `${categoryName} Jobs in ${locationName}`;
if (!jobs.length) {
  const all = await getJobs({ perPage: 50, category: categoryName });
  jobs = all.items.filter((job) => slugify(job.city || '') === locationSlug);
  title = `${categoryName} Jobs in ${titleFromSlug(locationSlug)}`;
}
const origin = siteBase();
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: origin }, { '@type': 'ListItem', position: 2, name: 'Jobs', item: `${origin}/jobs` }, { '@type': 'ListItem', position: 3, name: categoryName, item: `${origin}/jobs/${categorySlug}` }, { '@type': 'ListItem', position: 4, name: locationName, item: Astro.url.href }] };
---
<Layout title={title} description={`Browse ${jobs.length} ${categoryName} jobs in ${locationName}. Apply today on Edubuzz.`} canonicalUrl={Astro.url.href}>
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} /></Fragment>
<main class="max-w-6xl mx-auto px-6 py-6 grid grid-cols-[1fr_240px] gap-4 max-md:grid-cols-1">
  <section>
    <nav class="text-xs text-gray-600 mb-2">
      <a href="/" class="text-green-800">Home</a> &gt; <a href="/jobs" class="text-green-800">Jobs</a> &gt; <a href={`/jobs/${categorySlug}`} class="text-green-800">{categoryName}</a> &gt; {locationName}
    </nav>
    <h1 class="text-2xl font-bold text-gray-900 mt-2 mb-3">{title} ({jobs.length} available)</h1>
    {jobs.length ? jobs.map((job: any) => <JobCard job={job}/>) : <div class="bg-white border border-gray-200 rounded-md p-5 text-sm text-gray-600">No matching jobs right now.</div>}
  </section>
  <aside><Sidebar /></aside>
</main>
</Layout>
