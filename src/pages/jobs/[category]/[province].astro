---
import Layout from '../../../layouts/Layout.astro';
import JobCard from '../../../components/JobCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getCategories, getJobs } from '../../../lib/pocketbase';
import { provinceName, slugify, titleFromSlug } from '../../../lib/slugify';

const categorySlug = Astro.params.category || '';
const locationSlug = Astro.params.province || '';
const categories = await getCategories();
const category = categories.find((cat) => cat.slug === categorySlug || slugify(cat.name) === categorySlug);
const categoryName = category?.name || titleFromSlug(categorySlug);
const locationName = provinceName(locationSlug);
const provinceJobs = await getJobs({ perPage: 20, category: categoryName, province: locationName });
let jobs = provinceJobs.items;
let title = `${categoryName} Jobs in ${locationName}`;
if (!jobs.length) {
  const all = await getJobs({ perPage: 50, category: categoryName });
  jobs = all.items.filter((job) => slugify(job.city || '') === locationSlug);
  title = `${categoryName} Jobs in ${titleFromSlug(locationSlug)}`;
}
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://edubuzz.co.za' }, { '@type': 'ListItem', position: 2, name: 'Jobs', item: 'https://edubuzz.co.za/jobs' }, { '@type': 'ListItem', position: 3, name: categoryName, item: `https://edubuzz.co.za/jobs/${categorySlug}` }, { '@type': 'ListItem', position: 4, name: locationName, item: Astro.url.href }] };
---
<Layout title={title} description={`Browse ${jobs.length} ${categoryName} jobs in ${locationName}. Apply today on Edubuzz.`} canonicalUrl={Astro.url.href}>
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} /></Fragment>
<main class="seo-grid"><section><nav class="crumb"><a href="/">Home</a> &gt; <a href="/jobs">Jobs</a> &gt; <a href={`/jobs/${categorySlug}`}>{categoryName}</a> &gt; {locationName}</nav><h1>{title} ({jobs.length} available)</h1>{jobs.length ? jobs.map(job=><JobCard job={job}/>) : <div class="panel">No matching jobs right now.</div>}</section><aside><Sidebar /></aside></main>
</Layout>
<style>.seo-grid{max-width:1100px;margin:1.5rem auto;padding:0 1.5rem;display:grid;grid-template-columns:1fr 240px;gap:16px}.crumb,.crumb a{font-size:12px;color:#6b7280}.crumb a{color:#166534}h1{font-size:22px;margin:8px 0 12px;font-weight:600;letter-spacing:-0.3px}@media(max-width:820px){.seo-grid{grid-template-columns:1fr}}</style>
