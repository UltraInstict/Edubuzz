---
import Layout from '../../../layouts/Layout.astro';
import JobCard from '../../../components/JobCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getJobs } from '../../../lib/pocketbase';
const ranges: Record<string, [number, number | undefined, string]> = { 'r0-r10000':[0,10000,'R0 - R10,000'], 'r10000-r20000':[10000,20000,'R10,000 - R20,000'], 'r20000-r30000':[20000,30000,'R20,000 - R30,000'], 'r30000-r50000':[30000,50000,'R30,000 - R50,000'], 'r50000-plus':[50000,undefined,'R50,000+'] };
const range = ranges[Astro.params.range || ''] || ranges['r0-r10000'];
const { items: jobs } = await getJobs({ perPage: 20, salary_min: range[0], salary_max: range[1] });
---
<Layout title={`Jobs Paying ${range[2]}/month in South Africa`} description={`Browse South African jobs paying ${range[2]} per month.`} canonicalUrl={Astro.url.href}>
<main class="seo-grid"><section><h1>Jobs Paying {range[2]}/month in South Africa</h1>{jobs.map(job=><JobCard job={job}/>)}</section><aside><Sidebar /></aside></main>
</Layout>
<style>.seo-grid{max-width:1100px;margin:1.5rem auto;padding:0 1.5rem;display:grid;grid-template-columns:1fr 240px;gap:16px}h1{font-size:22px;margin:0 0 12px;font-weight:600;letter-spacing:-0.3px}@media(max-width:820px){.seo-grid{grid-template-columns:1fr}}</style>
