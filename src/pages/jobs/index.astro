---
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../components/JobCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getJobs, PROVINCES } from '../../lib/pocketbase';
import { provinceName } from '../../lib/slugify';

const params = Astro.url.searchParams;
const page = Math.max(1, Number(params.get('page') || '1'));
const search = params.get('q') || params.get('search') || '';
const provinceParam = params.get('province') || '';
const province = provinceParam ? provinceName(provinceParam) : '';
const type = params.get('type') || '';
const { items: jobs, totalItems, totalPages } = await getJobs({ page, perPage: 20, search, province, job_type: type });

const pills = [
  { label: 'All', value: '' },
  { label: 'Full-time', value: 'Full-time' },
  { label: 'Part-time', value: 'Part-time' },
  { label: 'Contract', value: 'Contract' },
  { label: 'Remote', value: 'Remote' },
  { label: 'Internship', value: 'Internship' },
  { label: 'Government', value: 'Government' },
  { label: 'Education', value: 'Education' },
];

function withParams(next: Record<string, string>) {
  const out = new URLSearchParams();
  if (search) out.set('q', search);
  if (province) out.set('province', province);
  if (type) out.set('type', type);
  Object.entries(next).forEach(([key, value]) => value ? out.set(key, value) : out.delete(key));
  const query = out.toString();
  return query ? `/jobs?${query}` : '/jobs';
}

function pageUrl(nextPage: number) {
  return withParams({ page: String(nextPage) });
}
---

<Layout title="Browse Jobs in South Africa" description="Browse all active jobs across South Africa." canonicalUrl={Astro.url.href}>
  <section class="hero">
    <div class="container">
      <h1>Browse jobs</h1>
      <p>Search all active job listings across South Africa.</p>
      <form class="search-bar" action="/jobs" method="get">
        <input type="search" name="q" value={search} placeholder="Job title, keyword, or company" />
        <span class="divider" aria-hidden="true"></span>
        <select name="province">
          <option value="">All provinces</option>
          {PROVINCES.map((p) => <option value={p} selected={p === province}>{p}</option>)}
        </select>
        <button type="submit">Search</button>
      </form>
      <div class="filter-pills">
        {pills.map((pill) => (
          <a class={pill.value === type ? 'active' : ''} href={withParams({ type: pill.value, page: '' })}>{pill.label}</a>
        ))}
      </div>
    </div>
  </section>

  <div class="page-grid">
    <main>
      <AdSlot size="leaderboard" />
      <div class="section-head">
        <h2>All jobs</h2>
        <a href="/">Latest jobs -></a>
      </div>
      <p class="count">Showing {jobs.length} of {totalItems.toLocaleString('en-ZA')} jobs</p>
      {jobs.length ? jobs.map((job) => <JobCard job={job} />) : <div class="panel">No jobs found for "{search}"{province ? ` in ${province}` : ''}.</div>}
      {totalPages > 1 && (
        <nav class="pagination">
          {page > 1 && <a href={pageUrl(page - 1)}>Previous</a>}
          {Array.from({ length: Math.min(totalPages, 7) }, (_, index) => <a href={pageUrl(index + 1)} class={index + 1 === page ? 'active' : ''}>{index + 1}</a>)}
          {page < totalPages && <a href={pageUrl(page + 1)}>Next</a>}
        </nav>
      )}
    </main>
    <aside><Sidebar /></aside>
  </div>
</Layout>

<style>
  .hero { background: #fff; border-bottom: 1px solid #e0e0e0; padding: 2rem 0; }
  .hero h1 { margin: 0; color: #1a1a1a; font-size: 22px; font-weight: 600; letter-spacing: -0.3px; line-height: 1.3; }
  .hero p { margin: 6px 0 16px; color: #666; font-size: 13px; }
  .search-bar { display: flex; width: 100%; max-width: 820px; border: 2px solid #2d6a4f; border-radius: 6px; overflow: hidden; background: #fff; }
  .search-bar input { flex: 1; min-width: 0; border: 0; outline: 0; padding: 12px 14px; font-size: 14px; }
  .divider { width: 1px; background: #e0e0e0; margin: 8px 0; flex-shrink: 0; }
  .search-bar select { width: 140px; flex-shrink: 0; background: #f9f9f9; border: 0; color: #444; font-size: 13px; outline: 0; padding: 0 10px; }
  .search-bar button { flex-shrink: 0; background: #2d6a4f; color: #fff; font-weight: 600; padding: 0 20px; border: 0; white-space: nowrap; }
  .filter-pills { display: flex; gap: 6px; margin-top: 12px; max-width: 100%; overflow-x: auto; padding-bottom: 2px; }
  .filter-pills a { flex: 0 0 auto; background: #f3f2ee; border: 1px solid #ddd; border-radius: 20px; padding: 4px 11px; font-size: 12px; color: #444; }
  .filter-pills a.active { background: #e8f4f0; border-color: #2d6a4f; color: #2d6a4f; }
  .page-grid { display: grid; grid-template-columns: 1fr 240px; gap: 16px; padding: 0 1.5rem; margin: 1.5rem auto; max-width: 1100px; }
  .count { margin: -2px 0 10px; color: #666; font-size: 13px; }
  .pagination { display: flex; gap: 6px; margin-top: 14px; flex-wrap: wrap; }
  .pagination a { border: 1px solid #e0e0e0; background: #fff; border-radius: 4px; padding: 5px 10px; font-size: 12px; }
  .pagination .active { background: #2d6a4f; color: #fff; border-color: #2d6a4f; }
  @media (max-width: 820px) { .page-grid { grid-template-columns: 1fr; padding: 0 1rem; } }
  @media (max-width: 560px) { .search-bar { flex-wrap: wrap; } .search-bar input { flex: 0 0 100%; border-bottom: 1px solid #e0e0e0; } .divider { display: none; } .search-bar select { flex: 1; width: auto; min-width: 0; height: 42px; } .search-bar button { height: 42px; } }
</style>
