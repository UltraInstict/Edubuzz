---
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../components/JobCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import MonetizationSlot from '../../components/MonetizationSlot.astro';
import { getJobs, PROVINCES } from '../../lib/pocketbase';

const params = Astro.url.searchParams;
const page = Math.max(1, Number(params.get('page') || '1'));
const search = params.get('search') || params.get('q') || '';
const province = params.get('province') || '';
const job_type = params.get('job_type') || params.get('type') || '';
const result = await getJobs({ page, perPage: 20, search, province, job_type });
const jobs = result.items;
const totalItems = result.totalItems;
const totalPages = result.totalPages;

function withParams(next: Record<string, string>) {
  const out = new URLSearchParams();
  if (search) out.set('search', search);
  if (province) out.set('province', province);
  if (job_type) out.set('job_type', job_type);
  for (const [k, v] of Object.entries(next)) {
    if (v) out.set(k, v); else out.delete(k);
  }
  const q = out.toString();
  return q ? `/jobs?${q}` : '/jobs';
}
function pageUrl(n: number) { return withParams({ page: String(n) }); }
---

<Layout title="Browse Jobs in South Africa" description="Browse all active jobs across South Africa." canonicalUrl={Astro.url.href}>
  <div class="bg-white border-b border-gray-200 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Browse jobs</h1>
      <p class="text-sm text-gray-600 mb-6">Search all active job listings across South Africa.</p>
      <form class="flex border-2 border-green-800 rounded-md overflow-hidden bg-white" action="/jobs" method="get" style="max-width:640px">
        <input type="search" name="search" value={search} placeholder="Job title, keyword, or company" class="flex-1 border-none px-4 py-2.5 text-sm text-gray-900 outline-none" />
        <select name="province" class="w-36 border-l border-gray-200 bg-gray-50 text-sm text-gray-600 outline-none px-2">
          <option value="">All provinces</option>
          {PROVINCES.map(p => <option value={p} selected={p === province}>{p}</option>)}
        </select>
        <button type="submit" class="bg-green-800 text-white text-sm font-medium px-5 hover:bg-green-900 transition-colors">Search</button>
      </form>
      <div class="flex gap-2 mt-3 flex-wrap">
        {[{label:'All',value:''},{label:'Full-time',value:'Full-time'},{label:'Part-time',value:'Part-time'},{label:'Contract',value:'Contract'},{label:'Remote',value:'Remote'},{label:'Internship',value:'Internship'},{label:'Learnership',value:'Learnership'},{label:'Graduate',value:'Graduate Programme'}].map(p => {
          const active = p.value === job_type;
          return <a href={withParams({job_type:p.value,page:''})} class={active ? 'bg-green-800 text-white text-sm px-4 py-1.5 rounded-md' : 'border border-gray-200 text-gray-900 text-sm px-4 py-1.5 rounded-md hover:border-green-800 hover:text-green-800'}>{p.label}</a>
        })}
      </div>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8">
      <div>
        <MonetizationSlot zone="jobs-top" />
        <div class="flex justify-between items-center mb-3">
          <h2 class="text-xl font-semibold text-gray-900">All jobs</h2>
          <a href="/" class="text-sm text-green-800 hover:underline font-medium">Latest jobs</a>
        </div>
        <p class="text-xs text-gray-500 mb-3">Showing {jobs.length} of {totalItems.toLocaleString('en-ZA')} jobs</p>
        {jobs.length > 0 ? jobs.map(j => <JobCard job={j} />) : <div class="bg-white border border-gray-200 rounded-md p-8 text-center"><p class="text-sm text-gray-600">No jobs found. Try adjusting your search.</p></div>}
        {totalPages > 1 && <div class="flex gap-1 mt-4 flex-wrap">
          {page > 1 && <a href={pageUrl(page-1)} class="border border-gray-200 rounded-md px-3 py-1.5 text-sm text-green-800 hover:border-green-800 hover:text-green-900">Previous</a>}
          {Array.from({length: Math.min(totalPages, 7)}, (_, i) => i + 1).map(p => <a href={pageUrl(p)} class={p === page ? 'bg-green-800 text-white rounded-md px-3 py-1.5 text-sm' : 'border border-gray-200 rounded-md px-3 py-1.5 text-sm text-green-800 hover:border-green-800 hover:text-green-900'}>{p}</a>)}
          {page < totalPages && <a href={pageUrl(page+1)} class="border border-gray-200 rounded-md px-3 py-1.5 text-sm text-green-800 hover:border-green-800 hover:text-green-900">Next</a>}
        </div>}
      </div>
      <aside><Sidebar /></aside>
    </div>
  </div>
</Layout>
