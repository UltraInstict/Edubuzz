---
import Layout from '../../../layouts/Layout.astro';
import JobCard from '../../../components/JobCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getJobs, JOB_TYPES } from '../../../lib/pocketbase';
import { slugify, titleFromSlug } from '../../../lib/slugify';
const type = JOB_TYPES.find((t)=>slugify(t)===Astro.params.type) || titleFromSlug(Astro.params.type || '');
const { items: jobs, totalItems } = await getJobs({ perPage: 20, job_type: type });
---
<Layout title={`${type} Jobs in South Africa`} description={`Browse ${totalItems} ${type} jobs across South Africa.`} canonicalUrl={Astro.url.href}>
<main class="seo-grid"><section><h1>{type} Jobs ({totalItems} available)</h1>{jobs.map(job=><JobCard job={job}/>)}</section><aside><Sidebar /></aside></main>
</Layout>
<style>.seo-grid{max-width:1100px;margin:1.5rem auto;padding:0 1.5rem;display:grid;grid-template-columns:1fr 240px;gap:16px}h1{font-size:22px;margin:0 0 12px;font-weight:600;letter-spacing:-0.3px}@media(max-width:820px){.seo-grid{grid-template-columns:1fr}}</style>
