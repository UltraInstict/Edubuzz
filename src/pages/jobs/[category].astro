---
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../components/JobCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCategories, getJobs, PROVINCES } from '../../lib/pocketbase';
import { slugify, titleFromSlug } from '../../lib/slugify';

const slug = Astro.params.category || '';
const categories = await getCategories();
const category = categories.find((cat) => cat.slug === slug || slugify(cat.name) === slug);
const cityMode = !category;
const label = category?.name || titleFromSlug(slug);
const jobs = cityMode ? await getJobs({ perPage: 20 }) : await getJobs({ perPage: 20, category: label });
const filtered = cityMode ? jobs.items.filter((job) => slugify(job.city || '') === slug) : jobs.items;
const count = cityMode ? filtered.length : jobs.totalItems;
---
<Layout title={cityMode ? `Jobs in ${label}` : `${label} Jobs in South Africa`} description={cityMode ? `Find ${count} jobs in ${label}.` : `Find ${count} ${label} jobs across South Africa. Updated daily.`} canonicalUrl={Astro.url.href}>
<main class="max-w-6xl mx-auto px-6 py-6 grid grid-cols-[1fr_240px] gap-4 max-md:grid-cols-1">
  <section>
    <nav class="text-xs text-gray-600 mb-2">
      <a href="/" class="text-green-800">Home</a> &gt; <a href="/jobs" class="text-green-800">Jobs</a> &gt; {label}
    </nav>
    <h1 class="text-2xl font-bold text-gray-900 mt-2 mb-3">{cityMode ? `Jobs in ${label} (${count} open positions)` : `${label} Jobs (${count} available)`}</h1>
    {!cityMode && (
      <div class="flex gap-1.5 flex-wrap mb-3.5">
        {PROVINCES.map((p: string) => <a href={`/jobs/${slug}/${slugify(p)}`} class="bg-white border border-gray-200 rounded text-xs text-green-800 px-2 py-1">{p}</a>)}
      </div>
    )}
    {filtered.map((job: any) => <JobCard job={job}/>)}
  </section>
  <aside><Sidebar /></aside>
</main>
</Layout>
