---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import JobCard from '../../components/JobCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { formatSalary, getJobBySlug, getRelatedJobs, isSalaryDisclosed } from '../../lib/pocketbase';
import { timeAgo } from '../../lib/timeAgo';
import { trackEvent } from '../../lib/analytics';

const { slug } = Astro.params;
const job = await getJobBySlug(slug || '');

if (!job) return Astro.redirect('/404');

const isExpired = Boolean(job.expires && new Date(job.expires).getTime() <= Date.now());
const similarJobs = await getRelatedJobs(job.category, job.id, 4);
const descriptionText = (job.description || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
trackEvent(job.id, 'view', Astro.request).catch(() => {});
const pageUrl = Astro.url.href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description: descriptionText,
  datePosted: job.created,
  validThrough: job.expires,
  employmentType: job.job_type,
  hiringOrganization: {
    '@type': 'Organization',
    name: job.company,
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: job.city,
      addressRegion: job.province,
      addressCountry: 'ZA',
    },
  },
  ...(isSalaryDisclosed(job.salary_min, job.salary_max) ? {
    baseSalary: {
      '@type': 'MonetaryAmount',
      currency: 'ZAR',
      value: {
        '@type': 'QuantitativeValue',
        minValue: job.salary_min,
        maxValue: job.salary_max,
        unitText: 'MONTH',
      },
    },
  } : {}),
};
---

<Layout
  title={`${job.title} at ${job.company} - ${job.city || job.province}`}
  description={`Apply for ${job.title} at ${job.company} in ${job.city || job.province}. ${job.job_type}.`}
  canonicalUrl={Astro.url.href}
  ogTitle={`${job.title} at ${job.company}`}
  ogDescription={`Apply for ${job.title} in ${job.city || job.province} on Edubuzz.`}
  ogImage={`${Astro.url.origin}/api/og-image/${job.id}`}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="detail-grid">
    <main class="job-main">
      {isExpired && <div class="closed-banner">This job has closed</div>}

      <section class="job-header panel">
        <h1>{job.title}</h1>
        <p class="company-line">{job.company} · {job.city || job.province} · {job.province}</p>
        <p class="meta-line">{job.category} · {job.job_type} · Posted {timeAgo(job.created)}</p>
      </section>

      <div class="apply-top">
        {isExpired ? (
          <button disabled>This job has closed</button>
        ) : job.apply_url ? (
          <a href={job.apply_url} target="_blank" rel="noopener">Apply on company website -></a>
        ) : (
          <a href="#apply-form">Apply Now</a>
        )}
      </div>

      <div class="share-row">
        <span>Share this job:</span>
        <a href={`https://wa.me/?text=${encodeURIComponent(`${job.title} at ${job.company} - ${pageUrl}`)}`} target="_blank" rel="noopener" data-share={job.id}>WhatsApp</a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" data-share={job.id}>LinkedIn</a>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${job.title} at ${job.company}`)}&url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" data-share={job.id}>X</a>
        <button type="button" data-copy={pageUrl} data-share={job.id}>Copy link</button>
      </div>

      <section class="panel description">
        <h2>Job description</h2>
        <div set:html={job.description} />
      </section>

      {!isExpired && job.apply_email && (
        <section id="apply-form" class="panel apply-form">
          <h2>Apply for this job</h2>
          <form enctype="multipart/form-data">
            <input type="hidden" name="job" value={job.id} />
            <label>Name <input class="form-field" type="text" name="name" required /></label>
            <label>Email <input class="form-field" type="email" name="email" required /></label>
            <label>Phone <input class="form-field" type="tel" name="phone" /></label>
            <label>Cover letter <textarea class="form-field" name="cover_letter" rows="5"></textarea></label>
            <label>CV (PDF, max 5MB) <input class="form-field" type="file" name="cv_file" accept="application/pdf" /></label>
            <p id="apply-message" hidden></p>
            <button type="submit">Submit Application</button>
          </form>
        </section>
      )}

      {!isExpired && !job.apply_email && job.apply_url && (
        <section class="panel external-apply">
          <a href={job.apply_url} target="_blank" rel="noopener">Apply on company website -></a>
        </section>
      )}

      <AdSlot size="leaderboard" />
    </main>

    <aside>
      <Sidebar />
      {similarJobs.length > 0 && (
        <section class="similar-card">
          <h2>Similar jobs</h2>
          {similarJobs.map((similar) => <JobCard job={similar} compact />)}
        </section>
      )}
    </aside>
  </div>
</Layout>

<script>
  document.querySelector('.apply-form form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const message = document.getElementById('apply-message') as HTMLParagraphElement;
    const response = await fetch('/api/apply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: new FormData(form),
    });
    const body = await response.json().catch(() => ({}));
    message.textContent = response.ok ? 'Application submitted.' : (body.message || 'Could not submit application.');
    message.hidden = false;
    if (response.ok) form.reset();
  });

  document.querySelectorAll('[data-share]').forEach((element) => {
    element.addEventListener('click', () => {
      fetch('/api/track', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ jobId: (element as HTMLElement).dataset.share, event: 'share' }),
        keepalive: true,
      }).catch(() => {});
    });
  });

  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const el = button as HTMLButtonElement;
      await navigator.clipboard.writeText(el.dataset.copy || '');
      el.textContent = 'Copied!';
    });
  });
</script>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 16px;
    max-width: 1100px;
    margin: 1.5rem auto;
    padding: 0 1.5rem;
  }

  .job-main {
    display: grid;
    gap: 16px;
  }

  .job-header h1 {
    margin: 0 0 4px;
    color: #1a1a1a;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
  }

  .company-line,
  .meta-line {
    margin: 0;
    color: #666666;
    font-size: 13px;
  }

  .meta-line {
    margin-top: 4px;
    color: #444444;
  }

  .closed-banner {
    background: #fff8e1;
    border: 1px solid #f0c040;
    border-radius: 6px;
    color: #7a5e00;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
  }

  .apply-top {
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
    padding: 12px 0;
  }

  .share-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    color: #666666;
    font-size: 12px;
  }

  .share-row a,
  .share-row button {
    border: 0;
    border-left: 1px solid #e0e0e0;
    background: transparent;
    color: #2d6a4f;
    font-size: 12px;
    padding: 0 0 0 8px;
  }

  .apply-top a,
  .apply-top button,
  .apply-form button,
  .external-apply a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    border: 1px solid #2d6a4f;
    border-radius: 4px;
    background: #2d6a4f;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
  }

  .apply-top a:hover,
  .apply-form button:hover,
  .external-apply a:hover {
    background: #245a42;
    border-color: #245a42;
  }

  .apply-top button:disabled {
    background: #888888;
    border-color: #888888;
  }

  .description h2,
  .apply-form h2,
  .similar-card h2 {
    margin: 0 0 10px;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 600;
  }

  .description :global(p),
  .description :global(li) {
    color: #444444;
    font-size: 14px;
    line-height: 1.6;
  }

  .description :global(ul) {
    padding-left: 1.2rem;
  }

  .apply-form form {
    display: grid;
    gap: 10px;
  }

  .apply-form label {
    display: grid;
    gap: 4px;
    color: #444444;
    font-size: 12px;
    font-weight: 500;
  }

  #apply-message {
    margin: 0;
    color: #2d6a4f;
    font-size: 13px;
  }

  .similar-card {
    margin-top: 16px;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 1rem 1.25rem;
  }

  @media (max-width: 820px) {
    .detail-grid {
      grid-template-columns: 1fr;
      padding: 0 1rem;
    }
  }
</style>
