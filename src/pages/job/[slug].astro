---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import JobCard from '../../components/JobCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SmartAdSlot from '../../components/SmartAdSlot.astro';
import { formatSalary, getJobBySlug, getRelatedJobs, isSalaryDisclosed, sanitizeHtml, PROVINCES } from '../../lib/pocketbase';
import { timeAgo } from '../../lib/timeAgo';
import { trackEvent } from '../../lib/analytics';
import { generateToken } from '../../lib/csrf';

const { slug } = Astro.params;
const job = await getJobBySlug(slug || '');
const csrfToken = generateToken();

if (!job) return Astro.redirect('/404?reason=notfound');

// Expired job — return 410 Gone with the 404 page rendered as the body.
const isExpired = Boolean(
  (job.expires && new Date(job.expires).getTime() <= Date.now()) ||
  (job.active === false && job.expires && new Date(job.expires).getTime() <= Date.now())
);
if (isExpired) {
  return new Response(null, {
    status: 410,
    headers: { Location: '/404?reason=expired' },
  });
}
const similarJobs = await getRelatedJobs(job.category, job.id, 4);
const descriptionText = (job.description || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
trackEvent(job.id, 'view', Astro.request).catch(() => {});
const pageUrl = Astro.url.href;

const isRemote = /remote/i.test(job.job_type || '') || /remote/i.test(job.title || '');

const validThrough = job.expires || new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString();

// Map our human-readable job_type to Google Jobs employmentType enum
const EMPLOYMENT_TYPE_MAP: Record<string, string> = {
  'full-time': 'FULL_TIME',
  'part-time': 'PART_TIME',
  'contract': 'CONTRACTOR',
  'internship': 'INTERN',
  'learnership': 'INTERN',
  'graduate programme': 'INTERN',
  'temporary': 'TEMPORARY',
  'remote': 'OTHER',
  'bursary': 'OTHER',
};
const jobTypeKey = (job.job_type || '').toLowerCase().trim();
const employmentType = EMPLOYMENT_TYPE_MAP[jobTypeKey] || 'OTHER';

const jsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  description: descriptionText,
  identifier: {
    '@type': 'PropertyValue',
    name: 'Edubuzz Job ID',
    value: job.id,
  },
  datePosted: job.created,
  validThrough: validThrough,
  employmentType,
  directApply: Boolean(job.apply_email || job.apply_url),
  hiringOrganization: {
    '@type': 'Organization',
    name: job.company,
    sameAs: job.employer_website || job.apply_url || undefined,
    logo: job.company_logo || `${Astro.url.origin}/favicon.svg`,
  },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: job.city || '',
      addressRegion: job.province || '',
      addressCountry: 'ZA',
    },
  },
  applicantLocationRequirements: {
    '@type': 'Country',
    name: 'South Africa',
  },
  jobLocationType: isRemote ? 'TELECOMMUTE' : undefined,
  ...(isSalaryDisclosed(job.salary_min, job.salary_max) ? {
    baseSalary: {
      '@type': 'MonetaryAmount',
      currency: 'ZAR',
      value: {
        '@type': 'QuantitativeValue',
        minValue: job.salary_min || undefined,
        maxValue: job.salary_max || undefined,
        unitText: 'MONTH',
      },
    },
  } : {}),
  image: `${Astro.url.origin}/api/og-image/${job.id}`,
  url: pageUrl,
  sameAs: pageUrl,
  industry: job.category || undefined,
  occupationalCategory: job.category || undefined,
  jobBenefits: job.featured ? 'Featured listing' : undefined,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin },
    { '@type': 'ListItem', position: 2, name: 'Jobs', item: `${Astro.url.origin}/jobs` },
    ...(job.category ? [{ '@type': 'ListItem', position: 3, name: `${job.category} Jobs`, item: `${Astro.url.origin}/category/${job.category.toLowerCase().replace(/\s+/g,'-')}` }] : []),
    { '@type': 'ListItem', position: (job.category ? 4 : 3), name: `${job.title} at ${job.company}`, item: pageUrl },
  ],
};
---

<Layout
  title={`${job.title} at ${job.company} - ${job.city || job.province}`}
  description={`Apply for ${job.title} at ${job.company} in ${job.city || job.province}. ${job.job_type}.`}
  canonicalUrl={Astro.url.href}
  ogTitle={`${job.title} at ${job.company}`}
  ogDescription={`Apply for ${job.title} in ${job.city || job.province} on Edubuzz.`}
  ogImage={`${Astro.url.origin}/api/og-image/${job.id}`}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <div class="detail-grid">
    <main class="job-main">
      <SmartAdSlot zone="jobs-top" category={job.category} />
      <div class="breadcrumbs-wrap">
        <Breadcrumbs items={[
          { label: 'Home', href: '/' },
          { label: 'Jobs', href: '/jobs' },
          ...(job.category ? [{ label: `${job.category} Jobs`, href: `/category/${job.category.toLowerCase().replace(/\s+/g, '-')}` }] : []),
          { label: job.title },
        ]} />
      </div>

      <section class="job-header panel">
        <h1>{job.title}</h1>
        <p class="company-line">{job.company} · {job.city || job.province} · {job.province}</p>
        <p class="meta-line">{job.category} · {job.job_type} · Posted {timeAgo(job.created)}</p>
      </section>

      <div class="apply-top">
        {isExpired ? (
          <button disabled>This job has closed</button>
        ) : (
          <button type="button" class="open-quick-apply" data-job-id={job.id} data-has-form={job.apply_email ? '1' : '0'} data-apply-url={job.apply_url || ''}>Apply Now</button>
        )}
      </div>

      <div class="share-blocks">
        <span class="share-label">Share:</span>
        <a href={`https://wa.me/?text=${encodeURIComponent(`${job.title} at ${job.company} - ${pageUrl}`)}`} target="_blank" rel="noopener" class="share-btn share-wa" data-share={job.id}>WhatsApp</a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" class="share-btn share-li" data-share={job.id}>LinkedIn</a>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${job.title} at ${job.company}`)}&url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" class="share-btn share-x" data-share={job.id}>X</a>
        <button type="button" class="share-btn share-copy" data-copy={pageUrl} data-share={job.id}>Copy link</button>
        <button type="button" class="share-btn share-save" data-save={job.id} id="save-job-btn">&#9825; Save</button>
      </div>

      <section class="panel description">
        <h2>Job description</h2>
        <div set:html={sanitizeHtml(job.description)} />
      </section>

      <SmartAdSlot zone="infeed" category={job.category} />

      {!isExpired && job.apply_email && (
        <section id="apply-section" class="panel apply-form">
          <h2>Apply for this job</h2>
          <form id="apply-form" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value={csrfToken} />
            <input type="hidden" name="job_id" value={job.id} />
            <label>Name <input class="form-field" type="text" name="name" required /></label>
            <label>Email <input class="form-field" type="email" name="email" required /></label>
            <label>Phone <input class="form-field" type="tel" name="phone" /></label>
            <label>Cover letter <textarea class="form-field" name="cover_letter" rows="5"></textarea></label>
            <label>CV (PDF, max 5MB) <input class="form-field" type="file" name="cv_file" accept="application/pdf" /></label>
            <p id="apply-error" hidden></p>
            <button type="submit" id="apply-btn">Submit Application</button>
          </form>
        </section>
      )}

      {!isExpired && !job.apply_email && job.apply_url && (
        <section class="panel external-apply">
          <a href={job.apply_url} target="_blank" rel="noopener">Apply on company website -></a>
        </section>
      )}
    </main>

    <aside>
      <Sidebar category={job.category} />
      {similarJobs.length > 0 && (
        <section class="similar-card">
          <h2>Similar jobs</h2>
          {similarJobs.map((similar) => <JobCard job={similar} compact />)}
        </section>
      )}
    </aside>
  </div>

  {!isExpired && (
    <div id="quick-apply-overlay" class="quick-apply-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="qa-title">
      <div class="quick-apply-modal" role="document">
        <button type="button" class="qa-close" aria-label="Close">&times;</button>
        <h3 id="qa-title">Quick Apply</h3>
        <p class="qa-subtitle">Leave your info to proceed with your application to <strong>{job.company}</strong>.</p>
        <form id="quick-apply-form">
          <input type="hidden" name="_csrf" value={csrfToken} />
          <input type="hidden" name="job_id" value={job.id} />
          <label>Name <input class="form-field" type="text" name="name" required /></label>
          <label>Email <input class="form-field" type="email" name="email" required /></label>
          <p id="qa-error" hidden aria-live="polite"></p>
          <button type="submit" id="qa-btn">Continue</button>
        </form>
      </div>
    </div>
  )}
</Layout>

<script>
  const overlay = document.getElementById('quick-apply-overlay');
  const qaForm = document.getElementById('quick-apply-form');
  const qaBtn = document.getElementById('qa-btn');
  const qaErr = document.getElementById('qa-error');
  let targetApplyUrl = '';

  let lastFocused = null;

  function openQuickApply(url, hasForm) {
    targetApplyUrl = url;
    lastFocused = document.activeElement;
    overlay.hidden = false;
    qaErr.hidden = true;
    qaForm.reset();
    qaBtn.disabled = false;
    qaBtn.textContent = 'Continue';
    setTimeout(() => {
      const firstInput = qaForm?.querySelector('input:not([type=hidden])');
      if (firstInput) (firstInput as HTMLElement).focus();
    }, 10);
  }

  function closeQuickApply() {
    overlay.hidden = true;
    if (lastFocused) (lastFocused as HTMLElement).focus();
  }

  document.querySelector('.open-quick-apply')?.addEventListener('click', function() {
    const hasForm = this.dataset.hasForm === '1';
    openQuickApply(this.dataset.applyUrl || '', hasForm);
  });

  document.querySelector('.qa-close')?.addEventListener('click', closeQuickApply);
  overlay?.addEventListener('click', function(e) {
    if (e.target === overlay) closeQuickApply();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !overlay.hidden) closeQuickApply();
    if (e.key === 'Tab' && !overlay.hidden) {
      const focusable = overlay.querySelectorAll('button, input, select, textarea, a[href]');
      const first = focusable[0] as HTMLElement;
      const last = focusable[focusable.length - 1] as HTMLElement;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  qaForm?.addEventListener('submit', async function(e) {
    e.preventDefault();
    qaBtn.disabled = true;
    qaBtn.textContent = 'Saving\u2026';
    qaErr.hidden = true;

    const fd = new FormData(qaForm);
    const res = await fetch('/api/apply-quick', { method: 'POST', body: fd });
    const d = await res.json();

    if (d.success) {
      const name = fd.get('name');
      const email = fd.get('email');
      overlay.hidden = true;

      const applyForm = document.getElementById('apply-form');
      if (applyForm) {
        const nameInput = applyForm.querySelector('input[name="name"]');
        const emailInput = applyForm.querySelector('input[name="email"]');
        if (nameInput) (nameInput as HTMLInputElement).value = name as string;
        if (emailInput) (emailInput as HTMLInputElement).value = email as string;
        applyForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else if (targetApplyUrl) {
        window.open(targetApplyUrl, '_blank', 'noopener');
      }
    } else {
      qaErr.textContent = d.error;
      qaErr.hidden = false;
      qaBtn.disabled = false;
      qaBtn.textContent = 'Continue';
    }
  });

  const applyFormEl = document.getElementById('apply-form');
  if (applyFormEl) {
    applyFormEl.addEventListener('submit', async e => {
      e.preventDefault();
      const btn = document.getElementById('apply-btn');
      const err = document.getElementById('apply-error');
      btn.disabled = true; btn.textContent = 'Submitting\u2026'; err.hidden = true;
      const res = await fetch('/api/apply', { method: 'POST', body: new FormData(e.target) });
      const d = await res.json();
      if (d.success) {
        applyFormEl.innerHTML = '<p style="color:#2d6a4f;font-weight:500;padding:1rem 0">Application submitted. Good luck!</p>';
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ jobId: '{job.id}', event: 'job_applied' }),
          keepalive: true,
        }).catch(() => {});
      } else {
        err.textContent = d.error; err.hidden = false;
        btn.disabled = false; btn.textContent = 'Submit Application';
      }
    });
  }

  document.querySelectorAll('[data-share]').forEach((element) => {
    element.addEventListener('click', () => {
      fetch('/api/track', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ jobId: (element as HTMLElement).dataset.share, event: 'job_shared' }),
        keepalive: true,
      }).catch(() => {});
    });
  });

  document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const el = button as HTMLButtonElement;
      await navigator.clipboard.writeText(el.dataset.copy || '');
      el.textContent = 'Copied!';
    });
  });

  // ── Save Job Toggle ──
  const saveBtn = document.getElementById('save-job-btn');
  saveBtn?.addEventListener('click', async () => {
    const jobId = saveBtn.dataset.save;
    if (!jobId) return;
    try {
      const res = await fetch('/api/save-job', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ jobId, action: 'toggle' }),
      });
      const data = await res.json();
      if (data.success) {
        const isSaved = data.data?.saved ?? false;
        saveBtn.classList.toggle('saved', isSaved);
        saveBtn.innerHTML = isSaved ? '&#10003; Saved' : '&#9825; Save';
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ jobId, event: 'job_saved' }),
          keepalive: true,
        }).catch(() => {});
      }
    } catch {}
  });

  // ── Growth Funnel Tracking ──
  // Tracking is handled via /api/track (job_viewed) emitted by server-side trackEvent.
</script>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 16px;
    max-width: 1100px;
    margin: 1.5rem auto;
    padding: 0 1.5rem;
  }

  .job-main {
    display: grid;
    gap: 0;
  }

  /* Tightened spacing per spec: jobs-top → breadcrumb (1rem max), then 0.75rem to 1rem between key sections */
  .job-main > :global(.smart-ad--jobs-top) { margin: 0 0 1rem; }
  .breadcrumbs-wrap { margin-bottom: 1rem; }
  .job-header { margin: 0; padding: 12px 14px; }
  .apply-top { margin: 0.75rem 0 0; padding: 10px 0; border-top: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0; }
  .share-blocks { margin: 0.75rem 0 0; padding: 10px 0; border-top: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0; }
  .description { margin: 1rem 0 0; padding: 14px 16px; }
  .job-main > :global(.smart-ad--infeed) { margin: 1rem 0 0; }
  .apply-form { margin: 1.5rem 0 0; padding: 14px 16px; }
  .external-apply { margin: 1rem 0 0; padding: 12px 14px; }

  .job-header h1 {
    margin: 0 0 4px;
    color: #1a1a1a;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
  }

  .company-line,
  .meta-line {
    margin: 0;
    color: #666666;
    font-size: 13px;
  }

  .meta-line {
    margin-top: 4px;
    color: #444444;
  }

  .closed-banner {
    background: #fff8e1;
    border: 1px solid #f0c040;
    border-radius: 6px;
    color: #7a5e00;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
  }

  .apply-top {
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
    padding: 10px 0;
  }

  .share-blocks {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 10px 0;
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
  }

  .share-label {
    color: #888;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-right: 4px;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 72px;
    padding: 7px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    transition: opacity 0.15s ease;
    border: 0;
    cursor: pointer;
    text-decoration: none;
  }

  .share-btn:hover {
    opacity: 0.85;
  }

  .share-wa {
    background: #25D366;
    color: #fff;
  }

  .share-li {
    background: #0A66C2;
    color: #fff;
  }

  .share-x {
    background: #000;
    color: #fff;
  }

  .share-copy {
    background: #fff;
    color: #555;
    border: 1px solid #d0d0d0;
  }

  .share-copy:hover {
    background: #f5f5f5;
    opacity: 1;
  }

  .share-save {
    background: #fff;
    color: #e74c3c;
    border: 1px solid #f5c6cb;
    margin-left: auto;
  }

  .share-save:hover {
    background: #fdf2f2;
    opacity: 1;
  }

  .share-save.saved {
    background: #e74c3c;
    color: #fff;
    border-color: #e74c3c;
  }

  .apply-top a,
  .apply-top button,
  .apply-form button,
  .external-apply a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    border: 1px solid #2d6a4f;
    border-radius: 4px;
    background: #2d6a4f;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
  }

  .apply-top a:hover,
  .apply-form button:hover,
  .external-apply a:hover {
    background: #245a42;
    border-color: #245a42;
  }

  .apply-top button:disabled {
    background: #888888;
    border-color: #888888;
  }

  .description h2,
  .apply-form h2,
  .similar-card h2 {
    margin: 0 0 10px;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 600;
  }

  .description :global(p),
  .description :global(li) {
    color: #444444;
    font-size: 14px;
    line-height: 1.6;
  }

  .description :global(ul) {
    padding-left: 1.2rem;
  }

  .apply-form form {
    display: grid;
    gap: 10px;
  }

  .apply-form label {
    display: grid;
    gap: 4px;
    color: #444444;
    font-size: 12px;
    font-weight: 500;
  }

  #apply-message {
    margin: 0;
    color: #2d6a4f;
    font-size: 13px;
  }

  .similar-card {
    margin-top: 16px;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 1rem 1.25rem;
  }

  @media (max-width: 820px) {
    .detail-grid {
      grid-template-columns: 1fr;
      padding: 0 1rem;
    }
  }

  .quick-apply-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .quick-apply-overlay[hidden] {
    display: none;
  }

  .quick-apply-modal {
    background: #fff;
    border-radius: 8px;
    padding: 24px;
    width: 90%;
    max-width: 400px;
    position: relative;
  }

  .quick-apply-modal h3 {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
  }

  .qa-subtitle {
    margin: 0 0 16px;
    font-size: 13px;
    color: #666;
    line-height: 1.4;
  }

  .qa-close {
    position: absolute;
    top: 10px;
    right: 14px;
    background: none;
    border: 0;
    font-size: 20px;
    color: #888;
    padding: 0;
    line-height: 1;
  }

  .qa-close:hover {
    color: #333;
  }

  #quick-apply-form {
    display: grid;
    gap: 10px;
  }

  #quick-apply-form label {
    display: grid;
    gap: 4px;
    color: #444;
    font-size: 12px;
    font-weight: 500;
  }

  #qa-btn {
    min-height: 40px;
    border: 1px solid #2d6a4f;
    border-radius: 4px;
    background: #2d6a4f;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }

  #qa-btn:hover {
    background: #245a42;
    border-color: #245a42;
  }

  #qa-btn:disabled {
    opacity: 0.6;
  }

  #qa-error {
    color: #c0392b;
    font-size: 12px;
    margin: 0;
  }
</style>
