---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCategoriesWithCounts } from '../lib/pocketbase';
import { listPseoJobs } from '../services/jobService';

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
const perPage = 20;
const [{ items: jobs, totalItems, totalPages }, categories] = await Promise.all([
  listPseoJobs({ jobType: 'Bursary', terms: ['bursary', 'bursaries', 'scholarship'], fields: ['title', 'category'], page, perPage }),
  getCategoriesWithCounts(),
]);

const topCategories = categories.filter(c => c.count > 0).sort((a, b) => (b.count || 0) - (a.count || 0)).slice(0, 8);
const summaryText = `Find ${totalItems.toLocaleString('en-ZA')} bursaries and scholarship opportunities in South Africa for 2026. Apply for government, corporate, and SETA-funded bursaries across all fields of study.`;
---

<Layout
  title="Bursaries in South Africa 2026 | Apply for Funding"
  description={summaryText}
  canonicalUrl={page > 1 ? Astro.url.href : Astro.url.origin + Astro.url.pathname}
  prevPage={page > 1 ? `${Astro.url.origin}/bursaries?page=${Math.max(1, page - 1)}` : undefined}
  nextPage={page < totalPages ? `${Astro.url.origin}/bursaries?page=${page + 1}` : undefined}
>
  <div class="bg-white border-b border-border py-10 px-6">
    <div class="max-w-6xl mx-auto">
      <nav class="text-xs text-muted mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-navy">Home</a> &rsaquo; <span class="text-navy font-medium">Bursaries</span>
      </nav>
      <h1 class="text-2xl font-semibold text-navy">Bursaries in South Africa 2026</h1>
      <p class="text-muted text-sm mt-2">{totalItems.toLocaleString('en-ZA')} bursary and scholarship opportunities</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <div>
      {totalItems > 0 ? (
        <>
          <section class="card p-4 mb-6">
            <h2 class="text-sm font-semibold text-navy mb-2">Popular Bursary Fields</h2>
            <div class="flex flex-wrap gap-2">
              {topCategories.map(cat => (
                <a href={`/category/${cat.slug}`} class="inline-flex items-center px-3 py-1.5 bg-[#e8f4f0] text-[#2d6a4f] text-xs font-medium rounded-full hover:bg-[#d0ebe0] transition-colors">
                  {cat.name} ({cat.count})
                </a>
              ))}
              <a href="/categories" class="inline-flex items-center px-3 py-1.5 border border-border text-muted text-xs font-medium rounded-full hover:border-accent hover:text-accent transition-colors">All categories &rarr;</a>
            </div>
          </section>
          <div class="space-y-3">
            {jobs.map(job => <JobCard job={job} />)}
          </div>
        </>
      ) : (
        <div class="card text-center py-12">
          <h2 class="text-lg font-semibold text-navy mb-2">No bursaries available</h2>
          <p class="text-muted text-sm mb-4">Check back soon for new bursary listings.</p>
          <a href="/jobs" class="inline-flex items-center px-4 py-2 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors">Browse All Jobs</a>
        </div>
      )}
      {totalPages > 1 && (
        <div class="flex gap-1.5 mt-6 flex-wrap">
          {page > 1 && <a href={`/bursaries?page=${page-1}`} class="px-3 py-1.5 border border-border rounded-lg text-sm text-muted hover:border-accent bg-white">Previous</a>}
          {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
            const p = i + 1;
            return <a href={`/bursaries?page=${p}`} class={`px-3 py-1.5 rounded-lg text-sm border ${p === page ? 'border-accent bg-accent text-white font-semibold' : 'border-border text-muted hover:border-accent bg-white'}`}>{p}</a>;
          })}
          {page < totalPages && <a href={`/bursaries?page=${page+1}`} class="px-3 py-1.5 border border-border rounded-lg text-sm text-muted hover:border-accent bg-white">Next</a>}
        </div>
      )}
    </div>
    <aside class="hidden lg:block"><Sidebar /></aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Bursaries in South Africa 2026',
    description: summaryText,
    url: `${Astro.url.origin}/bursaries`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: jobs.map((job, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${Astro.url.origin}/job/${job.slug}`,
      })),
    },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I apply for bursaries in South Africa?', acceptedAnswer: { '@type': 'Answer', text: 'Browse bursary listings on Edubuzz, select the opportunity that matches your field of study, and follow the application instructions in each listing. Most bursaries require academic transcripts, proof of registration, a motivational letter and ID documents.' } },
      { '@type': 'Question', name: 'What types of bursaries are available?', acceptedAnswer: { '@type': 'Answer', text: 'South Africa offers various bursary types including government bursaries (NSFAS, provincial), corporate bursaries (from companies like Sasol, Eskom), SETA-funded bursaries, merit-based academic bursaries, and field-specific bursaries for scarce skills like engineering and medicine.' } },
    ],
  })} />
</Layout>
