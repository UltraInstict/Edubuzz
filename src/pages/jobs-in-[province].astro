---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getJobs, getCategoriesWithCounts, PROVINCES } from '../lib/pocketbase';
import { provinceName, slugify } from '../lib/slugify';

const { province: provinceSlug } = Astro.params;
const province = provinceName(provinceSlug || '');
if (!province || !PROVINCES.includes(province)) return Astro.redirect('/404');

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
const perPage = 20;
const [{ items: jobs, totalItems, totalPages }, categories] = await Promise.all([
  getJobs({ page, perPage, province }),
  getCategoriesWithCounts(),
]);

const topCategories = categories.filter(c => c.count > 0).sort((a, b) => (b.count || 0) - (a.count || 0)).slice(0, 8);
const summaryText = `Browse ${totalItems.toLocaleString('en-ZA')} jobs in ${province}, South Africa. Find full-time, part-time, government and remote positions in ${province} across all industries.`;
---

<Layout
  title={`Jobs in ${province} | ${totalItems.toLocaleString('en-ZA')} Vacancies`}
  description={summaryText}
  canonicalUrl={page > 1 ? Astro.url.href : Astro.url.origin + Astro.url.pathname}
  prevPage={page > 1 ? `${Astro.url.origin}/jobs-in-${provinceSlug}?page=${Math.max(1, page - 1)}` : undefined}
  nextPage={page < totalPages ? `${Astro.url.origin}/jobs-in-${provinceSlug}?page=${page + 1}` : undefined}
  adsEligible={totalItems > 0}
>
  <div class="bg-white border-b border-gray-200 py-10 px-6">
    <div class="max-w-6xl mx-auto">
      <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gray-900">Home</a> &rsaquo; <a href="/provinces" class="hover:text-gray-900">Provinces</a> &rsaquo; <span class="text-gray-900 font-medium">Jobs in {province}</span>
      </nav>
      <h1 class="text-2xl font-semibold text-gray-900">Jobs in {province}</h1>
      <p class="text-gray-500 text-sm mt-2">{totalItems.toLocaleString('en-ZA')} jobs available in {province}</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <div>
      {totalItems > 0 && (
        <>
          <section class="card p-5 mb-6">
            <h2 class="text-sm font-semibold text-gray-900 mb-2">Popular Categories in {province}</h2>
            <div class="flex flex-wrap gap-2">
              {topCategories.map(cat => (
                <a href={`/${slugify(cat.name)}-jobs-in-${provinceSlug}`} class="inline-flex items-center px-3 py-1.5 bg-green-50 text-green-800 text-xs font-medium rounded-full hover:bg-green-100 transition-colors">
                  {cat.name} ({cat.count})
                </a>
              ))}
            </div>
          </section>
          <section class="card p-5 mb-6">
            <h2 class="text-sm font-semibold text-gray-900 mb-2">Other Provinces</h2>
            <div class="flex flex-wrap gap-2">
              {PROVINCES.filter(p => p !== province).map(p => (
                <a href={`/jobs-in-${slugify(p)}`} class="inline-flex items-center px-3 py-1.5 border border-gray-200 text-gray-500 text-xs font-medium rounded-full hover:border-green-800 hover:text-green-800 transition-colors">
                  {p}
                </a>
              ))}
            </div>
          </section>
        </>
      )}
      <div class="space-y-3">
        {jobs.map(job => <JobCard job={job} />)}
      </div>
      {totalItems === 0 && (
        <div class="card text-center py-12">
          <h2 class="text-lg font-semibold text-gray-900 mb-2">No jobs in {province} right now</h2>
          <p class="text-gray-500 text-sm mb-4">Check other provinces or browse all jobs.</p>
          <a href="/jobs" class="inline-flex items-center px-4 py-2 bg-green-800 text-white text-sm font-medium rounded-md hover:bg-green-900 transition-colors">Browse All Jobs</a>
        </div>
      )}
      {totalPages > 1 && (
        <div class="flex gap-1.5 mt-6 flex-wrap">
          {page > 1 && <a href={`/jobs-in-${provinceSlug}?page=${page-1}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-green-800 hover:border-green-800 hover:text-green-900 bg-white">Previous</a>}
          {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
            const p = i + 1;
            return <a href={`/jobs-in-${provinceSlug}?page=${p}`} class={`px-3 py-1.5 rounded-md text-sm border ${p === page ? 'border-green-800 bg-green-800 text-white font-semibold' : 'border-gray-200 text-green-800 hover:border-green-800 hover:text-green-900 bg-white'}`}>{p}</a>;
          })}
          {page < totalPages && <a href={`/jobs-in-${provinceSlug}?page=${page+1}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-green-800 hover:border-green-800 hover:text-green-900 bg-white">Next</a>}
        </div>
      )}
    </div>
    <aside class="hidden lg:block"><Sidebar /></aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Jobs in ${province}`,
    description: summaryText,
    url: `${Astro.url.origin}/jobs-in-${provinceSlug}`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: jobs.map((job, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${Astro.url.origin}/job/${job.slug}`,
      })),
    },
  })} />
</Layout>
