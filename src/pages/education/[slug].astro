---
import Layout from '../../layouts/Layout.astro';
import { EDUCATION_GUIDES } from '../../content/education-guides';
import { CAREER_GUIDES } from '../../content/career-guides';
import { ARTICLES } from '../../content/resources';
import { SITE_URL } from '../../lib/constants';

const { slug } = Astro.params;
const guide = EDUCATION_GUIDES.find(g => g.slug === slug);
if (!guide) return Astro.redirect('/404');

const relatedCareers = guide.careerLinks
  .map(s => CAREER_GUIDES.find(c => c.slug === s))
  .filter(Boolean);
const relatedResources = guide.resourceLinks
  .map(s => ARTICLES.find(a => a.slug === s))
  .filter(Boolean);
const otherGuides = EDUCATION_GUIDES.filter(g => g.slug !== slug).slice(0, 4);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Education', item: `${SITE_URL}/education` },
    { '@type': 'ListItem', position: 3, name: guide.h1 },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.h1,
  description: guide.description,
  dateModified: guide.updated,
  datePublished: guide.updated,
  author: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}/education/${guide.slug}` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
  title={guide.title}
  description={guide.description}
  canonicalUrl={`${SITE_URL}/education/${guide.slug}`}
  ogType="article"
  adsEligible={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="max-w-3xl mx-auto px-4 py-8">
    <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-900">Home</a> &rsaquo;
      <a href="/education" class="hover:text-gray-900">Education</a> &rsaquo;
      <span class="text-gray-900 font-medium">{guide.h1}</span>
    </nav>

    <header class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">{guide.h1}</h1>
      <div class="flex items-center gap-3 text-xs text-gray-500">
        <span>Updated {guide.updated}</span>
        <span>&middot;</span>
        <span>{guide.readMins} min read</span>
      </div>
    </header>

    <p class="text-gray-700 text-base leading-relaxed mb-6">{guide.intro}</p>

    <article class="prose prose-sm max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-green-800 prose-li:text-gray-700 mb-8" set:html={guide.body} />

    {guide.faqs.length > 0 && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {guide.faqs.map(faq => (
            <details class="border border-gray-200 rounded-md p-4 group">
              <summary class="font-medium text-sm text-gray-900 cursor-pointer group-open:mb-2">{faq.q}</summary>
              <p class="text-sm text-gray-600 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="mb-8 bg-gray-50 border border-gray-200 rounded-md p-5">
      <h2 class="text-base font-semibold text-gray-900 mb-2">Verify before you act</h2>
      <p class="text-sm text-gray-600 leading-relaxed">
        Rules, thresholds and application dates change. Always confirm current requirements with the
        official sources: the <a href="https://www.dhet.gov.za" target="_blank" rel="noopener noreferrer" class="text-green-800 hover:underline">Department of Higher Education and Training (DHET)</a>,
        <a href="https://www.nsfas.org.za" target="_blank" rel="noopener noreferrer" class="text-green-800 hover:underline"> NSFAS</a>, and the institution you are applying to.
      </p>
    </section>

    {relatedCareers.length > 0 && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Related career guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedCareers.map(c => (
            <a href={`/careers/${c.slug}`} class="border border-gray-200 rounded-md p-4 hover:border-green-800 transition-colors">
              <h3 class="text-sm font-semibold text-gray-900 mb-1">{c.h1}</h3>
              <p class="text-xs text-gray-500">{c.readMins} min read</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {relatedResources.length > 0 && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Helpful resources</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedResources.map(a => (
            <a href={`/resources/${a.slug}`} class="border border-gray-200 rounded-md p-4 hover:border-green-800 transition-colors">
              <h3 class="text-sm font-semibold text-gray-900 mb-1">{a.h1}</h3>
              <p class="text-xs text-gray-500">{a.readMins} min read</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mb-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">More education guides</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {otherGuides.map(g => (
          <a href={`/education/${g.slug}`} class="border border-gray-200 rounded-md p-4 hover:border-green-800 transition-colors">
            <h3 class="text-sm font-semibold text-gray-900 mb-1">{g.h1}</h3>
            <p class="text-xs text-gray-500">{g.readMins} min read</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
