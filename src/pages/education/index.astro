---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { EDUCATION_GUIDES } from '../../content/education-guides';
import { SITE_URL } from '../../lib/constants';
---
<Layout title="Education and study pathways in South Africa" description="Explore TVET colleges, university routes and funding. Understand your choices before taking the next step." canonicalUrl={SITE_URL + '/education'} adsEligible={true}>
<main class="shell">
<header class="collection-intro"><span class="eyebrow">EDUCATION / YOUR NEXT CHAPTER</span><h1>Find a study path that fits you.</h1><p>Explore TVET colleges, university routes and funding. Understand your choices before taking the next step.</p></header>
<div class="editorial-grid" style="padding-bottom:65px">{EDUCATION_GUIDES.map(g => <GuideCard href={'/education/' + g.slug} title={g.h1} description={g.description} label="Study & funding" readMins={g.readMins} />)}</div>
<section class="feature-banner" style="margin-bottom:65px"><div><span class="eyebrow">KEEP EXPLORING</span><h2>What could your future look like?</h2><p>Connect your study choices with careers you can build.</p><a class="button-primary" href="/careers">Explore careers ↗</a></div><span class="banner-art" aria-hidden="true">↗</span></section>
</main></Layout>
