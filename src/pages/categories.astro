---
import Layout from '../layouts/Layout.astro';
import { getCategoriesWithCounts } from '../services/jobService';
import { JOBS_PUBLIC } from '../lib/featureFlags';

// AdSense phase: category index → industry hub listing.
if (!JOBS_PUBLIC) {
  return Astro.redirect('/careers', 301);
}

const categories = await getCategoriesWithCounts();
---

<Layout title="Browse Jobs by Category" description="Find jobs in your field across all nine South African provinces." canonicalUrl={Astro.url.href}>
  <div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Browse jobs by category</h1>
    <p class="text-sm text-gray-600 leading-relaxed mb-6">Find jobs in your field across all nine provinces.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
      {categories.map(cat => (
        <a href={`/category/${cat.slug}`} class="bg-white border border-gray-200 rounded-md p-5 hover:border-green-800 transition-colors block">
          <span class="text-sm font-medium text-gray-900">{cat.name}</span>
          <span class="block text-xs text-gray-500 mt-0.5">{cat.count.toLocaleString('en-ZA')} jobs</span>
        </a>
      ))}
    </div>
    <p class="text-sm text-gray-600 mt-6">Can't find your category? <a href="/jobs" class="text-green-800 hover:text-green-900 hover:underline font-medium">Browse all jobs</a> or use the search bar to find roles by keyword.</p>
  </div>
</Layout>
