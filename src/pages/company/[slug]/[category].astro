---
import Layout from '../../../layouts/Layout.astro';
import JobCard from '../../../components/JobCard.astro';
import { getEmployerBySlug, getJobs } from '../../../lib/pocketbase';
import { slugify, titleFromSlug } from '../../../lib/slugify';
const employer = await getEmployerBySlug(Astro.params.slug || '');
if (!employer) return Astro.redirect('/404');
const category = titleFromSlug((Astro.params.category || '').replace(/-jobs$/, ''));
const all = await getJobs({ perPage: 50, category });
const jobs = all.items.filter(job => job.company === employer.company_name || job.employer_id === employer.id);
---
<Layout title={`${category} Jobs at ${employer.company_name}`} description={`Browse ${category} jobs at ${employer.company_name}.`} canonicalUrl={Astro.url.href}>
<main class="company-page"><h1>{category} Jobs at {employer.company_name}</h1>{jobs.map(job=><JobCard job={job}/>)}</main>
</Layout>
<style>.company-page{max-width:900px;margin:1.5rem auto;padding:0 1.5rem}h1{font-size:22px;margin:0 0 12px;font-weight:600;letter-spacing:-0.3px}</style>
