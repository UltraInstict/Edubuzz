---
import Layout from '../../layouts/Layout.astro';
import { COMPANY_GUIDES } from '../../content/company-guides';
import { CAREER_GUIDES } from '../../content/career-guides';
import { ARTICLES } from '../../content/resources';
import { SITE_URL } from '../../lib/constants';
import { getEmployerBySlug } from '../../lib/pocketbase';

const { slug } = Astro.params;

/**
 * Exact-identity duplicate employer slugs → curated company guide.
 * e.g. /company/shoprite-group → /company/shoprite.
 * Verified against the PocketBase employers collection (2026-08-13).
 */
const EMPLOYER_ALIAS_TO_GUIDE: Record<string, string> = {
  'shoprite-group': 'shoprite',
  'capitec-bank': 'capitec',
  'standard-bank-group': 'standard-bank',
  'clicks-group': 'clicks',
  // Same company under two PB slugs — consolidate to one stub page.
  'takealot-com': 'takealot-group',
};

const aliasTarget = EMPLOYER_ALIAS_TO_GUIDE[slug || ''];
if (aliasTarget && aliasTarget !== slug) {
  return Astro.redirect(`/company/${aliasTarget}`, 301);
}

// 1) Curated employer guide, or 2) existing PocketBase employer record
// (informational only during the AdSense phase — no job listings rendered).
const guide = COMPANY_GUIDES.find(c => c.slug === slug);
const employer = guide ? null : await getEmployerBySlug(slug || '').catch(() => null);
if (!guide && !employer) return Astro.redirect('/404');

const name = guide?.name || employer?.company_name || 'Employer';
const sector = guide?.sector || 'Employer';
const locationLabel = employer ? [employer.city, employer.province].filter(Boolean).join(', ') : '';
const website = guide?.officialSite || employer?.website || '';
// PB-only records are thin stubs. Review separately; noindex is not an
// AdSense approval exemption.
const isThinStub = !guide;

const relatedCareers = (guide?.careerLinks || [])
  .map(s => CAREER_GUIDES.find(c => c.slug === s))
  .filter(Boolean);
const otherCompanies = COMPANY_GUIDES.filter(c => c.slug !== slug && c.sector === sector).slice(0, 4);
const applicationGuides = ['how-to-write-your-first-cv-no-experience', 'how-to-apply-for-jobs-online', 'star-method-interview-technique', 'how-to-check-if-a-job-is-legitimate']
  .map(slug => ARTICLES.find(a => a.slug === slug)).filter(Boolean);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Companies', item: `${SITE_URL}/companies` },
    { '@type': 'ListItem', position: 3, name },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${name} Careers`,
  description: guide?.description || `${name} is an employer in South Africa${locationLabel ? `, based in ${locationLabel}` : ''}. Learn how to apply and prepare for opportunities at ${name}.`,
  dateModified: guide?.updated,
  author: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}/company/${slug}` },
};

const faqSchema = guide ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;
---

<Layout
  title={guide?.title || `${name} Careers in South Africa`}
  description={guide?.description || `${name} is an employer in South Africa${locationLabel ? `, based in ${locationLabel}` : ''}. Find out how to apply for opportunities at ${name} and how to prepare.`}
  canonicalUrl={`${SITE_URL}/company/${slug}`}
  ogType="article"
  adsEligible={true}
  noindex={isThinStub}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  {guide && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />}

  <div class="max-w-3xl mx-auto px-4 py-8">
    <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-900">Home</a> &rsaquo;
      <a href="/companies" class="hover:text-gray-900">Companies</a> &rsaquo;
      <span class="text-gray-900 font-medium">{name}</span>
    </nav>

    <header class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">{name} Careers</h1>
      <div class="flex items-center gap-3 text-xs text-gray-500">
        <span>{sector}{locationLabel ? ` · ${locationLabel}` : ''}</span>
        {website && <a href={website} target="_blank" rel="noopener noreferrer" class="text-green-800 hover:underline">Official website &rarr;</a>}
      </div>
      {guide && <p class="text-sm text-gray-600 mt-4 leading-relaxed">Independent application guide · Updated 7 October 2026. Edubuzz is not affiliated with {name}, does not accept applications for the employer and does not confirm live vacancies.</p>}
    </header>

    {guide ? (
      <>
        <nav aria-label="In this guide" class="border border-gray-200 rounded-md p-4 mb-6 text-sm flex flex-wrap gap-3">
          <a href="#routes">Career routes</a><a href="#prepare">Preparation</a><a href="#apply">Application steps</a><a href="#sources">Sources &amp; limits</a>
        </nav>
        <section class="prose prose-sm max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-green-800 prose-li:text-gray-700 mb-8" set:html={guide.overview} />

        <section id="routes" class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Career areas at {name}</h2>
          <div class="flex flex-wrap gap-2">
            {guide.careerAreas.map(area => (
              <span class="px-3 py-1.5 bg-green-50 border border-green-200 rounded-full text-xs text-green-800">{area}</span>
            ))}
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Choosing an entry route</h2>
          <div class="prose prose-sm max-w-none prose-p:text-gray-700 prose-li:text-gray-700" set:html={guide.entryLevel} />
        </section>

        <section id="prepare" class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Prepare evidence for your application</h2>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">The examples below are Edubuzz preparation advice, not employer interview questions or confirmed selection criteria.</p>
          <div class="space-y-5">
            {guide.preparation.map(item => <div><h3 class="font-semibold text-gray-900 mb-2">{item.title}</h3><p class="text-sm text-gray-700 leading-relaxed">{item.text}</p></div>)}
          </div>
        </section>

        <section class="mb-8 rounded-md bg-green-50 border border-green-200 p-5">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Check before you submit</h2>
          <ul class="list-disc pl-5 text-sm text-gray-700 space-y-2">{guide.checks.map(check => <li>{check}</li>)}</ul>
        </section>

        <section id="apply" class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">How to apply</h2>
          <div class="prose prose-sm max-w-none prose-p:text-gray-700 prose-a:text-green-800 prose-li:text-gray-700" set:html={guide.howToApply} />
          <a href={guide.officialSite} target="_blank" rel="noopener noreferrer" class="inline-block mt-3 bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Visit the official careers site</a>
        </section>

        <section id="sources" class="mb-8 border-t border-gray-200 pt-5">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Sources and verification limits</h2>
          <p class="text-sm text-gray-700 leading-relaxed mb-3">{guide.sourceNote}</p>
          <a href={guide.officialSite} target="_blank" rel="noopener noreferrer" class="text-sm text-green-800 underline">{name} careers source</a>
          {guide.slug === 'mr-price' && <p class="mt-2 text-sm"><a href="https://www.mrp.com/customer-service/faqs" target="_blank" rel="noopener noreferrer" class="text-green-800 underline">Mr Price recruitment-channel FAQ</a></p>}
          <p class="text-sm text-gray-600 leading-relaxed mt-3">Reviewed 7 October 2026. Current requirements, deadlines, programme availability and selection arrangements can change. Confirm them in the employer's advert. <a href="/contact" class="text-green-800 underline">Report an outdated detail</a>.</p>
        </section>

        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {guide.faqs.map(faq => (
              <details class="border border-gray-200 rounded-md p-4 group">
                <summary class="font-medium text-sm text-gray-900 cursor-pointer group-open:mb-2">{faq.q}</summary>
                <p class="text-sm text-gray-600 leading-relaxed">{faq.a}</p>
              </details>
            ))}
          </div>
        </section>
      </>
    ) : (
      <>
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">About {name}</h2>
          <div class="prose prose-sm max-w-none prose-p:text-gray-700 prose-a:text-green-800" set:html={employer?.description || `<p>${name} is an employer in South Africa${locationLabel ? `, based in ${locationLabel}` : ''}. For the latest information about opportunities at ${name}, visit the company's official website.</p>`} />
        </section>

        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">How to apply for opportunities at {name}</h2>
          <p class="text-sm text-gray-700 leading-relaxed mb-3">
            The most reliable way to apply is through {name}'s official careers or contact channels.
            This employer record is not a reviewed application guide or vacancy confirmation.
            Verify any recruitment instructions directly and share sensitive documents only
            when requested through a verified channel.
          </p>
          {website && (
            <a href={website} target="_blank" rel="noopener noreferrer" class="inline-block bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Visit the official website</a>
          )}
        </section>
      </>
    )}

    {relatedCareers.length > 0 && (
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Related career guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedCareers.map(c => (
            <a href={`/careers/${c.slug}`} class="border border-gray-200 rounded-md p-4 hover:border-green-800 transition-colors">
              <h3 class="text-sm font-semibold text-gray-900 mb-1">{c.h1}</h3>
              <p class="text-xs text-gray-500">{c.readMins} min read</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mb-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Helpful application guides</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {applicationGuides.map(a => (
          <a href={`/resources/${a.slug}`} class="border border-gray-200 rounded-md p-4 hover:border-green-800 transition-colors">
            <h3 class="text-sm font-semibold text-gray-900 mb-1">{a.h1}</h3>
            <p class="text-xs text-gray-500">{a.readMins} min read</p>
          </a>
        ))}
      </div>
    </section>

    {otherCompanies.length > 0 && <section class="mb-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Other employer guides</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {otherCompanies.map(c => (
          <a href={`/company/${c.slug}`} class="border border-gray-200 rounded-md p-4 hover:border-green-800 transition-colors">
            <h3 class="text-sm font-semibold text-gray-900 mb-1">{c.name}</h3>
            <p class="text-xs text-gray-500">{c.sector}</p>
          </a>
        ))}
      </div>
    </section>}
  </div>
</Layout>
