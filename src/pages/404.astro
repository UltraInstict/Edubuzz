---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Edubuzz">
  <div class="max-w-6xl mx-auto px-6 py-24 text-center">
    <p class="text-6xl mb-4">🔍</p>
    <h1 class="font-serif text-4xl text-navy mb-3">Page not found</h1>
    <p class="text-muted mb-8">The job or page you're looking for doesn't exist or may have expired.</p>
    <a href="/" class="btn-primary">Browse all jobs</a>
  </div>
</Layout>
