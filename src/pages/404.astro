---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import { getJobs } from '../lib/pocketbase';

const url = new URL(Astro.request.url);
const isJobUrl = url.pathname.startsWith('/job/');
const isGone = url.searchParams.get('reason') === 'expired';

const suggestions = (isJobUrl || isGone) ? await getJobs({ perPage: 4 }).catch(() => ({ items: [] })) : { items: [] };

Astro.response.status = isGone ? 410 : 404;
---

<Layout title={isGone ? 'Job expired' : 'Page not found'} description={isGone ? 'This job has expired.' : 'This page doesn\'t exist.'} canonicalUrl="" noindex={true}>
  <main class="not-found">
    <p class="code">{isGone ? '410' : '404'}</p>
    {isJobUrl || isGone ? (
      <>
        <h1>{isGone ? 'This job has expired' : 'This job may have expired'}</h1>
        <p>The listing you're looking for has been removed, filled, or never existed.</p>
      </>
    ) : (
      <>
        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist.</p>
      </>
    )}
    <a href="/" class="btn-home">Go to homepage &rarr;</a>
    {suggestions.items.length > 0 && (
      <section class="suggestions">
        <p>Or try one of these:</p>
        {suggestions.items.map((job) => <JobCard job={job} compact />)}
      </section>
    )}
  </main>
</Layout>

<style>
  .not-found { max-width: 720px; margin: 0 auto; min-height: 56vh; padding: 3rem 1rem; text-align: center; }
  .code { margin: 0; color: #888888; font-size: 56px; font-weight: 600; line-height: 1; }
  h1 { margin: 8px 0 4px; font-size: 22px; font-weight: 600; letter-spacing: -0.3px; }
  p { color: #666666; font-size: 13px; }
  .btn-home { display: inline-flex; margin: 12px 0 22px; border: 1px solid #2d6a4f; background: #2d6a4f; color: #fff; border-radius: 4px; padding: 9px 12px; font-size: 13px; font-weight: 600; }
  .suggestions { text-align: left; }
</style>
