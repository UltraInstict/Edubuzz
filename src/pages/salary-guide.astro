---
import Layout from '../layouts/Layout.astro';

const ranges = [
  ['Government', 'R18,000 - R45,000/month'],
  ['Health (Nursing)', 'R22,000 - R55,000/month'],
  ['IT & Tech', 'R30,000 - R90,000/month'],
  ['Education', 'R15,000 - R35,000/month'],
  ['Finance', 'R35,000 - R80,000/month'],
  ['Engineering', 'R40,000 - R100,000/month'],
];
---

<Layout title="South Africa Salary Guide" description="Average salaries by job category in South Africa." canonicalUrl={Astro.url.href}>
  <main class="salary-page">
    <h1>South Africa Salary Guide</h1>
    <p>Average salaries by category</p>
    <p class="note">Coming soon - updated monthly based on job listings</p>
    <section class="grid">
      {ranges.map(([category, range]) => <div class="panel"><h2>{category}</h2><strong>{range}</strong></div>)}
    </section>
  </main>
</Layout>

<style>
  .salary-page { max-width: 1000px; margin: 1.5rem auto; padding: 0 1.5rem; }
  h1 { margin: 0 0 4px; font-size: 22px; font-weight: 600; letter-spacing: -0.3px; }
  p { color: #666; font-size: 13px; }
  .note { margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  h2 { margin: 0 0 6px; font-size: 14px; font-weight: 600; }
  strong { color: #2d6a4f; font-size: 13px; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
