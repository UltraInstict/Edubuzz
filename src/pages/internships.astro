---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCategoriesWithCounts } from '../lib/pocketbase';
import { listPseoJobs } from '../services/jobService';

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
const perPage = 20;
const [{ items: jobs, totalItems, totalPages }, categories] = await Promise.all([
  listPseoJobs({ jobType: 'Internship', terms: ['intern', 'internship'], fields: ['title'], page, perPage }),
  getCategoriesWithCounts(),
]);

const topCategories = categories.filter(c => c.count > 0).sort((a, b) => (b.count || 0) - (a.count || 0)).slice(0, 8);
const summaryText = `Find ${totalItems.toLocaleString('en-ZA')} internships across South Africa. Browse internship opportunities in IT, finance, engineering, marketing, government and more.`;
---

<Layout
  title="Internships in South Africa | Entry-Level Jobs"
  description={summaryText}
  canonicalUrl={page > 1 ? Astro.url.href : Astro.url.origin + Astro.url.pathname}
  prevPage={page > 1 ? `${Astro.url.origin}/internships?page=${Math.max(1, page - 1)}` : undefined}
  nextPage={page < totalPages ? `${Astro.url.origin}/internships?page=${page + 1}` : undefined}
>
  <div class="bg-white border-b border-gray-200 py-10 px-6">
    <div class="max-w-6xl mx-auto">
      <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gray-900">Home</a> &rsaquo; <span class="text-gray-900 font-medium">Internships</span>
      </nav>
      <h1 class="text-2xl font-semibold text-gray-900">Internships in South Africa</h1>
      <p class="text-gray-500 text-sm mt-1 mb-2">Internships in South Africa offer graduates and students hands-on work experience, typically lasting 6 to 12 months. Browse current internship opportunities across all sectors.</p>
      <p class="text-gray-500 text-sm mt-2">{totalItems.toLocaleString('en-ZA')} internship opportunities across South Africa</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <div>
      {totalItems > 0 ? (
        <>
          <section class="card p-5 mb-6">
            <h2 class="text-sm font-semibold text-gray-900 mb-2">Popular Internship Fields</h2>
            <div class="flex flex-wrap gap-2">
              {topCategories.map(cat => (
                <a href={`/category/${cat.slug}`} class="inline-flex items-center px-3 py-1.5 bg-green-50 text-green-800 text-xs font-medium rounded-full hover:bg-green-100 transition-colors">
                  {cat.name} ({cat.count})
                </a>
              ))}
              <a href="/categories" class="inline-flex items-center px-3 py-1.5 border border-gray-200 text-gray-500 text-xs font-medium rounded-full hover:border-green-800 hover:text-green-800 transition-colors">
                All categories &rarr;
              </a>
            </div>
          </section>
          <div class="space-y-3">
            {jobs.map(job => <JobCard job={job} />)}
          </div>
        </>
      ) : (
        <div class="card text-center py-12">
          <h2 class="text-lg font-semibold text-gray-900 mb-2">No internships available right now</h2>
          <p class="text-gray-500 text-sm mb-4">Check back soon or browse all jobs.</p>
          <a href="/jobs" class="inline-flex items-center px-4 py-2 bg-green-800 text-white text-sm font-medium rounded-md hover:bg-green-900 transition-colors">Browse All Jobs</a>
        </div>
      )}
      {totalPages > 1 && (
        <div class="flex gap-1.5 mt-6 flex-wrap">
          {page > 1 && <a href={`/internships?page=${page-1}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-gray-500 hover:border-green-800 bg-white">Previous</a>}
          {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
            const p = i + 1;
            return <a href={`/internships?page=${p}`} class={`px-3 py-1.5 rounded-md text-sm border ${p === page ? 'border-green-800 bg-green-800 text-white font-semibold' : 'border-gray-200 text-green-800 hover:border-green-800 hover:text-green-900 bg-white'}`}>{p}</a>;
          })}
          {page < totalPages && <a href={`/internships?page=${page+1}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-gray-500 hover:border-green-800 bg-white">Next</a>}
        </div>
      )}
    </div>
    <aside class="hidden lg:block"><Sidebar /></aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Internships in South Africa',
    description: summaryText,
    url: `${Astro.url.origin}/internships`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: jobs.map((job, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${Astro.url.origin}/job/${job.slug}`,
      })),
    },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How do I find internships in South Africa?', acceptedAnswer: { '@type': 'Answer', text: 'Browse internships by category on Edubuzz. Use the search to filter by your field of interest such as IT, finance, engineering or marketing. Many companies post internships directly through our platform.' } },
      { '@type': 'Question', name: 'Are internships paid in South Africa?', acceptedAnswer: { '@type': 'Answer', text: 'Internship compensation varies by industry and employer. Some internships offer stipends or salaries while others may be unpaid but offer valuable work experience. Check each job listing for specific compensation details.' } },
      { '@type': 'Question', name: 'Can students apply for internships on Edubuzz?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, many internships on Edubuzz are open to current students and recent graduates. Check the requirements section of each listing for specific eligibility criteria.' } },
    ],
  })} />
</Layout>
