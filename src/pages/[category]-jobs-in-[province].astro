---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getJobs, getCategoryBySlug } from '../lib/pocketbase';
import { provinceName, titleFromSlug, slugify } from '../lib/slugify';
import { PROVINCES } from '../lib/pocketbase';

const { category: categorySlug, province: provinceSlug } = Astro.params;
const province = provinceName(provinceSlug || '');
if (!province || !PROVINCES.includes(province)) return Astro.redirect('/404');

const category = await getCategoryBySlug(categorySlug || '');
if (!category) return Astro.redirect('/404');

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
const perPage = 20;
const { items: jobs, totalItems, totalPages } = await getJobs({
  page, perPage, category: category.name, province,
});

const summaryText = `Find ${totalItems.toLocaleString('en-ZA')} ${category.name} jobs in ${province}. Browse ${category.name.toLowerCase()} vacancies in ${province} — updated daily on Edubuzz.`;
const pageCanonical = page > 1 ? Astro.url.href : Astro.url.origin + Astro.url.pathname;
---

<Layout
  title={`${category.name} Jobs in ${province} | ${totalItems.toLocaleString('en-ZA')} Vacancies`}
  description={summaryText}
  canonicalUrl={pageCanonical}
  prevPage={page > 1 ? `${Astro.url.origin}/${categorySlug}-jobs-in-${provinceSlug}?page=${Math.max(1, page - 1)}` : undefined}
  nextPage={page < totalPages ? `${Astro.url.origin}/${categorySlug}-jobs-in-${provinceSlug}?page=${page + 1}` : undefined}
>
  <div class="bg-white border-b border-border py-10 px-6">
    <div class="max-w-6xl mx-auto">
      <nav class="text-xs text-muted mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-navy">Home</a> &rsaquo; <a href={`/category/${category.slug}`} class="hover:text-navy">{category.name} Jobs</a> &rsaquo; <span class="text-navy font-medium">{category.name} Jobs in {province}</span>
      </nav>
      <h1 class="text-2xl font-semibold text-navy">{category.name} Jobs in {province}</h1>
      <p class="text-muted text-sm mt-2">{totalItems.toLocaleString('en-ZA')} {category.name.toLowerCase()} jobs available in {province}</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <div>
      {totalItems > 0 && (
        <section class="card p-4 mb-6">
          <h2 class="text-sm font-semibold text-navy mb-2">Browse {category.name} Jobs by Province</h2>
          <div class="flex flex-wrap gap-2">
            {PROVINCES.filter(p => p !== province).map(p => (
              <a href={`/${slugify(category.name)}-jobs-in-${slugify(p)}`} class="inline-flex items-center px-3 py-1.5 border border-border text-muted text-xs font-medium rounded-full hover:border-accent hover:text-accent transition-colors">
                {p}
              </a>
            ))}
          </div>
        </section>
      )}
      <div class="space-y-3">
        {jobs.map(job => <JobCard job={job} />)}
      </div>
      {totalItems === 0 && (
        <div class="card text-center py-12">
          <h2 class="text-lg font-semibold text-navy mb-2">No {category.name} jobs in {province} right now</h2>
          <p class="text-muted text-sm mb-4">Browse {category.name} jobs in other provinces or across South Africa.</p>
          <a href={`/category/${category.slug}`} class="inline-flex items-center px-4 py-2 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-dark transition-colors">
            All {category.name} Jobs &rarr;
          </a>
        </div>
      )}
      {totalPages > 1 && (
        <div class="flex gap-1.5 mt-6 flex-wrap">
          {page > 1 && <a href={`/${categorySlug}-jobs-in-${provinceSlug}?page=${page-1}`} class="px-3 py-1.5 border border-border rounded-lg text-sm text-muted hover:border-accent bg-white">Previous</a>}
          {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
            const p = i + 1;
            return <a href={`/${categorySlug}-jobs-in-${provinceSlug}?page=${p}`} class={`px-3 py-1.5 rounded-lg text-sm border ${p === page ? 'border-accent bg-accent text-white font-semibold' : 'border-border text-muted hover:border-accent bg-white'}`}>{p}</a>;
          })}
          {page < totalPages && <a href={`/${categorySlug}-jobs-in-${provinceSlug}?page=${page+1}`} class="px-3 py-1.5 border border-border rounded-lg text-sm text-muted hover:border-accent bg-white">Next</a>}
        </div>
      )}
    </div>
    <aside class="hidden lg:block"><Sidebar /></aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${category.name} Jobs in ${province}`,
    description: summaryText,
    url: `${Astro.url.origin}/${categorySlug}-jobs-in-${provinceSlug}`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: jobs.map((job, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${Astro.url.origin}/job/${job.slug}`,
      })),
    },
  })} />
</Layout>
