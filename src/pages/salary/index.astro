---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { SALARY_GUIDES } from '../../content/salary-guides';
import { SITE_URL } from '../../lib/constants';
---
<Layout title="Salary Guides South Africa — What Careers Pay" description="Understand indicative salary ranges, career progression and qualifications for common South African occupations." canonicalUrl={SITE_URL + '/salary'} adsEligible={true}>
<main class="shell"><header class="collection-intro"><span class="eyebrow">CAREER PLANNING / SALARIES</span><h1>Get a clearer picture<br />of what careers pay.</h1><p>Explore indicative pay ranges and how experience can shape your earnings. Actual salaries vary by employer, location and qualifications.</p></header><div class="editorial-grid" style="padding-bottom:65px">{SALARY_GUIDES.map(g => <GuideCard href={'/salary/' + g.slug} title={g.occupation} description={g.description} label="Salary guide" detail={g.averageSalary} />)}</div></main></Layout>
