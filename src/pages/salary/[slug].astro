---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import MonetizationSlot from '../../components/MonetizationSlot.astro';
import JobCard from '../../components/JobCard.astro';
import { SALARY_GUIDES } from '../../content/salary-guides';
import { getJobs } from '../../lib/pocketbase';
import { SITE_URL } from '../../lib/constants';
import { JOBS_PUBLIC } from '../../lib/featureFlags';

const { slug } = Astro.params;
const guide = SALARY_GUIDES.find(g => g.slug === slug);
if (!guide) return Astro.redirect('/404');

// Fetch related jobs (AdSense phase: no job listings shown)
let relatedJobs: any[] = [];
if (JOBS_PUBLIC && guide.categorySlug) {
  const result = await getJobs({ category: guide.categorySlug, perPage: 5 });
  relatedJobs = result.items;
}

// Related salary guides
const related = SALARY_GUIDES.filter(g => g.slug !== slug).slice(0, 4);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Salary Guides', item: `${SITE_URL}/salary` },
    { '@type': 'ListItem', position: 3, name: guide.h1 },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.h1,
  description: guide.description,
  dateModified: guide.updated,
  datePublished: guide.updated,
  author: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}/salary/${guide.slug}` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title={guide.title}
  description={guide.description}
  canonicalUrl={`${SITE_URL}/salary/${guide.slug}`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <main>
      <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gray-900">Home</a> &rsaquo;
        <a href="/salary" class="hover:text-gray-900">Salary Guides</a> &rsaquo;
        <span class="text-gray-900 font-medium">{guide.h1}</span>
      </nav>

      <header class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">{guide.h1}</h1>
        <p class="text-xs text-gray-500">Updated {guide.updated}</p>
      </header>

      <!-- Salary summary card -->
      <div class="bg-green-50 border border-green-200 rounded-md p-5 mb-6">
        <h2 class="text-sm font-semibold text-green-900 mb-3">Salary Summary — {guide.occupation}</h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <div><dt class="text-green-700 font-medium">Average</dt><dd class="text-green-900">{guide.averageSalary}</dd></div>
          <div><dt class="text-green-700 font-medium">Full Range</dt><dd class="text-green-900">{guide.salaryRange}</dd></div>
          <div><dt class="text-green-700 font-medium">Entry Level</dt><dd class="text-green-900">{guide.entryLevel}</dd></div>
          <div><dt class="text-green-700 font-medium">Mid Level</dt><dd class="text-green-900">{guide.midLevel}</dd></div>
          <div class="sm:col-span-2"><dt class="text-green-700 font-medium">Senior Level</dt><dd class="text-green-900">{guide.seniorLevel}</dd></div>
        </dl>
      </div>

      <MonetizationSlot zone="content-top" />

      <p class="text-gray-700 text-base leading-relaxed mb-6">{guide.intro}</p>

      <article class="prose prose-sm max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-green-800 prose-li:text-gray-700 mb-8" set:html={guide.body} />

      <MonetizationSlot zone="in-content" />

      <!-- Career path -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Career Path</h2>
        <div class="prose prose-sm max-w-none prose-li:text-gray-700" set:html={guide.careerPath} />
      </section>

      <!-- Requirements -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Requirements & Qualifications</h2>
        <div class="prose prose-sm max-w-none prose-li:text-gray-700" set:html={guide.requirements} />
      </section>

      <!-- FAQs -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {guide.faqs.map(faq => (
            <details class="border border-gray-200 rounded-md p-4 group">
              <summary class="font-medium text-sm text-gray-900 cursor-pointer group-open:mb-2">{faq.q}</summary>
              <p class="text-sm text-gray-600 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Related jobs -->
      {JOBS_PUBLIC && relatedJobs.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Related {guide.occupation} Jobs</h2>
          <div class="space-y-3">
            {relatedJobs.map(job => <JobCard job={job} />)}
          </div>
          {guide.categorySlug && (
            <a href={`/category/${guide.categorySlug}`} class="inline-block mt-3 text-sm text-green-800 hover:underline font-medium">View all {guide.categorySlug} jobs &rarr;</a>
          )}
        </section>
      )}

      <!-- Related salary guides -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">More Salary Guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {related.map(g => (
            <a href={`/salary/${g.slug}`} class="border border-gray-200 rounded-md p-4 hover:border-green-800 transition-colors">
              <h3 class="text-sm font-semibold text-gray-900 mb-1">{g.h1}</h3>
              <p class="text-xs text-green-800">{g.averageSalary}</p>
            </a>
          ))}
        </div>
      </section>

      <MonetizationSlot zone="content-bottom" />
    </main>

    <aside class="hidden lg:block">
      <Sidebar category={guide.categorySlug} />
    </aside>
  </div>
</Layout>
