---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { ARTICLES, RESOURCE_CATEGORIES, type ResourceCategoryId } from '../../content/resources';
import { SITE_URL } from '../../lib/constants';

// Handle category filter from query param
const requestedCategory = Astro.url.searchParams.get('category');
const categoryFilter = RESOURCE_CATEGORIES.some(c => c.id === requestedCategory) ? requestedCategory as ResourceCategoryId : null;
const requestedPage = Number(Astro.url.searchParams.get('page') || '1');
const perPage = 12;

// Filter and paginate articles
let filtered = [...ARTICLES];
if (categoryFilter && RESOURCE_CATEGORIES.some(c => c.id === categoryFilter)) {
  filtered = filtered.filter(a => a.category === categoryFilter);
}

const totalItems = filtered.length;
const totalPages = Math.ceil(totalItems / perPage);
const page = Number.isFinite(requestedPage) ? Math.min(Math.max(1, Math.floor(requestedPage)), Math.max(1, totalPages)) : 1;
const paged = filtered.slice((page - 1) * perPage, page * perPage);

const activeCategoryMeta = categoryFilter
  ? RESOURCE_CATEGORIES.find(c => c.id === categoryFilter)
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: `${SITE_URL}/resources` },
    ...(activeCategoryMeta ? [{ '@type': 'ListItem', position: 3, name: activeCategoryMeta.label }] : []),
  ],
};

const pageTitle = activeCategoryMeta
  ? `${activeCategoryMeta.label} — Career Resources`
  : 'Career & Education Resources — Free Guides for South Africans';
const pageDesc = activeCategoryMeta
  ? activeCategoryMeta.blurb
  : 'Free career and education guides for South Africans. CV writing, interview preparation, learnership info, NSFAS and TVET applications, salary guides and more.';
---
<Layout title={pageTitle} description={pageDesc} canonicalUrl={SITE_URL + '/resources' + (categoryFilter ? '?category=' + categoryFilter : '')}>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
<main class="shell">
<header class="collection-intro"><span class="eyebrow">PRACTICAL RESOURCES / MAKE YOUR NEXT MOVE</span><h1>{activeCategoryMeta ? activeCategoryMeta.label : 'A little preparation. A lot more confidence.'}</h1><p>{pageDesc}</p></header>
<nav aria-label="Resource categories" class="flex flex-wrap gap-2 mb-8"><a href="/resources" class="button-primary" style="padding:10px 16px" aria-current={!categoryFilter ? 'page' : undefined}>All guides</a>{RESOURCE_CATEGORIES.map(c => <a href={'/resources?category=' + c.id} class="rounded-full border border-gray-300 px-4 py-2 text-sm" aria-current={categoryFilter === c.id ? 'page' : undefined}>{c.label}</a>)}</nav>
<div class="editorial-grid">{paged.map(a => <GuideCard href={'/resources/' + a.slug} title={a.h1} description={a.description} label={RESOURCE_CATEGORIES.find(c => c.id === a.category)?.label || 'Resource'} readMins={a.readMins} />)}</div>
<nav aria-label="Pagination" class="flex justify-between py-12">{page > 1 && <a class="button-text" href={'/resources?page=' + (page - 1) + (categoryFilter ? '&category=' + categoryFilter : '')}>← Previous page</a>}<span class="text-sm">Page {page} of {Math.max(1,totalPages)}</span>{page < totalPages && <a class="button-text" href={'/resources?page=' + (page + 1) + (categoryFilter ? '&category=' + categoryFilter : '')}>Next page →</a>}</nav>
</main></Layout>
