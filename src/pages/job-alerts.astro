---
import Layout from '../layouts/Layout.astro';
import { PROVINCES } from '../lib/pocketbase';
import { generateToken } from '../lib/csrf';

const csrfToken = generateToken();
---

<Layout title="Job Alerts" description="Create Edubuzz job alerts." canonicalUrl={Astro.url.href}>
  <main class="form-page panel">
    <h1>Job alerts</h1>
    <p>We'll email you when new jobs matching your criteria are posted.</p>
    <form id="alerts-form">
      <input type="hidden" name="_csrf" value={csrfToken} />
      <label>Email<input class="form-field" type="email" name="email" required /></label>
      <label>Keyword<input class="form-field" name="keyword" /></label>
      <label>Province<select class="form-field" name="province"><option value="">Any province</option>{PROVINCES.map((p) => <option value={p}>{p}</option>)}</select></label>
      <p id="message" hidden></p>
      <button>Create alert</button>
    </form>
  </main>
</Layout>

<script>
  document.getElementById('alerts-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const res = await fetch('/api/alerts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
    const body = await res.json().catch(() => ({}));
    const msg = document.getElementById('message') as HTMLParagraphElement;
    msg.textContent = res.ok ? 'Alert created.' : (body.message || 'Could not create alert.');
    msg.hidden = false;
  });
</script>

<style>
  .form-page { max-width: 560px; margin: 1.5rem auto; }
  h1 { margin: 0 0 8px; font-size: 22px; font-weight: 600; letter-spacing: -0.3px; }
  p { color: #666; font-size: 13px; }
  form { display: grid; gap: 12px; margin-top: 16px; }
  label { display: grid; gap: 4px; color: #444; font-size: 13px; font-weight: 500; }
  button { border: 1px solid #2d6a4f; background: #2d6a4f; color: #fff; border-radius: 4px; padding: 10px; font-weight: 500; }
</style>
