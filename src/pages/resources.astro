---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Career Resources" description="Free guides on CV writing, interview preparation, labour law, and more for South African job seekers." canonicalUrl={Astro.url.href}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Career Resources</h1>
    <p class="text-sm text-gray-600 leading-relaxed mb-8">Free guides to help you land your next job in South Africa.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {[
        {title:'CV Writing Tips',desc:'Learn how to structure a professional CV that stands out to South African employers. From personal details to references, get the template right.'},
        {title:'Interview Preparation',desc:'Walk into any interview confident and prepared. Covers common questions, what to research about the company, and how to negotiate your offer.'},
        {title:'Labour Law Basics',desc:'Understand your rights under the Basic Conditions of Employment Act. Know what your contract should include and what notice periods apply.'},
        {title:'Understanding Your Payslip',desc:'Decode UIF, PAYE, and SDL deductions. Learn how to check that your employer is contributing correctly.'},
        {title:'Networking in South Africa',desc:'Build a professional network that opens doors. Tips for LinkedIn, industry events, and how to approach recruiters.'},
        {title:'Remote Work in SA',desc:'Find legitimate remote opportunities and set up a productive home office. Covers time zones, internet requirements, and avoiding scams.'},
      ].map(r => (
        <div class="bg-white border border-gray-200 rounded-md p-5">
          <h2 class="text-base font-semibold text-gray-900 mb-2">{r.title}</h2>
          <p class="text-sm text-gray-600 leading-relaxed mb-3">{r.desc}</p>
          <span class="text-xs bg-green-50 text-green-800 px-2 py-0.5 rounded-md font-medium">Free resource</span>
        </div>
      ))}
    </div>
  </div>
</Layout>
