---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import SmartAdSlot from '../components/SmartAdSlot.astro';
import { getFeaturedJobs, getJobs, PROVINCES } from '../lib/pocketbase';

const params = Astro.url.searchParams;
const page = Math.max(1, Number(params.get('page') || '1'));
const search = params.get('search')?.trim() || '';
const province = params.get('province') || '';
const job_type = params.get('type') || params.get('job_type') || '';
const perPage = 20;

const [{ items: jobs, totalItems, totalPages }, featuredJobs] = await Promise.all([
  getJobs({ page, perPage, search, province, job_type }),
  getFeaturedJobs(4),
]);

const pills = [
  { label: 'All', value: '' },
  { label: 'Full-time', value: 'Full-time' },
  { label: 'Part-time', value: 'Part-time' },
  { label: 'Contract', value: 'Contract' },
  { label: 'Remote', value: 'Remote' },
  { label: 'Internship', value: 'Internship' },
  { label: 'Learnership', value: 'Learnership' },
  { label: 'Graduate', value: 'Graduate Programme' },
];

function withParams(next: Record<string, string>) {
  const nextParams = new URLSearchParams();
  if (search) nextParams.set('search', search);
  if (province) nextParams.set('province', province);
  if (job_type) nextParams.set('type', job_type);
  Object.entries(next).forEach(([key, value]) => {
    if (value) nextParams.set(key, value);
    else nextParams.delete(key);
  });
  const query = nextParams.toString();
  return query ? `/?${query}` : '/';
}

function pageUrl(nextPage: number) {
  return withParams({ page: String(nextPage) });
}

const summaryParts = [];
if (search) summaryParts.push(`for '${search}'`);
if (province) summaryParts.push(`in ${province}`);
if (job_type) summaryParts.push(`(${job_type})`);
const resultSummary = summaryParts.length
  ? `Showing ${totalItems.toLocaleString('en-ZA')} jobs ${summaryParts.join(' ')}`
  : `Showing ${totalItems.toLocaleString('en-ZA')} active jobs`;
---

<Layout
  title="Find Jobs in South Africa"
  description="Browse thousands of verified job listings across all nine provinces — updated daily."
  canonicalUrl={Astro.url.origin + Astro.url.pathname}
  prevPage={page > 1 ? pageUrl(Math.max(1, page - 1)) : undefined}
  nextPage={page < totalPages ? pageUrl(page + 1) : undefined}
>
  <div slot="leaderboard">
    <div class="ad-slot-leaderboard" style="min-height:90px; max-width:728px; margin: 1rem auto; background:#f9fafb; border:1px solid #e5e7eb; display:flex; align-items:center; justify-content:center; display:none;">
      <span style="font-size:12px; color:#9ca3af;">Advertisement</span>
    </div>
  </div>

  <section class="hero">
    <div class="container">
      <h1>Find your next job in South Africa</h1>
      <p>Browse thousands of verified job listings across all nine provinces — updated daily.</p>

      <form class="search-bar" action="/" method="get">
        <input type="search" name="search" value={search} placeholder="Job title, keyword, or company" />
        <span class="divider" aria-hidden="true"></span>
        <select name="province">
          <option value="">All provinces</option>
          {PROVINCES.map((p) => <option value={p} selected={p === province}>{p}</option>)}
        </select>
        <button type="submit">Search</button>
      </form>

      <div class="filter-pills" aria-label="Job type filters">
        {pills.map((pill) => (
          <a class={pill.value === job_type ? 'active' : ''} href={withParams({ type: pill.value, page: '' })}>
            {pill.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="stats-row">
    <div class="container">
      <div class="stats-grid">
        <div class="stat">
          <span class="stat-number">10,000+</span>
          <span class="stat-label">Jobs Listed</span>
        </div>
        <div class="stat">
          <span class="stat-number">9</span>
          <span class="stat-label">Provinces Covered</span>
        </div>
        <div class="stat">
          <span class="stat-number">Free</span>
          <span class="stat-label">to Apply</span>
        </div>
      </div>
    </div>
  </div>

  <div class="page-grid">
    <main>
      <SmartAdSlot zone="strip" />

      {featuredJobs.length > 0 && (
        <section class="jobs-section">
          <div class="section-head">
            <h2>Featured jobs</h2>
            <a href="/jobs">View all &rarr;</a>
          </div>
          {featuredJobs.map((job) => <JobCard job={job} />)}
        </section>
      )}

      <section class="jobs-section">
        <div class="section-head">
          <h2>Latest jobs</h2>
          <a href="/jobs">View all &rarr;</a>
        </div>
        <p class="result-count">{resultSummary}</p>

        {jobs.length === 0 ? (
          <div class="empty-state">
            <h2>No jobs found</h2>
            <p>Try Government, Education, Health, IT, or Remote jobs.</p>
          </div>
        ) : (
          <>
            {jobs.map((job, index) => (
              <>
                <JobCard job={job} />
                {(index + 1) % 5 === 0 && index < jobs.length - 1 && <SmartAdSlot zone="infeed" />}
              </>
            ))}
          </>
        )}

        {totalPages > 1 && (
          <nav class="pagination" aria-label="Pagination">
            <a class={page <= 1 ? 'disabled' : ''} href={page > 1 ? pageUrl(page - 1) : '#'}>Previous</a>
            {Array.from({ length: Math.min(totalPages, 7) }, (_, index) => {
              const p = index + 1;
              return <a class={p === page ? 'active' : ''} href={pageUrl(p)}>{p}</a>;
            })}
            <a class={page >= totalPages ? 'disabled' : ''} href={page < totalPages ? pageUrl(page + 1) : '#'}>Next</a>
          </nav>
        )}
      </section>

      <section class="how-it-works">
        <h2>How it works</h2>
        <div class="steps-grid">
          <div class="step">
            <span class="step-number">1</span>
            <h3>Post a Job</h3>
            <p>Create a free listing in under 5 minutes. Describe the role, set requirements, and choose a category.</p>
          </div>
          <div class="step">
            <span class="step-number">2</span>
            <h3>Get Discovered</h3>
            <p>Your job appears in search results across all nine South African provinces. Job seekers apply directly.</p>
          </div>
          <div class="step">
            <span class="step-number">3</span>
            <h3>Hire Fast</h3>
            <p>Review applications, shortlist candidates, and fill your vacancy. Basic listings are free, featured from R299.</p>
          </div>
        </div>
        <div class="steps-cta">
          <a href="/post-job" class="primary-btn">Post a job</a>
          <a href="/pricing" class="secondary-btn">View pricing</a>
        </div>
      </section>
    </main>

    <aside>
      <Sidebar />
    </aside>
  </div>
</Layout>

<style>
  .hero {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    padding: 2.5rem 0;
  }

  .hero h1 {
    margin: 0;
    color: #111827;
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .hero p {
    margin: 0.375rem 0 1rem;
    color: #6b7280;
    font-size: 1rem;
  }

  .search-bar {
    display: flex;
    width: 100%;
    max-width: 820px;
    border: 2px solid #166534;
    border-radius: 0.375rem;
    overflow: hidden;
    background: #ffffff;
  }

  .search-bar input {
    flex: 1;
    min-width: 0;
    border: none;
    color: #111827;
    font-size: 0.875rem;
    outline: none;
    padding: 0.75rem 0.875rem;
  }

  .divider { width: 1px; background: #e5e7eb; margin: 0.5rem 0; flex-shrink: 0; }

  .search-bar select {
    width: 140px;
    flex-shrink: 0;
    background: #f9fafb;
    border: none;
    color: #6b7280;
    font-size: 0.875rem;
    outline: none;
    padding: 0 0.625rem;
  }

  .search-bar button {
    flex-shrink: 0;
    background: #166534;
    color: #ffffff;
    font-weight: 600;
    padding: 0 1.25rem;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 150ms ease;
  }

  .search-bar button:hover { background: #14532d; }

  .filter-pills {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.75rem;
    max-width: 100%;
    overflow-x: auto;
    padding-bottom: 0.125rem;
  }

  .filter-pills a {
    flex: 0 0 auto;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    color: #6b7280;
  }

  .filter-pills a.active {
    background: #f0fdf4;
    border-color: #166534;
    color: #166534;
  }

  .stats-row {
    background: #f0fdf4;
    padding: 1.5rem 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: #166534;
  }

  .stat-label {
    display: block;
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .page-grid {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 1rem;
    padding: 0 1.5rem;
    margin: 1.5rem auto;
    max-width: 1100px;
  }

  .jobs-section { margin-bottom: 1.5rem; }

  .result-count {
    margin: -0.125rem 0 0.625rem;
    color: #6b7280;
    font-size: 0.875rem;
  }

  .empty-state {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    padding: 2rem;
    text-align: center;
  }

  .empty-state h2 { margin: 0 0 0.25rem; font-size: 0.875rem; font-weight: 600; }
  .empty-state p { margin: 0; color: #6b7280; font-size: 0.875rem; }

  .pagination {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  .pagination a {
    border: 1px solid #e5e7eb;
    background: #ffffff;
    border-radius: 0.375rem;
    padding: 0.3125rem 0.6875rem;
    font-size: 0.75rem;
    color: #6b7280;
  }

  .pagination a.active {
    background: #166534;
    color: #ffffff;
    border-color: #166534;
  }

  .pagination a.disabled { color: #9ca3af; pointer-events: none; }

  .how-it-works {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    padding: 2rem;
    margin-top: 0.5rem;
  }

  .how-it-works h2 {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: #166534;
    color: #ffffff;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .step h3 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 700;
    color: #111827;
  }

  .step p {
    margin: 0;
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.625;
  }

  .steps-cta {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 820px) {
    .page-grid { grid-template-columns: 1fr; padding: 0 1rem; }
    .steps-grid { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 560px) {
    .search-bar { flex-wrap: wrap; }
    .search-bar input { flex: 0 0 100%; border-bottom: 1px solid #e5e7eb; }
    .divider { display: none; }
    .search-bar select { flex: 1; width: auto; min-width: 0; height: 42px; }
    .search-bar button { height: 42px; }
    .steps-cta { flex-direction: column; }
  }
</style>
