---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import SmartAdSlot from '../components/SmartAdSlot.astro';
import { getFeaturedJobs, getJobs, PROVINCES } from '../lib/pocketbase';

const params = Astro.url.searchParams;
const page = Math.max(1, Number(params.get('page') || '1'));
const search = params.get('search')?.trim() || '';
const province = params.get('province') || '';
const job_type = params.get('type') || params.get('job_type') || '';

const [{ items: jobs, totalItems, totalPages }, featuredJobs] = await Promise.all([
  getJobs({ page, perPage: 20, search, province, job_type }),
  getFeaturedJobs(4),
]);

const pills = [
  { label: 'All', value: '' },
  { label: 'Full-time', value: 'Full-time' }, { label: 'Part-time', value: 'Part-time' },
  { label: 'Contract', value: 'Contract' }, { label: 'Remote', value: 'Remote' },
  { label: 'Internship', value: 'Internship' }, { label: 'Learnership', value: 'Learnership' },
  { label: 'Graduate', value: 'Graduate Programme' },
];

function withParams(next: Record<string, string>) {
  const p = new URLSearchParams();
  if (search) p.set('search', search);
  if (province) p.set('province', province);
  if (job_type) p.set('type', job_type);
  Object.entries(next).forEach(([k, v]) => v ? p.set(k, v) : p.delete(k));
  const q = p.toString();
  return q ? `/?${q}` : '/';
}
function pageUrl(n: number) { return withParams({ page: String(n) }); }
const resultSummary = `Showing ${totalItems.toLocaleString('en-ZA')} active jobs`;
---

<Layout title="Find Jobs in South Africa" description="Browse thousands of verified job listings across all nine provinces — updated daily." canonicalUrl={Astro.url.origin + Astro.url.pathname}>
  <div class="bg-white border-b border-gray-200 py-10">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Find your next job in South Africa</h1>
      <p class="text-sm text-gray-600 leading-relaxed mb-6">Browse thousands of verified job listings across all nine provinces — updated daily.</p>
      <form class="flex max-w-2xl border-2 border-green-800 rounded-md overflow-hidden bg-white" action="/" method="get">
        <input type="search" name="search" value={search} placeholder="Job title, keyword, or company" class="flex-1 border-none px-4 py-2.5 text-sm text-gray-900 outline-none" />
        <select name="province" class="w-36 border-l border-gray-200 bg-gray-50 text-sm text-gray-600 outline-none px-2">
          <option value="">All provinces</option>
          {PROVINCES.map(p => <option value={p} selected={p === province}>{p}</option>)}
        </select>
        <button type="submit" class="bg-green-800 text-white text-sm font-medium px-5 hover:bg-green-900 transition-colors">Search</button>
      </form>
      <div class="flex gap-2 mt-3 flex-wrap">
        {pills.map(pill => (
          <a href={withParams({ type: pill.value, page: '' })} class={`inline-block text-sm px-4 py-1.5 rounded-md transition-colors ${pill.value === job_type ? 'bg-green-800 text-white' : 'border border-gray-200 text-gray-900 hover:border-green-800 hover:text-green-800'}`}>{pill.label}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-8">
      <div>
        <SmartAdSlot zone="strip" />
        {featuredJobs.length > 0 && (
          <section class="mb-6">
            <div class="flex justify-between items-center mb-3">
              <h2 class="text-xl font-semibold text-gray-900">Featured jobs</h2>
              <a href="/jobs" class="text-sm text-green-800 hover:underline font-medium">View all</a>
            </div>
            {featuredJobs.map(j => <JobCard job={j} />)}
          </section>
        )}
        <section>
          <div class="flex justify-between items-center mb-3">
            <h2 class="text-xl font-semibold text-gray-900">Latest jobs</h2>
            <a href="/jobs" class="text-sm text-green-800 hover:underline font-medium">View all</a>
          </div>
          <p class="text-xs text-gray-500 mb-3">{resultSummary}</p>
          {jobs.length === 0 ? (
            <div class="bg-white border border-gray-200 rounded-md p-8 text-center">
              <p class="text-sm text-gray-600">No jobs found. Try adjusting your search or browse by category.</p>
            </div>
          ) : (
            jobs.map(j => <JobCard job={j} />)
          )}
          {totalPages > 1 && (
            <div class="flex gap-1 mt-4 flex-wrap">
              {page > 1 && <a href={pageUrl(page-1)} class="border border-gray-200 rounded-md px-3 py-1.5 text-sm text-green-800 hover:border-green-800 hover:text-green-900">Previous</a>}
              {Array.from({length: Math.min(totalPages,7)}, (_,i) => i+1).map(p => <a href={pageUrl(p)} class={`rounded-md px-3 py-1.5 text-sm ${p===page ? 'bg-green-800 text-white' : 'border border-gray-200 text-green-800 hover:border-green-800 hover:text-green-900'}`}>{p}</a>)}
              {page < totalPages && <a href={pageUrl(page+1)} class="border border-gray-200 rounded-md px-3 py-1.5 text-sm text-green-800 hover:border-green-800 hover:text-green-900">Next</a>}
            </div>
          )}
        </section>
      </div>
      <aside><Sidebar /></aside>
    </div>
  </div>
</Layout>
