---
import Layout from '../layouts/Layout.astro';
import GuideCard from '../components/GuideCard.astro';
import { EDUCATION_GUIDES } from '../content/education-guides';
import { CAREER_GUIDES } from '../content/career-guides';
import { ARTICLES } from '../content/resources';
import { COMPANY_GUIDES } from '../content/company-guides';
import { SITE_URL } from '../lib/constants';
const pathways = [
  { number: '01', title: 'Find your study path', text: 'University, TVET or learning a trade. Understand your options.', href: '/education', label: 'Explore education' },
  { number: '02', title: 'Discover your career', text: 'Get to know the work, the training and the route to get there.', href: '/careers', label: 'Explore careers' },
  { number: '03', title: 'Make your next move', text: 'Prepare your CV, build confidence and get application-ready.', href: '/resources', label: 'Explore resources' },
];
---
<Layout title="Your next chapter starts here" description="Explore South African study options, career pathways and practical application guides with Edubuzz." canonicalUrl={SITE_URL + '/'} adsEligible={true}>
  <main>
    <section class="home-hero shell">
      <div class="home-hero__copy"><span class="eyebrow"><span class="status-dot"></span> FOR YOUR NEXT CHAPTER</span><h1>A future that<br />feels like <em>you.</em></h1><p>Big dreams. Real questions. Find your way through studying, choosing a career and taking your first step into working life.</p><div class="hero-actions"><a class="button-primary" href="/start">Find your path <span>↗</span></a><a class="button-text" href="/careers">Explore careers <span>→</span></a></div><div class="hero-note"><span class="mini-mark">✦</span><span>Made for South Africa.<br /><strong>Practical guidance. Possibility for everyone.</strong></span></div></div>
      <div class="home-hero__visual"><img src="/images/edubuzz-campus.webp" srcset="/images/edubuzz-campus-small.webp 640w, /images/edubuzz-campus.webp 1200w" sizes="(max-width:640px) calc(100vw - 50px), (max-width:1200px) 45vw, 540px" alt="Illustrative scene of young adults collaborating around a laptop on campus" width="1200" height="800" fetchpriority="high" /><div class="photo-caption"><span>THE NEXT STEP IS YOURS</span><strong>Learn. Explore. Become.</strong></div><div class="hero-sticker" aria-hidden="true">YOUR<br />FUTURE<br /><span>↗</span></div></div>
    </section>
    <div class="topic-strip"><div class="shell"><span>A LITTLE CLARITY GOES A LONG WAY</span><a href="/education/nsfas-funding-explained">Funding your studies ↗</a><a href="/education/what-to-do-after-matric">Life after matric ↗</a><a href="/salary">Understanding salaries ↗</a></div></div>
    <section class="shell section-space"><div class="section-heading"><div><span class="eyebrow">START WHERE YOU ARE</span><h2>What’s your next step?</h2></div><p>You don’t need to have it all figured out.<br /> Just a place to start.</p></div><div class="pathway-grid">{pathways.map(p => <a class="pathway-card" href={p.href}><span class="pathway-number">{p.number}</span><h3>{p.title}</h3><p>{p.text}</p><span class="pathway-link">{p.label}<span>↗</span></span></a>)}</div></section>
    <section class="education-band"><div class="shell section-space"><div class="section-heading"><div><span class="eyebrow">LEARNING OPENS DOORS</span><h2>More than one way forward.</h2></div><a class="button-text" href="/education">All education guides →</a></div><div class="editorial-grid">{EDUCATION_GUIDES.slice(0,3).map(g => <GuideCard href={'/education/' + g.slug} title={g.h1} description={g.description} label="Education" readMins={g.readMins} />)}</div></div></section>
    <section class="shell section-space"><div class="section-heading"><div><span class="eyebrow">TURN CURIOSITY INTO A CAREER</span><h2>Picture yourself doing this.</h2></div><a class="button-text" href="/careers">All career guides →</a></div><div class="editorial-grid">{CAREER_GUIDES.filter(g => g.featured).slice(0,3).map(g => <GuideCard href={'/careers/' + g.slug} title={g.h1} description={g.description} label="Career pathways" readMins={g.readMins} />)}</div></section>
    <section class="shell"><div class="feature-banner"><div><span class="eyebrow">AFTER MATRIC, WHAT’S NEXT?</span><h2>Your options are bigger<br />than you think.</h2><p>A degree is one route. Explore college, apprenticeships and other ways to build your future.</p><a class="button-primary" href="/education/what-to-do-after-matric">Explore your options ↗</a></div><span class="banner-art" aria-hidden="true">↗</span></div></section>
    <section class="shell section-space"><div class="section-heading"><div><span class="eyebrow">A LITTLE PREPARATION. A LOT MORE CONFIDENCE.</span><h2>Ready for your next move.</h2></div><a class="button-text" href="/resources">All practical guides →</a></div><div class="editorial-grid">{ARTICLES.filter(a => a.popular).slice(0,3).map(a => <GuideCard href={'/resources/' + a.slug} title={a.h1} description={a.description} label="Practical resources" readMins={a.readMins} />)}</div></section>
    <section class="shell employer-section"><span class="eyebrow">GET TO KNOW THE WORKING WORLD</span><div class="section-heading"><h2>Meet your possible next workplace.</h2><a class="button-text" href="/companies">Employer guides →</a></div><div class="employer-grid">{COMPANY_GUIDES.slice(0,6).map(g => <a href={'/company/' + g.slug}><strong>{g.name}</strong><span>{g.sector} ↗</span></a>)}</div></section>
  </main>
</Layout>
