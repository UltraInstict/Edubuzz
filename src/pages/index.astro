---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import SmartAdSlot from '../components/SmartAdSlot.astro';
import { getFeaturedJobs, getJobs, PROVINCES } from '../lib/pocketbase';

const params = Astro.url.searchParams;
const page = Math.max(1, Number(params.get('page') || '1'));
const search = params.get('search')?.trim() || '';
const province = params.get('province') || '';
const job_type = params.get('type') || params.get('job_type') || '';
const perPage = 20;

const [{ items: jobs, totalItems, totalPages }, featuredJobs] = await Promise.all([
  getJobs({ page, perPage, search, province, job_type }),
  getFeaturedJobs(4),
]);

const pills = [
  { label: 'All', value: '' },
  { label: 'Full-time', value: 'Full-time' },
  { label: 'Part-time', value: 'Part-time' },
  { label: 'Contract', value: 'Contract' },
  { label: 'Remote', value: 'Remote' },
  { label: 'Internship', value: 'Internship' },
  { label: 'Learnership', value: 'Learnership' },
  { label: 'Graduate', value: 'Graduate Programme' },
];

function withParams(next: Record<string, string>) {
  const nextParams = new URLSearchParams();
  if (search) nextParams.set('search', search);
  if (province) nextParams.set('province', province);
  if (job_type) nextParams.set('type', job_type);
  Object.entries(next).forEach(([key, value]) => {
    if (value) nextParams.set(key, value);
    else nextParams.delete(key);
  });
  const query = nextParams.toString();
  return query ? `/?${query}` : '/';
}

function pageUrl(nextPage: number) {
  return withParams({ page: String(nextPage) });
}

const summaryParts = [];
if (search) summaryParts.push(`for '${search}'`);
if (province) summaryParts.push(`in ${province}`);
if (job_type) summaryParts.push(`(${job_type})`);
const resultSummary = summaryParts.length
  ? `Showing ${totalItems.toLocaleString('en-ZA')} jobs ${summaryParts.join(' ')}`
  : `Showing ${totalItems.toLocaleString('en-ZA')} active jobs`;
---

<Layout
  title="Find Jobs in South Africa"
  description="Search thousands of jobs across government, health, IT, education and more."
  canonicalUrl={Astro.url.origin + Astro.url.pathname}
  prevPage={page > 1 ? pageUrl(Math.max(1, page - 1)) : undefined}
  nextPage={page < totalPages ? pageUrl(page + 1) : undefined}
>
  <section class="hero">
    <div class="container">
      <h1>Find your next job in South Africa</h1>
      <p>Search thousands of jobs across government, health, IT, education and more.</p>

      <form class="search-bar" action="/" method="get">
        <input type="search" name="search" value={search} placeholder="Job title, keyword, or company" />
        <span class="divider" aria-hidden="true"></span>
        <select name="province">
          <option value="">All provinces</option>
          {PROVINCES.map((p) => <option value={p} selected={p === province}>{p}</option>)}
        </select>
        <button type="submit">Search</button>
      </form>

      <div class="filter-pills" aria-label="Job type filters">
        {pills.map((pill) => (
          <a class={pill.value === job_type ? 'active' : ''} href={withParams({ type: pill.value, page: '' })}>
            {pill.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="page-grid">
    <main>
      <SmartAdSlot zone="strip" />

      {featuredJobs.length > 0 && (
        <section class="jobs-section">
          <div class="section-head">
            <h2>Featured jobs</h2>
            <a href="/jobs">View all -></a>
          </div>
          {featuredJobs.map((job) => <JobCard job={job} />)}
        </section>
      )}

      <section class="jobs-section">
        <div class="section-head">
          <h2>Latest jobs</h2>
          <a href="/jobs">View all -></a>
        </div>
        <p class="result-count">{resultSummary}</p>

        {jobs.length === 0 ? (
          <div class="empty-state">
            <h2>No jobs found</h2>
            <p>Try Government, Education, Health, IT, or Remote jobs.</p>
          </div>
        ) : (
          <>
            {jobs.map((job, index) => (
              <>
                <JobCard job={job} />
                {(index + 1) % 5 === 0 && index < jobs.length - 1 && <SmartAdSlot zone="infeed" />}
              </>
            ))}
          </>
        )}

        {totalPages > 1 && (
          <nav class="pagination" aria-label="Pagination">
            <a class={page <= 1 ? 'disabled' : ''} href={page > 1 ? pageUrl(page - 1) : '#'}>Previous</a>
            {Array.from({ length: Math.min(totalPages, 7) }, (_, index) => {
              const p = index + 1;
              return <a class={p === page ? 'active' : ''} href={pageUrl(p)}>{p}</a>;
            })}
            <a class={page >= totalPages ? 'disabled' : ''} href={page < totalPages ? pageUrl(page + 1) : '#'}>Next</a>
          </nav>
        )}
      </section>
    </main>

    <aside>
      <Sidebar />
    </aside>
  </div>
</Layout>

<style>
  .hero {
    background: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    padding: 2rem 0;
  }

  .hero h1 {
    margin: 0;
    color: #1a1a1a;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.3px;
    line-height: 1.3;
  }

  .hero p {
    margin: 6px 0 16px;
    color: #666666;
    font-size: 13px;
  }

  .search-bar {
    display: flex;
    width: 100%;
    max-width: 820px;
    border: 2px solid #2d6a4f;
    border-radius: 6px;
    overflow: hidden;
    background: #ffffff;
  }

  .search-bar input {
    flex: 1;
    min-width: 0;
    border: none;
    color: #1a1a1a;
    font-size: 14px;
    outline: none;
    padding: 12px 14px;
  }

  .divider {
    width: 1px;
    background: #e0e0e0;
    margin: 8px 0;
    flex-shrink: 0;
  }

  .search-bar select {
    width: 140px;
    flex-shrink: 0;
    background: #f9f9f9;
    border: none;
    color: #444444;
    font-size: 13px;
    outline: none;
    padding: 0 10px;
  }

  .search-bar button {
    flex-shrink: 0;
    background: #2d6a4f;
    color: #ffffff;
    font-weight: 600;
    padding: 0 20px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .search-bar button:hover {
    background: #245a42;
  }

  .filter-pills {
    display: flex;
    gap: 6px;
    margin-top: 12px;
    max-width: 100%;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .filter-pills a {
    flex: 0 0 auto;
    background: #f3f2ee;
    border: 1px solid #dddddd;
    border-radius: 20px;
    padding: 4px 11px;
    font-size: 12px;
    color: #444444;
  }

  .filter-pills a.active {
    background: #e8f4f0;
    border-color: #2d6a4f;
    color: #2d6a4f;
  }

  .page-grid {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 16px;
    padding: 0 1.5rem;
    margin: 1.5rem auto;
    max-width: 1100px;
  }

  .jobs-section {
    margin-bottom: 1.5rem;
  }

  .result-count {
    margin: -2px 0 10px;
    color: #666666;
    font-size: 13px;
  }

  .empty-state {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 2rem;
    text-align: center;
  }

  .empty-state h2 {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 600;
  }

  .empty-state p {
    margin: 0;
    color: #666666;
    font-size: 13px;
  }

  .pagination {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }

  .pagination a {
    border: 1px solid #e0e0e0;
    background: #ffffff;
    border-radius: 4px;
    padding: 5px 11px;
    font-size: 12px;
    color: #444444;
  }

  .pagination a.active {
    background: #2d6a4f;
    color: #ffffff;
    border-color: #2d6a4f;
  }

  .pagination a.disabled {
    color: #888888;
    pointer-events: none;
  }

  @media (max-width: 820px) {
    .page-grid {
      grid-template-columns: 1fr;
      padding: 0 1rem;
    }
  }

  @media (max-width: 560px) {
    .search-bar {
      flex-wrap: wrap;
    }

    .search-bar input {
      flex: 0 0 100%;
      border-bottom: 1px solid #e0e0e0;
    }

    .divider {
      display: none;
    }

    .search-bar select {
      flex: 1;
      width: auto;
      min-width: 0;
      height: 42px;
    }

    .search-bar button {
      height: 42px;
    }
  }
</style>
