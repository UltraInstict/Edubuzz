---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { listAdminEmployers } from '../../services/jobService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const employers = await listAdminEmployers();
---

<Layout title="Admin Employers" description="Manage employers." canonicalUrl={Astro.url.href}>
  <main class="max-w-6xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-3">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Employers</h1>
      <AdminNav current="employers" />
    </header>

    <p class="text-sm text-gray-500 mb-4">{employers.length} employer{employers.length !== 1 ? 's' : ''} registered</p>

    <div class="overflow-auto bg-white border border-gray-200 rounded-md">
      <table class="w-full border-collapse text-xs">
        <thead>
          <tr>
            <th class="px-2 py-2 font-semibold text-gray-900 text-left">Company</th>
            <th class="px-2 py-2 font-semibold text-gray-900 text-left">Email</th>
            <th class="px-2 py-2 font-semibold text-gray-900 text-left">Plan</th>
            <th class="px-2 py-2 font-semibold text-gray-900 text-left">Verified</th>
            <th class="px-2 py-2 font-semibold text-gray-900 text-left">Registered</th>
            <th class="px-2 py-2 font-semibold text-gray-900 text-left">Actions</th>
          </tr>
        </thead>
        <tbody>
          {employers.length === 0 && (
            <tr><td colspan="6" class="py-12 text-center text-gray-500 text-sm">No employers registered yet.</td></tr>
          )}
          {employers.map((employer: any) => (
            <tr class="border-b border-gray-200">
              <td class="px-2 py-2">{employer.company_name || employer.name}</td>
              <td class="px-2 py-2">{employer.contact_email || employer.email}</td>
              <td class="px-2 py-2">
                <span class={employer.plan === 'featured'
                  ? 'px-2 py-0.5 rounded-full text-xs bg-amber-50 text-amber-800'
                  : 'px-2 py-0.5 rounded-full text-xs bg-gray-100 text-gray-600'}>
                  {employer.plan || 'free'}
                </span>
              </td>
              <td class="px-2 py-2">
                {employer.verified
                  ? <span class="text-green-800 text-sm font-medium">&#10003; Verified</span>
                  : <span class="text-gray-500 text-sm">&mdash;</span>}
              </td>
              <td class="px-2 py-2 text-sm text-gray-500">
                {new Date(employer.created).toLocaleDateString('en-ZA')}
              </td>
              <td class="px-2 py-2">
                <div class="flex gap-1">
                  <button data-id={employer.id} data-verified={String(!employer.verified)}
                    class={employer.verified
                      ? 'px-3 py-1 text-xs rounded border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors'
                      : 'px-3 py-1 text-xs rounded bg-green-800 text-white hover:bg-green-900 transition-colors'}>
                    {employer.verified ? 'Unverify' : 'Verify'}
                  </button>
                  <button data-id={employer.id} data-blocked={String(!employer.blocked)}
                    class={employer.blocked
                      ? 'px-3 py-1 text-xs rounded bg-red-600 text-white hover:bg-red-700 transition-colors'
                      : 'px-3 py-1 text-xs rounded border border-red-300 text-red-600 hover:bg-red-50 transition-colors'}>
                    {employer.blocked ? 'Unblock' : 'Block'}
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll('[data-verified]').forEach((button) => button.addEventListener('click', async () => {
    const el = button as HTMLButtonElement;
    await fetch('/api/admin/update-employer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: el.dataset.id, verified: el.dataset.verified === 'true' }) });
    location.reload();
  }));
  document.querySelectorAll('[data-blocked]').forEach((button) => button.addEventListener('click', async () => {
    const el = button as HTMLButtonElement;
    await fetch('/api/admin/update-employer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: el.dataset.id, blocked: el.dataset.blocked === 'true' }) });
    location.reload();
  }));
</script>
