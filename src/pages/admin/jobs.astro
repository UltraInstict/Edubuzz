---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { listAdminJobsFiltered } from '../../services/jobService';
import { PROVINCES } from '../../lib/pocketbase';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const params = Astro.url.searchParams;
const status = params.get('status') || '';
const province = params.get('province') || '';
const source = params.get('source') || '';

const jobs = await listAdminJobsFiltered({ status, province, source, page: 1, perPage: 50 });

const now = Date.now();
const SEVEN_DAYS = 7 * 86400000;

function isJobExpired(active: boolean, expires?: string): boolean {
  return Boolean(expires && new Date(expires).getTime() < now);
}

function statusBadge(active: boolean, expires?: string) {
  if (isJobExpired(active, expires)) return { cls: 'bg-gray-100 text-gray-500', label: 'expired' };
  if (active) return { cls: 'bg-green-50 text-green-800', label: 'active' };
  return { cls: 'bg-amber-50 text-amber-800', label: 'pending' };
}

function rowBg(active: boolean, expires?: string) {
  if (isJobExpired(active, expires)) return 'bg-gray-50 text-gray-500';
  if (!active) return 'bg-amber-50';
  return '';
}

function formatDate(iso?: string): string {
  if (!iso) return '\u2014';
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '\u2014';
  return `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
}

function expiresClass(expires?: string): string {
  if (!expires) return 'text-gray-500';
  const t = new Date(expires).getTime();
  if (isNaN(t)) return 'text-gray-500';
  if (t < now) return 'text-red-700 font-medium';
  if (t - now < SEVEN_DAYS) return 'text-orange-700 font-medium';
  return 'text-green-700 font-medium';
}
---

<Layout title="Admin Jobs" description="Manage Edubuzz jobs." canonicalUrl={Astro.url.href}>
  <main class="max-w-7xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-3">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Jobs</h1>
      <AdminNav current="jobs" />
    </header>

    <form class="flex gap-2 flex-wrap mb-2">
      <select name="status" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm">
        <option value="">All statuses</option>
        {['pending','active','expired'].map((s) => <option value={s} selected={s === status}>{s}</option>)}
      </select>
      <select name="province" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm">
        <option value="">All provinces</option>
        {PROVINCES.map((p) => <option value={p} selected={p === province}>{p}</option>)}
      </select>
      <select name="source" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm">
        <option value="">All sources</option>
        {['manual','import','xml_feed','csv_import','json_import'].map((s) => <option value={s} selected={s === source}>{s}</option>)}
      </select>
      <button class="bg-green-800 text-white text-sm font-medium px-4 py-1.5 rounded-md hover:bg-green-900 transition-colors">Filter</button>
    </form>

    <p class="text-sm text-gray-500 mb-2">{jobs.totalItems} job{jobs.totalItems !== 1 ? 's' : ''} found</p>

    <div class="overflow-auto bg-white border border-gray-200 rounded-md">
      <table class="w-full border-collapse text-xs">
        <thead>
          <tr>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Title</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Company</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Province</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Status</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Source</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Featured</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Views</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Created</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Expires</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap">Actions</th>
          </tr>
        </thead>
        <tbody>
          {jobs.items.length === 0 && (
            <tr>
              <td colspan="10" class="py-12 px-4 text-center text-gray-500 text-sm">No jobs found.</td>
            </tr>
          )}
          {jobs.items.map((job: any) => {
            const badge = statusBadge(job.active, job.expires);
            const expired = isJobExpired(job.active, job.expires);
            return (
              <tr class={`border-b border-gray-200 ${rowBg(job.active, job.expires)}`}>
                <td class="px-2.5 py-2.5 max-w-[200px] truncate">{job.title}</td>
                <td class="px-2.5 py-2.5">{job.company}</td>
                <td class="px-2.5 py-2.5">{job.province}</td>
                <td class="px-2.5 py-2.5"><span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium ${badge.cls}`}>{badge.label}</span></td>
                <td class="px-2.5 py-2.5">{job.source}</td>
                <td class="px-2.5 py-2.5">{job.featured ? 'yes' : 'no'}</td>
                <td class="px-2.5 py-2.5 text-gray-500 text-xs">{job.views || 0}</td>
                <td class="px-2.5 py-2.5 text-gray-500 text-xs">{formatDate(job.created)}</td>
                <td class={`px-2.5 py-2.5 text-xs ${expiresClass(job.expires)}`}>{formatDate(job.expires)}</td>
                <td class="px-2.5 py-2.5">
                  <div class="flex gap-1 flex-wrap">
                    <a href={`/job/${job.slug}`} target="_blank" class="px-2 py-0.5 text-xs rounded border border-gray-200 text-gray-600 bg-white hover:bg-gray-50 transition-colors">View</a>
                    {!expired && job.active === false && (
                      <button data-id={job.id} data-action="approve" class="px-2 py-0.5 text-xs font-medium rounded bg-green-800 text-white hover:bg-green-900 transition-colors">Approve</button>
                    )}
                    {job.active && (
                      <button data-id={job.id} data-action="reject" class="px-2 py-0.5 text-xs rounded bg-white text-orange-700 border border-orange-300 hover:bg-orange-50 transition-colors">Reject</button>
                    )}
                    <button data-id={job.id} data-action="toggle_featured"
                      class={job.featured
                        ? 'px-2 py-0.5 text-xs font-medium rounded bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100 transition-colors'
                        : 'px-2 py-0.5 text-xs rounded bg-white text-green-800 border border-green-800 hover:bg-green-50 transition-colors'}>
                      {job.featured ? 'Unfeature' : 'Feature'}
                    </button>
                    {expired && (
                      <button data-id={job.id} data-action="repost" class="px-2 py-0.5 text-xs font-medium rounded bg-blue-600 text-white hover:bg-blue-700 transition-colors">Repost</button>
                    )}
                    <button data-id={job.id} data-action="delete" data-title={job.title} class="px-2 py-0.5 text-xs font-medium rounded bg-red-600 text-white hover:bg-red-700 transition-colors">Delete</button>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </main>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((button) => {
    button.addEventListener('click', async () => {
      const action = button.dataset.action;
      const id = button.dataset.id;
      if (!action || !id) return;

      if (action === 'delete') {
        const title = button.dataset.title || 'this job';
        const ok = confirm(`Are you sure you want to permanently delete "${title}"? This cannot be undone.`);
        if (!ok) return;
      }

      const original = button.textContent;
      button.disabled = true;
      button.textContent = '\u2026';

      try {
        const res = await fetch('/api/admin/job-action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ jobId: id, action })
        });
        const body = await res.json().catch(() => ({}));

        if (res.ok && body.success !== false) {
          if (action === 'delete') {
            const row = button.closest('tr');
            if (row) row.remove();
          } else {
            location.reload();
          }
        } else {
          alert(body.error || `Action failed: ${action}`);
          button.disabled = false;
          button.textContent = original;
        }
      } catch {
        alert('Network error. Please try again.');
        button.disabled = false;
        button.textContent = original;
      }
    });
  });
</script>

<style>
  button:disabled { opacity: 0.5; cursor: wait; }
  @media (max-width: 860px) {
    header { flex-direction: column; align-items: flex-start; }
  }
</style>
