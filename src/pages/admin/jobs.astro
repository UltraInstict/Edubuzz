---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { getAdminJobsSummary, listEmployerNames, listJobSourceValues } from '../../services/jobService';
import { PROVINCES } from '../../lib/pocketbase';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const params = Astro.url.searchParams;
const initial = {
  status: params.get('status') || '',
  province: params.get('province') || '',
  source: params.get('source') || '',
  featured: params.get('featured') || '',
  imported: params.get('imported') || '',
  company: params.get('company') || '',
  search: params.get('search') || '',
  sort: params.get('sort') || 'newest',
};

// SSR the option lists + summary once; the table rows load client-side (instant filtering).
const [summary, employerNames, sourceValues] = await Promise.all([
  getAdminJobsSummary().catch(() => ({ total: 0, featured: 0, active: 0, expired: 0, imported: 0, manual: 0 })),
  listEmployerNames().catch(() => [] as string[]),
  listJobSourceValues().catch(() => [] as string[]),
]);

const SORT_OPTIONS: Array<[string, string]> = [
  ['newest', 'Newest'],
  ['oldest', 'Oldest'],
  ['featured_first', 'Featured First'],
  ['featured_last', 'Featured Last'],
  ['employer', 'Employer'],
  ['province', 'Province'],
  ['source', 'Source'],
];

// Data-driven employer quick chips: show preferred names only if they exist in the data.
const CHIP_EMPLOYER_PREF = ['Standard Bank Group', 'Deloitte', 'takealot.com', 'OUTsurance', 'Life Healthcare'];
const employerChips = CHIP_EMPLOYER_PREF.filter((n) => employerNames.includes(n));
---

<Layout title="Admin Jobs" description="Manage Edubuzz jobs." canonicalUrl={Astro.url.href}>
  <main class="max-w-7xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-3">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Jobs</h1>
      <AdminNav current="jobs" />
    </header>

    <!-- Summary bar -->
    <div id="summary-bar" class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm mb-3">
      <span class="font-bold text-gray-900"><span id="sum-total">{summary.total}</span> Jobs</span>
      <span class="text-amber-700">Featured: <span id="sum-featured">{summary.featured}</span></span>
      <span class="text-green-700">Active: <span id="sum-active">{summary.active}</span></span>
      <span class="text-gray-500">Expired: <span id="sum-expired">{summary.expired}</span></span>
      <span class="text-blue-700">Imported: <span id="sum-imported">{summary.imported}</span></span>
      <span class="text-gray-600">Manual: <span id="sum-manual">{summary.manual}</span></span>
    </div>

    <!-- Quick filter chips -->
    <div id="chips" class="flex flex-wrap gap-1.5 mb-3">
      <button class="chip" data-reset>All</button>
      <button class="chip" data-featured="yes">⭐ Featured</button>
      <button class="chip" data-imported="yes">Imported</button>
      <button class="chip" data-imported="no">Manual</button>
      <button class="chip" data-status="active">Active</button>
      <button class="chip" data-status="expired">Expired</button>
      {employerChips.map((n) => <button class="chip" data-company={n}>{n}</button>)}
    </div>

    <!-- Filters + search -->
    <div class="flex gap-2 flex-wrap mb-3 items-center">
      <input id="f-search" type="search" placeholder="Search title, company, slug, source…" value={initial.search}
        class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm min-w-[240px] flex-1" />
      <select id="f-featured" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm">
        <option value="">All (Featured)</option>
        <option value="yes" selected={initial.featured === 'yes'}>Featured</option>
        <option value="no" selected={initial.featured === 'no'}>Not Featured</option>
      </select>
      <select id="f-status" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm">
        <option value="">All statuses</option>
        {['active','pending','expired'].map((s) => <option value={s} selected={s === initial.status}>{s}</option>)}
      </select>
      <select id="f-company" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm max-w-[200px]">
        <option value="">All Employers</option>
        {employerNames.map((n) => <option value={n} selected={n === initial.company}>{n}</option>)}
      </select>
      <select id="f-province" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm">
        <option value="">All provinces</option>
        {PROVINCES.map((p) => <option value={p} selected={p === initial.province}>{p}</option>)}
      </select>
      <select id="f-source" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm max-w-[200px]">
        <option value="">All sources</option>
        {sourceValues.map((s) => <option value={s} selected={s === initial.source}>{s}</option>)}
      </select>
      <select id="f-sort" class="border border-gray-200 rounded-md bg-white px-2.5 py-1.5 text-sm">
        {SORT_OPTIONS.map(([v, label]) => <option value={v} selected={v === initial.sort}>{label}</option>)}
      </select>
      <button id="f-clear" class="text-sm text-gray-600 underline px-2 py-1.5">Reset</button>
    </div>

    <!-- Bulk action bar (hidden until selection) -->
    <div id="bulk-bar" class="hidden items-center flex-wrap gap-2 mb-2 p-2 bg-green-50 border border-green-200 rounded-md text-sm">
      <span class="font-medium text-green-900"><span id="bulk-count">0</span> selected</span>
      <button class="bulk-btn" data-bulk="feature">Feature</button>
      <button class="bulk-btn" data-bulk="unfeature">Unfeature</button>
      <button class="bulk-btn" data-bulk="activate">Activate</button>
      <button class="bulk-btn" data-bulk="deactivate">Deactivate</button>
      <button class="bulk-btn bulk-danger" data-bulk="delete">Delete</button>
      <a id="select-all-filtered" href="#" class="text-green-800 underline ml-1 hidden"></a>
      <button id="clear-selection" class="text-gray-600 underline ml-auto">Clear selection</button>
    </div>

    <p class="text-sm text-gray-500 mb-2"><span id="result-count">…</span></p>

    <div class="overflow-auto bg-white border border-gray-200 rounded-md">
      <table class="w-full border-collapse text-xs">
        <thead>
          <tr>
            <th class="px-2.5 py-2.5 bg-gray-50 border-b-2 border-gray-200 w-8"><input id="check-all" type="checkbox" title="Select current page" /></th>
            <th class="th">Title</th>
            <th class="th">Employer</th>
            <th class="th">Source</th>
            <th class="th">Province</th>
            <th class="th">Category</th>
            <th class="th">Featured</th>
            <th class="th">Active</th>
            <th class="th">Created</th>
            <th class="th">Updated</th>
            <th class="th">Actions</th>
          </tr>
        </thead>
        <tbody id="jobs-tbody">
          <tr><td colspan="11" class="py-12 px-4 text-center text-gray-500 text-sm">Loading…</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div id="pagination" class="flex items-center justify-between gap-2 mt-3 text-sm"></div>
  </main>
</Layout>

<style>
  .th { padding: 10px; text-align: left; font-weight: 600; color: #111827; background: #f9fafb; border-bottom: 2px solid #e5e7eb; white-space: nowrap; }
  .chip { border: 1px solid #d1d5db; background: #fff; color: #374151; border-radius: 9999px; padding: 3px 10px; font-size: 12px; cursor: pointer; transition: all .15s; }
  .chip:hover { background: #f3f4f6; }
  .chip.chip-active { background: #166534; color: #fff; border-color: #166534; }
  .bulk-btn { border: 1px solid #166534; background: #fff; color: #166534; border-radius: 6px; padding: 4px 10px; font-size: 12px; font-weight: 500; cursor: pointer; }
  .bulk-btn:hover { background: #f0fdf4; }
  .bulk-danger { border-color: #dc2626; color: #dc2626; }
  .bulk-danger:hover { background: #fef2f2; }
  tr.row-featured { background: #fffbeb; box-shadow: inset 3px 0 0 #f59e0b; }
  button:disabled { opacity: 0.5; cursor: wait; }
  @media (max-width: 860px) { header { flex-direction: column; align-items: flex-start; } }
</style>

<script>
  type Job = {
    id: string; slug: string; title: string; company: string; province: string; category: string;
    active: boolean; source: string; featured: boolean; created: string; updated: string; expires?: string;
  };

  const PER_PAGE = 50;
  const selected = new Set<string>();
  let current: Job[] = [];        // jobs on the current page
  let lastTotalItems = 0;
  let lastTotalPages = 1;

  const $ = (id: string) => document.getElementById(id)!;
  const tbody = $('jobs-tbody') as HTMLTableSectionElement;

  // ---- URL <-> state -------------------------------------------------------
  function readState() {
    const p = new URLSearchParams(location.search);
    return {
      search: p.get('search') || '',
      featured: p.get('featured') || '',
      status: p.get('status') || '',
      imported: p.get('imported') || '',
      company: p.get('company') || '',
      province: p.get('province') || '',
      source: p.get('source') || '',
      sort: p.get('sort') || 'newest',
      page: parseInt(p.get('page') || '1', 10) || 1,
    };
  }
  function stateToParams(s: ReturnType<typeof readState>) {
    const p = new URLSearchParams();
    if (s.search) p.set('search', s.search);
    if (s.featured) p.set('featured', s.featured);
    if (s.status) p.set('status', s.status);
    if (s.imported) p.set('imported', s.imported);
    if (s.company) p.set('company', s.company);
    if (s.province) p.set('province', s.province);
    if (s.source) p.set('source', s.source);
    if (s.sort && s.sort !== 'newest') p.set('sort', s.sort);
    if (s.page && s.page > 1) p.set('page', String(s.page));
    return p;
  }
  function syncControls(s: ReturnType<typeof readState>) {
    (($('f-search') as HTMLInputElement).value = s.search);
    (($('f-featured') as HTMLSelectElement).value = s.featured);
    (($('f-status') as HTMLSelectElement).value = s.status);
    (($('f-company') as HTMLSelectElement).value = s.company);
    (($('f-province') as HTMLSelectElement).value = s.province);
    (($('f-source') as HTMLSelectElement).value = s.source);
    (($('f-sort') as HTMLSelectElement).value = s.sort);
    // active chip highlight
    document.querySelectorAll('.chip').forEach((c) => c.classList.remove('chip-active'));
    const noFilters = !s.search && !s.featured && !s.status && !s.imported && !s.company && !s.province && !s.source;
    document.querySelectorAll<HTMLButtonElement>('.chip').forEach((c) => {
      if (c.hasAttribute('data-reset')) { if (noFilters) c.classList.add('chip-active'); return; }
      const matches =
        (c.dataset.featured && c.dataset.featured === s.featured) ||
        (c.dataset.imported && c.dataset.imported === s.imported) ||
        (c.dataset.status && c.dataset.status === s.status) ||
        (c.dataset.company && c.dataset.company === s.company);
      if (matches) c.classList.add('chip-active');
    });
  }

  function pushState(s: ReturnType<typeof readState>, replace = false) {
    const qs = stateToParams(s).toString();
    const url = '/admin/jobs' + (qs ? `?${qs}` : '');
    if (replace) history.replaceState(s, '', url); else history.pushState(s, '', url);
  }

  // ---- rendering -----------------------------------------------------------
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }
  function fmtDate(iso?: string) {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '—';
    return `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;
  }
  function isExpired(j: Job) { return Boolean(j.expires && new Date(j.expires).getTime() < Date.now()); }

  function renderRows(items: Job[]) {
    tbody.replaceChildren();
    if (!items.length) {
      const tr = el('tr'); const td = el('td', 'py-12 px-4 text-center text-gray-500 text-sm', 'No jobs found.');
      td.setAttribute('colspan', '11'); tr.appendChild(td); tbody.appendChild(tr); return;
    }
    for (const j of items) {
      const tr = el('tr', 'border-b border-gray-200' + (j.featured ? ' row-featured' : ''));

      // checkbox
      const tdC = el('td', 'px-2.5 py-2.5 text-center');
      const cb = el('input') as HTMLInputElement; cb.type = 'checkbox'; cb.dataset.id = j.id; cb.checked = selected.has(j.id);
      cb.addEventListener('change', () => { cb.checked ? selected.add(j.id) : selected.delete(j.id); renderSelection(); });
      tdC.appendChild(cb); tr.appendChild(tdC);

      // title (link to public page)
      const tdT = el('td', 'px-2.5 py-2.5 max-w-[220px]');
      const a = el('a', 'text-green-800 hover:underline', j.title || '(untitled)') as HTMLAnchorElement;
      a.href = `/job/${j.slug}`; a.target = '_blank'; a.title = j.title || '';
      a.style.display = 'inline-block'; a.style.maxWidth = '210px'; a.style.overflow = 'hidden';
      a.style.textOverflow = 'ellipsis'; a.style.whiteSpace = 'nowrap';
      tdT.appendChild(a); tr.appendChild(tdT);

      tr.appendChild(el('td', 'px-2.5 py-2.5', j.company || '—'));
      tr.appendChild(el('td', 'px-2.5 py-2.5 text-gray-600', j.source || '—'));
      tr.appendChild(el('td', 'px-2.5 py-2.5', j.province || '—'));
      tr.appendChild(el('td', 'px-2.5 py-2.5 text-gray-600', j.category || '—'));

      // featured
      const tdF = el('td', 'px-2.5 py-2.5');
      tdF.appendChild(el('span', j.featured ? 'text-amber-600 font-medium' : 'text-gray-400', j.featured ? '⭐ Yes' : 'No'));
      tr.appendChild(tdF);

      // active/status
      const tdA = el('td', 'px-2.5 py-2.5');
      const exp = isExpired(j);
      const badge = el('span', 'inline-block px-2 py-0.5 rounded-full text-xs font-medium ' +
        (exp ? 'bg-gray-100 text-gray-500' : j.active ? 'bg-green-50 text-green-800' : 'bg-amber-50 text-amber-800'),
        exp ? 'expired' : j.active ? 'active' : 'inactive');
      tdA.appendChild(badge); tr.appendChild(tdA);

      tr.appendChild(el('td', 'px-2.5 py-2.5 text-gray-500', fmtDate(j.created)));
      tr.appendChild(el('td', 'px-2.5 py-2.5 text-gray-500', fmtDate(j.updated)));

      // actions
      const tdAct = el('td', 'px-2.5 py-2.5');
      const wrap = el('div', 'flex gap-1 flex-wrap');
      wrap.appendChild(mkAction(j.id, 'toggle_featured', j.featured ? 'Unfeature' : 'Feature',
        j.featured ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-white text-green-800 border border-green-800'));
      if (j.active) wrap.appendChild(mkAction(j.id, 'reject', 'Deactivate', 'bg-white text-orange-700 border border-orange-300'));
      else wrap.appendChild(mkAction(j.id, 'approve', 'Activate', 'bg-green-800 text-white'));
      wrap.appendChild(mkAction(j.id, 'delete', 'Delete', 'bg-red-600 text-white', j.title));
      tdAct.appendChild(wrap); tr.appendChild(tdAct);

      tbody.appendChild(tr);
    }
    ($('check-all') as HTMLInputElement).checked = items.length > 0 && items.every((j) => selected.has(j.id));
  }

  function mkAction(id: string, action: string, label: string, cls: string, title?: string) {
    const b = el('button', `px-2 py-0.5 text-xs font-medium rounded ${cls}`, label) as HTMLButtonElement;
    b.dataset.id = id; b.dataset.action = action; if (title) b.dataset.title = title;
    b.addEventListener('click', () => rowAction(b));
    return b;
  }

  function renderSummary(sm: any) {
    if (!sm) return;
    $('sum-total').textContent = sm.total; $('sum-featured').textContent = sm.featured;
    $('sum-active').textContent = sm.active; $('sum-expired').textContent = sm.expired;
    $('sum-imported').textContent = sm.imported; $('sum-manual').textContent = sm.manual;
  }

  function renderPagination(page: number, totalPages: number, totalItems: number) {
    const box = $('pagination'); box.replaceChildren();
    const info = el('span', 'text-gray-500', totalItems === 0 ? 'No results' : `Page ${page} of ${totalPages}`);
    const nav = el('div', 'flex gap-1');
    const mkBtn = (label: string, target: number, disabled: boolean, primary = false) => {
      const b = el('button',
        'px-3 py-1 rounded border text-sm ' + (disabled ? 'border-gray-200 text-gray-300' : primary ? 'border-green-800 bg-green-800 text-white' : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50'),
        label) as HTMLButtonElement;
      b.disabled = disabled;
      if (!disabled) b.addEventListener('click', () => { const s = readState(); s.page = target; pushState(s); load(); });
      return b;
    };
    nav.appendChild(mkBtn('‹ Prev', page - 1, page <= 1));
    // windowed page numbers
    const start = Math.max(1, page - 2), end = Math.min(totalPages, page + 2);
    for (let i = start; i <= end; i++) nav.appendChild(mkBtn(String(i), i, false, i === page));
    nav.appendChild(mkBtn('Next ›', page + 1, page >= totalPages));
    box.appendChild(info); box.appendChild(nav);
  }

  // ---- selection UI --------------------------------------------------------
  function renderSelection() {
    const n = selected.size;
    const bar = $('bulk-bar');
    bar.classList.toggle('hidden', n === 0);
    bar.classList.toggle('flex', n > 0);
    $('bulk-count').textContent = String(n);
    // "select all filtered" link
    const link = $('select-all-filtered') as HTMLAnchorElement;
    const pageIds = current.map((j) => j.id);
    const allPageSelected = pageIds.length > 0 && pageIds.every((id) => selected.has(id));
    if (allPageSelected && lastTotalItems > pageIds.length && n < lastTotalItems) {
      link.classList.remove('hidden');
      link.textContent = `Select all ${lastTotalItems} filtered results`;
    } else {
      link.classList.add('hidden');
    }
    ($('check-all') as HTMLInputElement).checked = pageIds.length > 0 && allPageSelected;
    // reflect checkbox states
    tbody.querySelectorAll<HTMLInputElement>('input[type=checkbox][data-id]').forEach((cb) => {
      cb.checked = selected.has(cb.dataset.id!);
    });
  }

  // ---- data load -----------------------------------------------------------
  async function load() {
    const s = readState();
    syncControls(s);
    tbody.replaceChildren(Object.assign(el('tr'), {}));
    tbody.firstChild!.appendChild(Object.assign(el('td', 'py-8 px-4 text-center text-gray-400 text-sm', 'Loading…'), { colSpan: 11 }));
    const p = stateToParams(s); p.set('perPage', String(PER_PAGE)); p.set('summary', '1');
    try {
      const res = await fetch('/api/admin/jobs-list?' + p.toString(), { headers: { Accept: 'application/json' } });
      if (res.status === 401) { location.href = '/login?next=/admin/jobs'; return; }
      const body = await res.json();
      if (!body.success) throw new Error(body.error || 'load failed');
      const d = body.data;
      current = d.items; lastTotalItems = d.totalItems; lastTotalPages = d.totalPages;
      renderRows(d.items);
      renderSummary(d.summary);
      $('result-count').textContent = `${d.totalItems} job${d.totalItems !== 1 ? 's' : ''} match current filters`;
      renderPagination(d.page, Math.max(1, d.totalPages), d.totalItems);
      renderSelection();
    } catch (e) {
      tbody.replaceChildren();
      const tr = el('tr'); const td = Object.assign(el('td', 'py-8 px-4 text-center text-red-600 text-sm', 'Failed to load jobs.'), { colSpan: 11 });
      tr.appendChild(td); tbody.appendChild(tr);
    }
  }

  // ---- actions -------------------------------------------------------------
  async function rowAction(button: HTMLButtonElement) {
    const action = button.dataset.action!, id = button.dataset.id!;
    if (action === 'delete' && !confirm(`Permanently delete "${button.dataset.title || 'this job'}"? This cannot be undone.`)) return;
    const original = button.textContent; button.disabled = true; button.textContent = '…';
    try {
      const res = await fetch('/api/admin/job-action', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ jobId: id, action }),
      });
      if (res.status === 401) { location.href = '/login?next=/admin/jobs'; return; }
      const body = await res.json().catch(() => ({}));
      if (res.ok && body.success !== false) { selected.delete(id); load(); }
      else { alert(body.error || `Action failed: ${action}`); button.disabled = false; button.textContent = original; }
    } catch { alert('Network error.'); button.disabled = false; button.textContent = original; }
  }

  const BULK_LABELS: Record<string, string> = {
    feature: 'Feature', unfeature: 'Unfeature', activate: 'Activate', deactivate: 'Deactivate', delete: 'Delete',
  };
  async function bulkAction(action: string) {
    const ids = [...selected];
    if (!ids.length) return;
    const verb = BULK_LABELS[action] || action;
    const msg = action === 'delete'
      ? `Delete ${ids.length} selected job${ids.length !== 1 ? 's' : ''}? This cannot be undone.`
      : `${verb} ${ids.length} selected job${ids.length !== 1 ? 's' : ''}?`;
    if (!confirm(msg)) return;
    const buttons = document.querySelectorAll<HTMLButtonElement>('.bulk-btn');
    buttons.forEach((b) => (b.disabled = true));
    try {
      const res = await fetch('/api/admin/jobs-bulk', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, action }),
      });
      if (res.status === 401) { location.href = '/login?next=/admin/jobs'; return; }
      const body = await res.json().catch(() => ({}));
      if (res.ok && body.success !== false) {
        const d = body.data;
        if (d.failed) alert(`${verb}: ${d.processed} done, ${d.failed} failed.`);
        selected.clear(); load();
      } else { alert(body.error || 'Bulk action failed.'); }
    } catch { alert('Network error during bulk action.'); }
    finally { buttons.forEach((b) => (b.disabled = false)); }
  }

  // ---- wiring --------------------------------------------------------------
  function applyControlsToState(extra: Partial<ReturnType<typeof readState>> = {}, resetPage = true) {
    const s = readState();
    s.search = ($('f-search') as HTMLInputElement).value.trim();
    s.featured = ($('f-featured') as HTMLSelectElement).value;
    s.status = ($('f-status') as HTMLSelectElement).value;
    s.company = ($('f-company') as HTMLSelectElement).value;
    s.province = ($('f-province') as HTMLSelectElement).value;
    s.source = ($('f-source') as HTMLSelectElement).value;
    s.sort = ($('f-sort') as HTMLSelectElement).value;
    Object.assign(s, extra);
    if (resetPage) s.page = 1;
    pushState(s); load();
  }

  ['f-featured','f-status','f-company','f-province','f-source','f-sort'].forEach((id) =>
    $(id).addEventListener('change', () => applyControlsToState()));

  let searchTimer: number | undefined;
  $('f-search').addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => applyControlsToState(), 300);
  });

  $('f-clear').addEventListener('click', () => { pushState({ search:'',featured:'',status:'',imported:'',company:'',province:'',source:'',sort:'newest',page:1 }); load(); });

  // chips
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const base = { search:'', featured:'', status:'', imported:'', company:'', province:'', source:'', sort: readState().sort, page: 1 };
      if (!chip.hasAttribute('data-reset')) {
        if (chip.dataset.featured) base.featured = chip.dataset.featured;
        if (chip.dataset.imported) base.imported = chip.dataset.imported;
        if (chip.dataset.status) base.status = chip.dataset.status;
        if (chip.dataset.company) base.company = chip.dataset.company;
      }
      pushState(base as any); load();
    });
  });

  // select current page / all filtered / clear
  ($('check-all') as HTMLInputElement).addEventListener('change', (e) => {
    const on = (e.target as HTMLInputElement).checked;
    current.forEach((j) => (on ? selected.add(j.id) : selected.delete(j.id)));
    renderRows(current); renderSelection();
  });
  $('select-all-filtered').addEventListener('click', async (e) => {
    e.preventDefault();
    const s = readState(); const p = stateToParams(s); p.set('mode', 'ids');
    const res = await fetch('/api/admin/jobs-list?' + p.toString(), { headers: { Accept: 'application/json' } });
    const body = await res.json().catch(() => ({}));
    if (body.success) {
      body.data.ids.forEach((id: string) => selected.add(id));
      if (body.data.capped) alert(`Selected the first ${body.data.ids.length} of ${body.data.totalItems} (bulk cap).`);
      renderRows(current); renderSelection();
    }
  });
  $('clear-selection').addEventListener('click', () => { selected.clear(); renderRows(current); renderSelection(); });

  document.querySelectorAll<HTMLButtonElement>('.bulk-btn').forEach((b) =>
    b.addEventListener('click', () => bulkAction(b.dataset.bulk!)));

  window.addEventListener('popstate', () => load());

  // initial load
  pushState(readState(), true);
  load();
</script>
