---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { listXmlSources } from '../../services/jobService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const sources = await listXmlSources();

const PROVINCES_FEED = [
  ['Gauteng', 'gauteng'],
  ['Western Cape', 'western-cape'],
  ['KwaZulu-Natal', 'kwazulu-natal'],
  ['Eastern Cape', 'eastern-cape'],
  ['Limpopo', 'limpopo'],
  ['Mpumalanga', 'mpumalanga'],
  ['North West', 'north-west'],
  ['Free State', 'free-state'],
  ['Northern Cape', 'northern-cape'],
];

const OUTBOUND_FEEDS = [
  { name: 'Indeed', path: '/feeds/jobs.xml', format: 'Indeed XML', desc: 'Submit to Indeed XML feed partner portal' },
  { name: 'Adzuna', path: '/feeds/adzuna.xml', format: 'Adzuna XML', desc: 'Adzuna aggregator feed' },
  { name: 'Trovit', path: '/feeds/trovit.xml', format: 'Trovit XML', desc: 'Trovit job board feed' },
  { name: 'Jobly', path: '/feeds/jobly.xml', format: 'Jobly XML', desc: 'Jobly aggregator feed' },
  { name: 'Careerjet', path: '/feeds/careerjet.xml', format: 'Careerjet XML', desc: 'Careerjet aggregator feed' },
  { name: 'RSS', path: '/feeds/rss.xml', format: 'RSS 2.0', desc: 'General RSS for any reader/aggregator' },
  ...PROVINCES_FEED.map(([label, slug]) => ({
    name: `Indeed — ${label}`,
    path: `/feeds/jobs-${slug}.xml`,
    format: 'Indeed XML',
    desc: `Province-filtered feed (${label})`,
  })),
];

const siteOrigin = Astro.url.origin;
---

<Layout title="Imports — Admin" description="Manage inbound and outbound feeds." canonicalUrl={Astro.url.href}>
  <main class="max-w-6xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-4 flex-wrap gap-3">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Imports & Feeds</h1>
      <AdminNav current="import" />
    </header>

    <div class="flex gap-1 border-b border-gray-200 mb-4" role="tablist">
      <button class="tab active bg-transparent border-0 border-b-2 border-green-800 px-3.5 py-2 text-sm font-medium text-green-800 cursor-pointer" role="tab" aria-selected="true" data-tab="inbound" id="tab-inbound">Inbound Recruiter Feeds</button>
      <button class="tab bg-transparent border-0 border-b-2 border-transparent px-3.5 py-2 text-sm text-gray-500 hover:text-gray-900 cursor-pointer" role="tab" aria-selected="false" data-tab="outbound" id="tab-outbound">Outbound Feeds</button>
    </div>

    <!-- CSV upload -->
    <section class="bg-white border border-gray-200 rounded-md p-5 mb-4">
      <h2 class="text-sm font-semibold text-gray-900 mb-1.5">Import from CSV file</h2>
      <p class="text-xs text-gray-500 mb-3">Upload a CSV with columns: <code class="bg-gray-100 px-1 py-0.5 rounded text-xs">title, company, category, province, city, description, apply_url, apply_email, salary_min, salary_max, job_type, source</code>. Other columns are ignored.</p>
      <form id="csv-form" enctype="multipart/form-data">
        <div class="flex flex-col gap-2 mb-3">
          <label class="csv-file"><input type="file" name="file" accept=".csv,text/csv" required class="text-sm p-1.5 border border-dashed border-gray-300 rounded-md w-full" /></label>
          <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer"><input type="checkbox" name="active" value="true" class="w-4 h-4" /><span>Mark all imported jobs as <strong class="text-gray-900">active</strong> immediately</span></label>
          <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer"><input type="checkbox" name="featured" value="true" class="w-4 h-4" /><span>Mark all imported jobs as <strong class="text-gray-900">featured</strong></span></label>
        </div>
        <button type="submit" class="btn-primary bg-green-800 text-white text-sm font-medium px-5 py-2 rounded-md hover:bg-green-900 transition-colors" id="csv-submit">Import CSV</button>
      </form>
      <div id="csv-result" hidden></div>
    </section>

    <!-- JSON upload -->
    <section class="bg-white border border-gray-200 rounded-md p-5 mb-4">
      <h2 class="text-sm font-semibold text-gray-900 mb-1.5">Import from JSON file</h2>
      <p class="text-xs text-gray-500 mb-3">Upload a JSON file containing an array of job objects, or an object with a <code class="bg-gray-100 px-1 py-0.5 rounded text-xs">jobs</code> array. Same field names as CSV.</p>
      <form id="json-form" enctype="multipart/form-data">
        <div class="flex flex-col gap-2 mb-3">
          <label class="csv-file"><input type="file" name="file" accept=".json,application/json" required class="text-sm p-1.5 border border-dashed border-gray-300 rounded-md w-full" /></label>
          <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer"><input type="checkbox" name="active" value="true" class="w-4 h-4" /><span>Mark all imported jobs as <strong class="text-gray-900">active</strong> immediately</span></label>
          <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer"><input type="checkbox" name="featured" value="true" class="w-4 h-4" /><span>Mark all imported jobs as <strong class="text-gray-900">featured</strong></span></label>
        </div>
        <button type="submit" class="btn-primary bg-green-800 text-white text-sm font-medium px-5 py-2 rounded-md hover:bg-green-900 transition-colors" id="json-submit">Import JSON</button>
      </form>
      <div id="json-result" hidden></div>
    </section>

    <!-- Tab 1: Inbound Recruiter Feeds -->
    <section class="tab-panel" id="panel-inbound" role="tabpanel" aria-labelledby="tab-inbound">
      <div class="flex justify-between items-center mb-3 gap-3 flex-wrap">
        <p class="text-sm text-gray-500 m-0">Pull jobs <strong class="text-gray-900">from</strong> recruiters. We crawl each feed every 6 hours.</p>
        <button class="btn-primary bg-green-800 text-white text-sm font-medium px-5 py-2 rounded-md hover:bg-green-900 transition-colors" id="open-add">+ Add Feed</button>
      </div>

      <div class="overflow-auto bg-white border border-gray-200 rounded-md">
        <table class="data-table w-full border-collapse text-sm">
          <thead>
            <tr>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Feed Name</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">URL</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Format</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Status</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Last Crawled</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Last Count</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Actions</th>
            </tr>
          </thead>
          <tbody>
            {sources.length === 0 && (
              <tr><td colspan="7" class="py-12 text-center text-gray-500">No inbound feeds yet. Click <em>Add Feed</em> to create one.</td></tr>
            )}
            {sources.map((s: any) => (
              <>
                <tr class="border-b border-gray-200" data-row={s.id}>
                  <td class="px-2.5 py-2.5 font-semibold text-gray-900">{s.name}</td>
                  <td class="px-2.5 py-2.5"><a href={s.feed_url} target="_blank" rel="noopener noreferrer" class="text-green-800 text-xs break-all">{s.feed_url}</a></td>
                  <td class="px-2.5 py-2.5"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{s.format}</span></td>
                  <td class="px-2.5 py-2.5"><span class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold ${s.active ? 'bg-green-50 text-green-800' : 'bg-amber-50 text-amber-800'}`}>{s.active ? 'Active' : 'Paused'}</span></td>
                  <td class="px-2.5 py-2.5 text-gray-500 text-xs">{s.last_crawled ? new Date(s.last_crawled).toLocaleString('en-ZA') : 'Never'}</td>
                  <td class="px-2.5 py-2.5">{s.last_job_count ?? 0}</td>
                  <td class="px-2.5 py-2.5">
                    <div class="flex gap-1 flex-wrap">
                      <button class="px-2 py-0.5 text-xs rounded border border-gray-200 text-gray-600 bg-white hover:bg-gray-50 transition-colors" data-edit={s.id} data-name={s.name} data-url={s.feed_url} data-format={s.format} data-active={String(!!s.active)}>Edit</button>
                      <button class="px-2 py-0.5 text-xs rounded border border-gray-200 text-gray-600 bg-white hover:bg-gray-50 transition-colors" data-crawl={s.id}>Crawl Now</button>
                      <button class="px-2 py-0.5 text-xs rounded border border-red-200 text-red-600 bg-white hover:bg-red-50 transition-colors" data-delete={s.id}>Delete</button>
                    </div>
                  </td>
                </tr>
                {s.error_log && (
                  <tr class="error-row"><td colspan="7" class="bg-red-50 px-2 py-2">
                    <details class="text-xs"><summary class="text-red-600 cursor-pointer font-medium">Last error</summary><pre class="mt-1.5 whitespace-pre-wrap text-xs text-red-800 bg-white p-2 rounded-md border border-red-200">{s.error_log}</pre></details>
                  </td></tr>
                )}
              </>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Tab 2: Outbound Feeds -->
    <section class="tab-panel" id="panel-outbound" role="tabpanel" aria-labelledby="tab-outbound" hidden>
      <p class="text-sm text-gray-500 mb-3">Submit these URLs directly to each aggregator's partner portal. Feeds are live and update automatically.</p>

      <div class="overflow-auto bg-white border border-gray-200 rounded-md">
        <table class="data-table w-full border-collapse text-sm">
          <thead>
            <tr>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Aggregator</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Feed URL</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Format</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Description</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs whitespace-nowrap">Action</th>
            </tr>
          </thead>
          <tbody>
            {OUTBOUND_FEEDS.map((f) => (
              <tr class="border-b border-gray-200">
                <td class="px-2.5 py-2.5 font-semibold text-gray-900">{f.name}</td>
                <td class="px-2.5 py-2.5"><a href={f.path} target="_blank" rel="noopener noreferrer" class="text-green-800 text-xs break-all">{siteOrigin}{f.path}</a></td>
                <td class="px-2.5 py-2.5"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{f.format}</span></td>
                <td class="px-2.5 py-2.5 text-gray-500 text-xs">{f.desc}</td>
                <td class="px-2.5 py-2.5"><button class="px-2 py-0.5 text-xs rounded border border-gray-200 text-gray-600 bg-white hover:bg-gray-50 transition-colors" data-copy={`${siteOrigin}${f.path}`}>Copy URL</button></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- Modal -->
  <div id="feed-modal" class="fixed inset-0 bg-black/45 flex items-center justify-center z-[9999]" hidden role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="bg-white rounded-md p-6 w-[90%] max-w-[460px] relative">
      <button type="button" class="absolute top-2.5 right-3.5 bg-transparent border-0 text-xl text-gray-500 cursor-pointer" aria-label="Close">&times;</button>
      <h3 id="modal-title" class="text-base font-semibold text-gray-900 mb-3.5">Add Feed</h3>
      <form id="feed-form" class="space-y-3">
        <input type="hidden" name="id" value="" />
        <label class="block text-xs font-medium text-gray-600"><span class="block mb-1">Feed Name</span><input class="form-field w-full border border-gray-200 rounded-md px-2.5 py-2 text-sm focus:outline-none focus:border-green-800" name="name" required /></label>
        <label class="block text-xs font-medium text-gray-600"><span class="block mb-1">Feed URL</span><input class="form-field w-full border border-gray-200 rounded-md px-2.5 py-2 text-sm focus:outline-none focus:border-green-800" name="feed_url" type="url" required placeholder="https://example.com/feed.xml" /></label>
        <label class="block text-xs font-medium text-gray-600"><span class="block mb-1">Format</span>
          <select class="form-field w-full border border-gray-200 rounded-md px-2.5 py-2 text-sm focus:outline-none focus:border-green-800" name="format" required>
            <option value="xml">XML (generic)</option>
            <option value="indeed_xml">Indeed XML</option>
            <option value="json">JSON</option>
            <option value="rss">RSS 2.0</option>
          </select>
        </label>
        <label class="flex items-center gap-2 text-xs font-medium text-gray-600 cursor-pointer">
          <input type="checkbox" name="active" value="true" checked class="w-4 h-4" />
          <span>Active (crawl every 6 hours)</span>
        </label>
        <p id="modal-error" hidden class="text-red-600 text-xs m-0"></p>
        <div class="flex justify-end gap-2 mt-1">
          <button type="button" class="btn-secondary bg-white text-gray-600 text-sm font-medium px-5 py-2 rounded-md border border-gray-200 hover:bg-gray-50 transition-colors modal-cancel">Cancel</button>
          <button type="submit" class="btn-primary bg-green-800 text-white text-sm font-medium px-5 py-2 rounded-md hover:bg-green-900 transition-colors">Save</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  function renderImportResult(target: HTMLDivElement, body: any, ok: boolean) {
    if (ok && body.success !== false) {
      const d = body.data || {};
      const imported = d.imported ?? 0;
      const skipped = d.skipped ?? 0;
      const errors: string[] = Array.isArray(d.errors) ? d.errors : [];
      let html = `<div class="bg-green-50 text-green-800 p-2.5 rounded-md text-sm mb-2"><strong>Successfully imported: ${imported} job${imported === 1 ? '' : 's'}</strong></div>`;
      if (skipped > 0) {
        html += `<div class="bg-amber-50 text-amber-800 p-2 rounded-md text-xs mb-2">Skipped: ${skipped} ${skipped === 1 ? 'row' : 'rows'} (missing title)</div>`;
      }
      if (errors.length > 0) {
        const escaped = errors.map(e => e.replace(/[<>&]/g, c => ({ '<':'&lt;','>':'&gt;','&':'&amp;' }[c] as string))).join('\n');
        html += `<details class="mt-2"><summary class="cursor-pointer text-xs text-red-600">${errors.length} error${errors.length === 1 ? '' : 's'}</summary><pre class="bg-white p-2 rounded-md border border-red-200 text-xs whitespace-pre-wrap mt-1.5 max-h-[200px] overflow-y-auto">${escaped}</pre></details>`;
      }
      target.innerHTML = html;
    } else {
      target.innerHTML = `<div class="bg-red-50 text-red-800 p-2.5 rounded-md text-sm">${body.error || 'Import failed.'}</div>`;
    }
    target.hidden = false;
  }

  const csvForm = document.getElementById('csv-form') as HTMLFormElement;
  const csvSubmit = document.getElementById('csv-submit') as HTMLButtonElement;
  const csvResult = document.getElementById('csv-result') as HTMLDivElement;

  csvForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    csvSubmit.disabled = true;
    csvSubmit.classList.add('opacity-50');
    const original = csvSubmit.textContent;
    csvSubmit.textContent = 'Importing…';
    csvResult.hidden = true;
    try {
      const fd = new FormData(csvForm);
      const res = await fetch('/api/admin/import-csv', { method: 'POST', body: fd });
      const body = await res.json().catch(() => ({}));
      renderImportResult(csvResult, body, res.ok);
      if (res.ok && body.success !== false) csvForm.reset();
    } catch {
      csvResult.innerHTML = '<div class="bg-red-50 text-red-800 p-2.5 rounded-md text-sm">Network error during import.</div>';
      csvResult.hidden = false;
    } finally {
      csvSubmit.disabled = false;
      csvSubmit.classList.remove('opacity-50');
      csvSubmit.textContent = original;
    }
  });

  const jsonForm = document.getElementById('json-form') as HTMLFormElement;
  const jsonSubmit = document.getElementById('json-submit') as HTMLButtonElement;
  const jsonResult = document.getElementById('json-result') as HTMLDivElement;

  jsonForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    jsonSubmit.disabled = true;
    jsonSubmit.classList.add('opacity-50');
    const original = jsonSubmit.textContent;
    jsonSubmit.textContent = 'Importing…';
    jsonResult.hidden = true;
    try {
      const fd = new FormData(jsonForm);
      const res = await fetch('/api/admin/import-json', { method: 'POST', body: fd });
      const body = await res.json().catch(() => ({}));
      renderImportResult(jsonResult, body, res.ok);
      if (res.ok && body.success !== false) jsonForm.reset();
    } catch {
      jsonResult.innerHTML = '<div class="bg-red-50 text-red-800 p-2.5 rounded-md text-sm">Network error during import.</div>';
      jsonResult.hidden = false;
    } finally {
      jsonSubmit.disabled = false;
      jsonSubmit.classList.remove('opacity-50');
      jsonSubmit.textContent = original;
    }
  });

  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => { t.classList.remove('border-green-800','text-green-800'); t.classList.add('border-transparent','text-gray-500'); t.setAttribute('aria-selected', 'false'); });
      tab.classList.add('border-green-800','text-green-800');
      tab.classList.remove('border-transparent','text-gray-500');
      tab.setAttribute('aria-selected', 'true');
      const target = tab.dataset.tab;
      panels.forEach((p) => { p.hidden = p.id !== `panel-${target}`; });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copy || '';
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch {
        const input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        input.remove();
        btn.textContent = 'Copied!';
      }
    });
  });

  const modal = document.getElementById('feed-modal') as HTMLElement;
  const modalTitle = document.getElementById('modal-title') as HTMLElement;
  const modalError = document.getElementById('modal-error') as HTMLParagraphElement;
  const form = document.getElementById('feed-form') as HTMLFormElement;

  function openModal(mode: 'add' | 'edit', data?: { id: string; name: string; url: string; format: string; active: boolean }) {
    modalError.hidden = true;
    form.reset();
    if (mode === 'edit' && data) {
      modalTitle.textContent = 'Edit Feed';
      (form.elements.namedItem('id') as HTMLInputElement).value = data.id;
      (form.elements.namedItem('name') as HTMLInputElement).value = data.name;
      (form.elements.namedItem('feed_url') as HTMLInputElement).value = data.url;
      (form.elements.namedItem('format') as HTMLSelectElement).value = data.format;
      (form.elements.namedItem('active') as HTMLInputElement).checked = data.active;
    } else {
      modalTitle.textContent = 'Add Feed';
      (form.elements.namedItem('id') as HTMLInputElement).value = '';
    }
    modal.hidden = false;
  }

  function closeModal() { modal.hidden = true; }

  document.getElementById('open-add')?.addEventListener('click', () => openModal('add'));
  document.querySelector('.modal-close')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((btn) => {
    btn.addEventListener('click', () => openModal('edit', {
      id: btn.dataset.edit || '',
      name: btn.dataset.name || '',
      url: btn.dataset.url || '',
      format: btn.dataset.format || 'xml',
      active: btn.dataset.active === 'true',
    }));
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload = {
      id: fd.get('id') || undefined,
      name: fd.get('name'),
      feed_url: fd.get('feed_url'),
      format: fd.get('format'),
      active: fd.get('active') === 'true',
    };
    const res = await fetch('/api/admin/xml-source', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      location.reload();
    } else {
      const body = await res.json().catch(() => ({}));
      modalError.textContent = body.error || 'Could not save feed.';
      modalError.hidden = false;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-crawl]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Crawling…';
      const res = await fetch('/api/admin/trigger-crawl', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sourceId: btn.dataset.crawl }),
      });
      const body = await res.json().catch(() => ({}));
      btn.disabled = false;
      btn.textContent = original;
      if (body.success) {
        location.reload();
      } else {
        alert(body.error || 'Crawl failed.');
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Delete this feed source? This will not remove already-imported jobs.')) return;
      const res = await fetch('/api/admin/xml-source', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: btn.dataset.delete, _action: 'delete' }),
      });
      if (res.ok) location.reload();
    });
  });
</script>

<style>
  @media (max-width: 640px) {
    .data-table { font-size: 12px; }
    .data-table th, .data-table td { padding: 8px 6px; }
  }
</style>
