---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { listXmlSourcesWithCounts } from '../../services/jobService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const { sources: xmlSources } = await listXmlSourcesWithCounts();

const outboundFeeds = [
  { name: 'Indeed', url: '/feeds/jobs.xml' },
  { name: 'Adzuna', url: '/feeds/adzuna.xml' },
  { name: 'Trovit', url: '/feeds/trovit.xml' },
  { name: 'Jobly', url: '/feeds/jobly.xml' },
  { name: 'Careerjet', url: '/feeds/careerjet.xml' },
  { name: 'RSS 2.0', url: '/feeds/rss.xml' },
  ...['Gauteng', 'Western Cape', 'KwaZulu-Natal', 'Eastern Cape', 'Limpopo', 'Mpumalanga', 'North West', 'Free State', 'Northern Cape'].map(
    (p) => ({ name: `Indeed: ${p}`, url: `/feeds/jobs-${p.toLowerCase().replace(/\s+/g, '-')}.xml` })
  ),
];
---

<Layout title="Outbound Feeds | Admin" canonicalUrl={Astro.url.href}>
  <main class="max-w-6xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-4">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Outbound Feeds</h1>
      <AdminNav current="feeds" />
    </header>

    <section class="bg-white border border-gray-200 rounded-md p-5 mb-4">
      <h2 class="text-sm font-semibold text-gray-900 mb-3">Aggregator Feed Endpoints</h2>
      <div class="overflow-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">Feed</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">URL</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">Status</th>
            </tr>
          </thead>
          <tbody>
            {outboundFeeds.map((feed) => (
              <tr class="border-b border-gray-200">
                <td class="px-2.5 py-2.5 font-medium">{feed.name}</td>
                <td class="px-2.5 py-2.5"><a href={feed.url} target="_blank" class="text-green-800 text-xs break-all">{feed.url}</a></td>
                <td class="px-2.5 py-2.5"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-800">Active</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="bg-white border border-gray-200 rounded-md p-5">
      <h2 class="text-sm font-semibold text-gray-900 mb-3">Inbound Feed Sources ({xmlSources.length})</h2>
      <div class="overflow-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">Name</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">Format</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">Last Crawled</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">Jobs Found</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">Status</th>
              <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 text-xs bg-gray-50 border-b-2 border-gray-200">Error</th>
            </tr>
          </thead>
          <tbody>
            {(xmlSources as any[]).length === 0 && <tr><td colspan="6" class="py-12 text-center text-gray-500">No feed sources configured.</td></tr>}
            {(xmlSources as any[]).map((source: any) => (
              <tr class="border-b border-gray-200">
                <td class="px-2.5 py-2.5 font-medium max-w-[200px] truncate">{source.name}</td>
                <td class="px-2.5 py-2.5"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{source.format}</span></td>
                <td class="px-2.5 py-2.5 text-gray-500 text-xs">{source.last_crawled ? new Date(source.last_crawled).toLocaleString('en-ZA') : 'Never'}</td>
                <td class="px-2.5 py-2.5"><b class="text-gray-900">{source.last_job_count || 0}</b></td>
                <td class="px-2.5 py-2.5"><span class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold ${source.active ? 'bg-green-50 text-green-800' : 'bg-amber-50 text-amber-800'}`}>{source.active ? 'Active' : 'Paused'}</span></td>
                <td class="px-2.5 py-2.5 text-red-600 text-xs max-w-[250px] truncate">{source.error_log || '\u2014'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>
