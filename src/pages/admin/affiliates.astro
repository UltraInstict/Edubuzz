---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { getAffiliateClickStats, listAllAffiliateLinks, PB_FILE_BASE } from '../../services/affiliateService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const [links, stats] = await Promise.all([
  listAllAffiliateLinks(),
  getAffiliateClickStats(),
]);

const categories = ['general', 'finance', 'tech', 'government', 'health', 'education', 'engineering', 'legal', 'marketing', 'hospitality', 'retail', 'construction', 'logistics', 'agriculture', 'mining'];
const zones = [
  { value: 'sidebar',  label: 'Sidebar' },
  { value: 'strip',    label: 'Strip (full-width banner)' },
  { value: 'infeed',   label: 'In-feed (between job cards)' },
  { value: 'jobs-top', label: 'Jobs Page Top' },
  { value: 'all',      label: 'All zones' },
];
---

<Layout title="Affiliate Links | Admin" canonicalUrl={Astro.url.href}>
  <main class="max-w-6xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-4 flex-wrap gap-3">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Affiliate Links</h1>
      <AdminNav current="affiliates" />
    </header>

    <section class="grid grid-cols-3 gap-2.5 mb-4">
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{stats.totalClicks.toLocaleString('en-ZA')}</b>
        <span class="text-xs text-gray-500">Total clicks</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{stats.todayClicks.toLocaleString('en-ZA')}</b>
        <span class="text-xs text-gray-500">Clicks today</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{links.length}</b>
        <span class="text-xs text-gray-500">Active links</span>
      </div>
    </section>

    <section class="bg-white border border-gray-200 rounded-md p-5 mb-4">
      <h2 id="form-heading" class="text-sm font-semibold text-gray-900 mb-3">Add New Affiliate Link</h2>
      <form id="affiliate-form" class="space-y-3" enctype="multipart/form-data">
        <input type="hidden" name="action" value="add" />
        <input type="hidden" name="id" value="" />

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Display type</label>
          <select name="display_type" id="display_type" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800">
            <option value="text">Text Ad — clean headline link</option>
            <option value="image">Banner Image — uploaded file or URL</option>
            <option value="html">HTML Creative — paste MaxBounty embed code</option>
          </select>
        </div>

        <div><label class="block text-sm font-medium text-gray-700 mb-1">Ad Title</label><input type="text" name="name" placeholder="e.g. Take surveys and earn money working from home" required class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" /></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Short description (optional — shows under ad title)</label><input type="text" name="description" maxlength="120" placeholder="e.g. Earn extra income completing surveys from home" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" /></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Affiliate URL</label><input type="url" name="url" placeholder="https://maxbounty.com/..." required class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" /></div>

        <div class="flex gap-3 flex-wrap">
          <label class="flex-1 min-w-[200px]"><span class="block text-sm font-medium text-gray-700 mb-1">Category</span>
            <select name="category" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800">
              <option value="general">general (shows everywhere)</option>
              {categories.filter(c => c !== 'general').map(c => <option value={c}>{c}</option>)}
            </select>
          </label>
          <label class="flex-1 min-w-[200px]"><span class="block text-sm font-medium text-gray-700 mb-1">Zone</span>
            <select name="zone" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800">
              {zones.map(z => <option value={z.value}>{z.label}</option>)}
            </select>
          </label>
        </div>

        <div class="flex gap-3 flex-wrap" data-show-when="image">
          <label class="flex-1 min-w-[200px]"><span class="block text-sm font-medium text-gray-700 mb-1">Banner Width (px)</span><input type="number" name="banner_width" min="0" placeholder="e.g. 728" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" /></label>
          <label class="flex-1 min-w-[200px]"><span class="block text-sm font-medium text-gray-700 mb-1">Banner Height (px)</span><input type="number" name="banner_height" min="0" placeholder="e.g. 90" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" /></label>
        </div>
        <div data-show-when="image"><label class="block text-sm font-medium text-gray-700 mb-1">Upload Banner Image (preferred over external URL)</label><input type="file" name="banner_file" accept="image/jpeg,image/png,image/gif,image/webp" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm" /></div>
        <div data-show-when="image"><label class="block text-sm font-medium text-gray-700 mb-1">Banner Image URL (external)</label><input type="text" name="image_url" placeholder="https://example.com/banner.png" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" /></div>
        <div data-show-when="html"><label class="block text-sm font-medium text-gray-700 mb-1">Banner HTML / JS code (paste MaxBounty creative)</label><textarea name="banner_html" placeholder='<script src="..."></script> or <iframe>...' class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800 font-mono" rows="4"></textarea></div>

        <p id="form-error" hidden class="text-red-600 text-xs p-2 bg-red-50 border border-red-200 rounded-md m-0"></p>

        <div class="flex gap-2">
          <button type="submit" class="btn-save bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors" id="submit-btn">Add Link</button>
          <button type="button" class="btn-cancel bg-white text-gray-600 text-sm font-medium px-5 py-2.5 rounded-md border border-gray-200 hover:bg-gray-50 transition-colors" id="cancel-btn" hidden>Cancel</button>
        </div>
      </form>
    </section>

    <section class="bg-white border border-gray-200 rounded-md p-5">
      <h2 class="text-sm font-semibold text-gray-900 mb-3">Active Links ({links.length})</h2>
      <div class="overflow-auto">
        <table class="w-full border-collapse text-sm">
          <thead><tr>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs">Ad Title</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs">Type</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs">Category</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs">Zone</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs">Size</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs">Clicks</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs">Status</th>
            <th class="px-2.5 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 text-xs">Actions</th>
          </tr></thead>
          <tbody>
            {links.length === 0 && <tr><td colspan="8" class="py-12 text-center text-gray-500">No affiliate links yet.</td></tr>}
            {links.map((link: any) => {
              const rawFile = link.banner_file;
              const bannerFile = Array.isArray(rawFile) ? rawFile[0] : rawFile;
              const fileUrl = bannerFile && link.collectionId
                ? `${PB_FILE_BASE}/files/${link.collectionId}/${link.id}/${bannerFile}?thumb=64x64`
                : null;
              const displayType = link.display_type || 'text';
              return (
                <tr class="border-b border-gray-200">
                  <td class="px-2.5 py-2.5">
                    <div class="flex items-center gap-2 max-w-[280px] font-medium">
                      {fileUrl && <img src={fileUrl} alt="" class="w-8 h-8 object-cover rounded border border-gray-200" loading="lazy" />}
                      <span>{link.name}</span>
                    </div>
                  </td>
                  <td class="px-2.5 py-2.5"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{displayType}</span></td>
                  <td class="px-2.5 py-2.5 text-gray-500">{link.category || 'general'}</td>
                  <td class="px-2.5 py-2.5"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{link.zone}</span></td>
                  <td class="px-2.5 py-2.5 text-gray-500 text-xs">{link.banner_width || '-'}{link.banner_height ? `×${link.banner_height}` : ''}</td>
                  <td class="px-2.5 py-2.5"><b class="text-gray-900">{link.clicks || 0}</b></td>
                  <td class="px-2.5 py-2.5"><span class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold ${link.active ? 'bg-green-50 text-green-800' : 'bg-amber-50 text-amber-800'}`}>{link.active ? 'Active' : 'Paused'}</span></td>
                  <td class="px-2.5 py-2.5">
                    <div class="flex gap-1 flex-wrap">
                      <button class="px-2 py-0.5 text-xs rounded border border-green-200 text-green-800 bg-white hover:bg-green-50 transition-colors btn-edit"
                        data-id={link.id}
                        data-name={link.name}
                        data-description={link.description || ''}
                        data-url={link.url}
                        data-category={link.category || 'general'}
                        data-zone={link.zone}
                        data-display-type={displayType}
                        data-banner-width={link.banner_width || ''}
                        data-banner-height={link.banner_height || ''}
                        data-image-url={link.image_url || ''}
                        data-banner-html={link.banner_html || ''}>Edit</button>
                      <button class="px-2 py-0.5 text-xs rounded border border-gray-200 text-gray-600 bg-white hover:bg-gray-50 transition-colors" data-id={link.id} data-action="toggle">{link.active ? 'Pause' : 'Activate'}</button>
                      <button class="px-2 py-0.5 text-xs rounded border border-red-200 text-red-600 bg-white hover:bg-red-50 transition-colors" data-id={link.id} data-action="delete">Delete</button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.getElementById('affiliate-form') as HTMLFormElement;
  const heading = document.getElementById('form-heading') as HTMLHeadingElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const cancelBtn = document.getElementById('cancel-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('form-error') as HTMLParagraphElement;

  function setMode(mode: 'add' | 'edit', data?: Record<string, string>) {
    const actionInput = form.elements.namedItem('action') as HTMLInputElement;
    const idInput = form.elements.namedItem('id') as HTMLInputElement;
    if (mode === 'edit' && data) {
      heading.textContent = 'Edit Affiliate Link';
      submitBtn.textContent = 'Update Link';
      cancelBtn.hidden = false;
      actionInput.value = 'edit';
      idInput.value = data.id || '';
      (form.elements.namedItem('display_type') as HTMLSelectElement).value = data.displayType || 'text';
      (form.elements.namedItem('name') as HTMLInputElement).value = data.name || '';
      (form.elements.namedItem('description') as HTMLInputElement).value = data.description || '';
      (form.elements.namedItem('url') as HTMLInputElement).value = data.url || '';
      (form.elements.namedItem('category') as HTMLSelectElement).value = data.category || 'general';
      (form.elements.namedItem('zone') as HTMLSelectElement).value = data.zone || 'sidebar';
      (form.elements.namedItem('banner_width') as HTMLInputElement).value = data.bannerWidth || '';
      (form.elements.namedItem('banner_height') as HTMLInputElement).value = data.bannerHeight || '';
      (form.elements.namedItem('image_url') as HTMLInputElement).value = data.imageUrl || '';
      (form.elements.namedItem('banner_html') as HTMLTextAreaElement).value = data.bannerHtml || '';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      heading.textContent = 'Add New Affiliate Link';
      submitBtn.textContent = 'Add Link';
      cancelBtn.hidden = true;
      actionInput.value = 'add';
      idInput.value = '';
      form.reset();
    }
    errorEl.hidden = true;
    updateConditionalFields();
  }

  const displayTypeSelect = document.getElementById('display_type') as HTMLSelectElement;
  function updateConditionalFields() {
    const current = displayTypeSelect?.value || 'text';
    document.querySelectorAll<HTMLElement>('[data-show-when]').forEach((el) => {
      const want = el.dataset.showWhen;
      el.style.display = want === current ? '' : 'none';
    });
  }
  displayTypeSelect?.addEventListener('change', updateConditionalFields);
  updateConditionalFields();

  cancelBtn?.addEventListener('click', () => setMode('add'));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-50');
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Saving…';

    try {
      const fd = new FormData(form);
      const res = await fetch('/api/admin/affiliate-action', { method: 'POST', body: fd });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success !== false) {
        location.reload();
      } else {
        errorEl.textContent = data.error || 'Could not save affiliate link.';
        errorEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50');
        submitBtn.textContent = originalText;
      }
    } catch (err) {
      errorEl.textContent = 'Network error. Please try again.';
      errorEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-50');
      submitBtn.textContent = originalText;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach((btn) => {
    btn.addEventListener('click', () => {
      setMode('edit', {
        id: btn.dataset.id || '',
        name: btn.dataset.name || '',
        description: btn.dataset.description || '',
        url: btn.dataset.url || '',
        category: btn.dataset.category || 'general',
        zone: btn.dataset.zone || 'sidebar',
        displayType: btn.dataset.displayType || 'text',
        bannerWidth: btn.dataset.bannerWidth || '',
        bannerHeight: btn.dataset.bannerHeight || '',
        imageUrl: btn.dataset.imageUrl || '',
        bannerHtml: btn.dataset.bannerHtml || '',
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const action = btn.dataset.action;
      const id = btn.dataset.id;
      if (!action || !id) return;
      if (action === 'delete' && !confirm('Delete this affiliate link?')) return;
      const res = await fetch('/api/admin/affiliate-action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ linkId: id, action }),
      });
      if (res.ok) location.reload();
      else {
        const body = await res.json().catch(() => ({}));
        alert(body.error || 'Action failed.');
      }
    });
  });
</script>

<style>
  @media (max-width: 760px) {
    header { flex-direction: column; align-items: flex-start; }
  }
</style>
