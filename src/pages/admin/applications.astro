---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { listAdminApplications } from '../../services/jobService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const apps = await listAdminApplications(1, 100);
---
<Layout title="Admin Applications" description="Manage applications." canonicalUrl={Astro.url.href}>
  <main class="max-w-6xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-3 flex-wrap gap-3">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Applications</h1>
      <AdminNav current="applications" />
    </header>
    <div class="mb-3">
      <button id="csv" class="bg-green-800 text-white text-sm font-medium px-4 py-2 rounded-md hover:bg-green-900 transition-colors">Export CSV</button>
    </div>
    <div class="overflow-auto bg-white border border-gray-200 rounded-md">
      <table id="apps" class="w-full border-collapse text-xs">
        <thead>
          <tr>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Name</th>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Email</th>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Status</th>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Applied</th>
          </tr>
        </thead>
        <tbody>
          {apps.items.map((app: any) => (
            <tr class="border-b border-gray-200">
              <td class="px-2 py-2">{app.applicant_name || app.name}</td>
              <td class="px-2 py-2">{app.applicant_email || app.email}</td>
              <td class="px-2 py-2 text-gray-500">{app.status || 'pending'}</td>
              <td class="px-2 py-2 text-gray-500">{app.created?.slice(0, 10)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
</Layout>
<script>
  document.getElementById('csv')?.addEventListener('click', () => {
    const rows = [...document.querySelectorAll('#apps tr')].map(r =>
      [...r.children].map(c => `"${c.textContent}"`).join(',')
    ).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([rows], { type: 'text/csv' }));
    a.download = 'applications.csv';
    a.click();
  });
</script>
