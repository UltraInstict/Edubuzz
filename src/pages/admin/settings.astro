---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { listAdminSettings } from '../../services/jobService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const records = await listAdminSettings();
const getVal = (key: string) => records.find((s: any) => s.key === key)?.value ?? '';
---

<Layout title="Admin Settings" description="Edit site settings." canonicalUrl={Astro.url.href}>
  <main class="max-w-2xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-4">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Settings</h1>
      <AdminNav current="settings" />
    </header>

    <form id="settings-form" class="bg-white border border-gray-200 rounded-md p-5 space-y-4">
      <div>
        <label for="site_name" class="block text-sm font-medium text-gray-700 mb-1">Site name</label>
        <input id="site_name" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="site_name" value={getVal('site_name')} placeholder="Edubuzz" />
      </div>

      <div>
        <label for="tagline" class="block text-sm font-medium text-gray-700 mb-1">Tagline</label>
        <input id="tagline" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="tagline" value={getVal('tagline')} placeholder="South African jobs, updated daily." />
      </div>

      <div>
        <label for="adsense_publisher_id" class="block text-sm font-medium text-gray-700 mb-1">AdSense Publisher ID</label>
        <input id="adsense_publisher_id" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="adsense_publisher_id" value={getVal('adsense_publisher_id')} placeholder="ca-pub-XXXXXXXXXXXXXXXXXX" />
        <p class="text-xs text-gray-500 mt-1">Your Google AdSense publisher ID. Leave blank to disable ads.</p>
      </div>

      <div>
        <label for="jobs_per_page" class="block text-sm font-medium text-gray-700 mb-1">Jobs per page</label>
        <input id="jobs_per_page" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="number" name="jobs_per_page" value={getVal('jobs_per_page')} min="5" max="100" placeholder="20" />
      </div>

      <div>
        <label for="featured_listing_price" class="block text-sm font-medium text-gray-700 mb-1">Featured listing price (R)</label>
        <input id="featured_listing_price" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="number" name="featured_listing_price" value={getVal('featured_listing_price')} min="0" placeholder="299" />
        <p class="text-xs text-gray-500 mt-1">Price in ZAR charged for a featured listing.</p>
      </div>

      <div class="border-t border-gray-200 pt-4 mt-2">
        <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-2">Ad Configuration</h2>
        <p class="text-xs text-gray-500 mb-4">Monetization Engine uses these. AdSense is preferred when configured; otherwise affiliate campaigns or house ads are shown.</p>
      </div>

      <div>
        <label class="flex items-center gap-2.5 cursor-pointer">
          <span class="relative inline-flex items-center">
            <input type="checkbox" name="adsense_enabled" checked={getVal('adsense_enabled') === 'true'} class="peer sr-only" />
            <span class="w-[38px] h-5 bg-gray-300 rounded-full peer-checked:bg-green-800 transition-colors block"></span>
            <span class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full shadow-sm peer-checked:translate-x-[18px] transition-transform block"></span>
          </span>
          <span class="text-sm font-medium text-gray-700 select-none">AdSense enabled (master switch)</span>
        </label>
      </div>

      <div><label for="adsense_slot_strip" class="block text-sm font-medium text-gray-700 mb-1">AdSense Slot — Strip</label><input id="adsense_slot_strip" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="adsense_slot_strip" value={getVal('adsense_slot_strip')} placeholder="1234567890" /></div>
      <div><label for="adsense_slot_sidebar" class="block text-sm font-medium text-gray-700 mb-1">AdSense Slot — Sidebar</label><input id="adsense_slot_sidebar" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="adsense_slot_sidebar" value={getVal('adsense_slot_sidebar')} placeholder="0987654321" /></div>
      <div><label for="adsense_slot_infeed" class="block text-sm font-medium text-gray-700 mb-1">AdSense Slot — Infeed</label><input id="adsense_slot_infeed" class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="adsense_slot_infeed" value={getVal('adsense_slot_infeed')} placeholder="1122334455" /></div>

      <div>
        <label class="flex items-center gap-2.5 cursor-pointer">
          <span class="relative inline-flex items-center">
            <input type="checkbox" name="adsense_preview_mode" checked={getVal('adsense_preview_mode') === 'true'} class="peer sr-only" />
            <span class="w-[38px] h-5 bg-gray-300 rounded-full peer-checked:bg-green-800 transition-colors block"></span>
            <span class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full shadow-sm peer-checked:translate-x-[18px] transition-transform block"></span>
          </span>
          <span class="text-sm font-medium text-gray-700 select-none">Show ad placeholders (preview mode — disable before going live)</span>
        </label>
        <p class="text-xs text-gray-500 mt-1 ml-12">When enabled and no real AdSense ID is set, grey placeholder boxes show where ads will appear.</p>
      </div>

      <div class="border-t border-gray-200 pt-4 mt-2">
        <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-2">Other</h2>
      </div>

      <div>
        <label class="flex items-center gap-2.5 cursor-pointer">
          <span class="relative inline-flex items-center">
            <input type="checkbox" name="import_enabled" checked={getVal('import_enabled') === 'true'} class="peer sr-only" />
            <span class="w-[38px] h-5 bg-gray-300 rounded-full peer-checked:bg-green-800 transition-colors block"></span>
            <span class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full shadow-sm peer-checked:translate-x-[18px] transition-transform block"></span>
          </span>
          <span class="text-sm font-medium text-gray-700 select-none">Enable job import (CSV/XML feeds)</span>
        </label>
        <p class="text-xs text-gray-500 mt-1 ml-12">Requires <code class="bg-gray-100 px-1 py-0.5 rounded text-xs">admin_settings</code> collection in PocketBase. If saving fails, create the collection first — see <code class="bg-gray-100 px-1 py-0.5 rounded text-xs">POCKETBASE_SETUP.md</code>.</p>
      </div>

      <p id="message" hidden aria-live="polite" class="text-sm"></p>
      <button class="bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Save settings</button>
    </form>
  </main>
</Layout>

<script>
  document.getElementById('settings-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const fd = new FormData(form);
    const payload: Record<string, string> = {};
    fd.forEach((v, k) => { payload[k] = v as string; });

    const checkboxes = form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
    checkboxes.forEach((cb) => { payload[cb.name] = String(cb.checked); });

    try {
      const response = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const body = await response.json().catch(() => ({}));
      const okResponse = response.ok && body.success !== false;
      const message = document.getElementById('message') as HTMLParagraphElement;
      if (okResponse) {
        message.textContent = 'Settings saved.';
        message.className = 'text-sm text-green-800';
      } else {
        message.textContent = body.error || 'Could not save settings.';
        message.className = 'text-sm text-red-600';
      }
      message.hidden = false;
    } catch {
      const message = document.getElementById('message') as HTMLParagraphElement;
      message.textContent = 'Network error. Could not reach the server.';
      message.className = 'text-sm text-red-600';
      message.hidden = false;
    }
  });
</script>

<style>
  @media (max-width: 860px) {
    header { flex-direction: column; align-items: flex-start; }
  }
</style>
