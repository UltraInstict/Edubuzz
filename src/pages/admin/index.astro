---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { getAdminMetrics, listRecentJobs, listRecentApplications } from '../../services/jobService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const [metrics, recentJobList, recentAppList] = await Promise.all([
  getAdminMetrics(),
  listRecentJobs(5),
  listRecentApplications(5),
]);
const recentJobs = { items: recentJobList };
const recentApps = { items: recentAppList };
---

<Layout title="Admin Dashboard" description="Edubuzz admin dashboard." canonicalUrl={Astro.url.href}>
  <main class="max-w-6xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-4 gap-4">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Admin dashboard</h1>
      <AdminNav current="dashboard" />
    </header>

    <section class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 mb-4">
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{metrics.activeJobs}</b>
        <span class="text-sm text-gray-500">Active jobs</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{metrics.pendingJobs}</b>
        <span class="text-sm text-gray-500">Pending jobs</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{metrics.expiredJobs}</b>
        <span class="text-sm text-gray-500">Expired jobs</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{metrics.totalEmployers}</b>
        <span class="text-sm text-gray-500">Employers</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{metrics.applicationsToday}</b>
        <span class="text-sm text-gray-500">Applications today</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">{metrics.alertSubscribers}</b>
        <span class="text-sm text-gray-500">Alert subscribers</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5">
        <b class="block text-xl font-semibold text-gray-900">R{metrics.revenueThisMonth.toLocaleString('en-ZA')}</b>
        <span class="text-sm text-gray-500">Revenue this month</span>
      </div>
    </section>

    <section class="bg-white border border-gray-200 rounded-md p-5">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Recent activity</h2>
      <ul class="m-0 p-0 list-none space-y-1">
        {recentJobs.items.map((job: any) => <li class="text-sm text-gray-500">New job: {job.title} at {job.company}</li>)}
        {recentApps.items.map((app: any) => <li class="text-sm text-gray-500">Application: {app.name || 'Unknown'} for {(app.expand?.job?.title) || 'a job'}</li>)}
        {recentJobs.items.length === 0 && recentApps.items.length === 0 && <li class="text-sm text-gray-500">No recent activity.</li>}
      </ul>
    </section>
  </main>
</Layout>

<style>
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
