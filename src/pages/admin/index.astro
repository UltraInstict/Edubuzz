---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { getAdminMetrics, listRecentJobs, listRecentApplications } from '../../services/jobService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const [metrics, recentJobList, recentAppList] = await Promise.all([
  getAdminMetrics(),
  listRecentJobs(5),
  listRecentApplications(5),
]);
const recentJobs = { items: recentJobList };
const recentApps = { items: recentAppList };
---

<Layout title="Admin Dashboard" description="Edubuzz admin dashboard." canonicalUrl={Astro.url.href}>
  <main class="admin-wrap">
    <header>
      <h1>Admin dashboard</h1>
      <AdminNav current="dashboard" />
    </header>

    <section class="metrics">
      <div><b>{metrics.activeJobs}</b><span>Active jobs</span></div>
      <div><b>{metrics.pendingJobs}</b><span>Pending jobs</span></div>
      <div><b>{metrics.expiredJobs}</b><span>Expired jobs</span></div>
      <div><b>{metrics.totalEmployers}</b><span>Employers</span></div>
      <div><b>{metrics.applicationsToday}</b><span>Applications today</span></div>
      <div><b>{metrics.alertSubscribers}</b><span>Alert subscribers</span></div>
      <div><b>R{metrics.revenueThisMonth.toLocaleString('en-ZA')}</b><span>Revenue this month</span></div>
    </section>

    <section class="panel">
      <h2>Recent activity</h2>
      <ul>
        {recentJobs.items.map((job: any) => <li>New job: {job.title} at {job.company}</li>)}
        {recentApps.items.map((app: any) => <li>Application: {app.name || 'Unknown'} for {(app.expand?.job?.title) || 'a job'}</li>)}
        {recentJobs.items.length === 0 && recentApps.items.length === 0 && <li class="text-gray-500">No recent activity.</li>}
      </ul>
    </section>
  </main>
</Layout>

<style>
  .admin-wrap {
    max-width: 1100px;
    margin: 1.5rem auto;
    padding: 0 1.5rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    margin-bottom: 16px;
  }

  h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.3px;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 16px;
  }

  .metrics div {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 14px;
  }

  b {
    display: block;
    font-size: 20px;
    font-weight: 600;
  }

  span,
  li {
    color: #666666;
    font-size: 13px;
  }

  .panel {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 14px;
  }

  .panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }

  h2 {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .metrics {
      grid-template-columns: repeat(2, 1fr);
    }

    header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
