---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { requireAdmin } from '../../lib/auth';
import { listAdminAlerts } from '../../services/jobService';

const { redirect } = await requireAdmin(Astro.request);
if (redirect) return redirect;

const alerts = await listAdminAlerts(1, 100);
---
<Layout title="Admin Alerts" description="Manage job alerts." canonicalUrl={Astro.url.href}>
  <main class="max-w-6xl mx-auto px-6 py-6">
    <header class="flex justify-between items-center mb-3 flex-wrap gap-3">
      <h1 class="text-2xl font-bold text-gray-900 m-0">Alerts</h1>
      <AdminNav current="alerts" />
    </header>
    <div class="mb-3">
      <button id="send" class="bg-green-800 text-white text-sm font-medium px-4 py-2 rounded-md hover:bg-green-900 transition-colors">Send alerts now</button>
    </div>
    <div class="overflow-auto bg-white border border-gray-200 rounded-md">
      <table class="w-full border-collapse text-xs">
        <thead>
          <tr>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Email</th>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Keyword</th>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Province</th>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Category</th>
            <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Created</th>
          </tr>
        </thead>
        <tbody>
          {alerts.items.map((alert: any) => (
            <tr class="border-b border-gray-200">
              <td class="px-2 py-2">{alert.email}</td>
              <td class="px-2 py-2 text-gray-500">{alert.keyword || '\u2014'}</td>
              <td class="px-2 py-2 text-gray-500">{alert.province || '\u2014'}</td>
              <td class="px-2 py-2 text-gray-500">{alert.category || '\u2014'}</td>
              <td class="px-2 py-2 text-gray-500">{alert.created?.slice(0, 10)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
</Layout>
<script>
  document.getElementById('send')?.addEventListener('click', async () => {
    await fetch('/api/admin/send-alerts', { method: 'POST' });
    alert('Alert send triggered.');
  });
</script>
