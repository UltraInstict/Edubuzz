---
import Layout from '../../layouts/Layout.astro';
import { getAdminPB, requireAdmin } from '../../lib/auth';
const { redirect, user } = requireAdmin(Astro.request);
if (redirect) return redirect;
const pb = await getAdminPB();
const alerts = await pb.collection('alerts').getList(1, 100, { sort: '-created' }).catch(() => pb.collection('job_alerts').getList(1, 100, { sort: '-created' }).catch(() => ({ items: [] })));
---
<Layout title="Admin Alerts" description="Manage job alerts." canonicalUrl={Astro.url.href}>
<main class="admin-wrap"><header><h1>Alerts</h1><button id="send">Send alerts now</button></header><div class="table-wrap"><table><thead><tr><th>Email</th><th>Keyword</th><th>Province</th><th>Confirmed</th><th>Last sent</th></tr></thead><tbody>{alerts.items.map((alert:any)=><tr><td>{alert.email}</td><td>{alert.keyword}</td><td>{alert.province}</td><td>{alert.confirmed ? 'yes':'no'}</td><td>{alert.last_sent || '-'}</td></tr>)}</tbody></table></div></main>
</Layout>
<script>document.getElementById('send')?.addEventListener('click',async()=>{await fetch('/api/admin/send-alerts',{method:'POST'});alert('Alert send triggered.');});</script>
<style>.admin-wrap{max-width:1100px;margin:1.5rem auto;padding:0 1.5rem}header{display:flex;justify-content:space-between;margin-bottom:12px}h1{font-size:22px;margin:0;font-weight:600;letter-spacing:-0.3px}button{border:1px solid #2d6a4f;background:#2d6a4f;color:#fff;border-radius:4px;padding:8px 10px}.table-wrap{overflow:auto;background:#fff;border:1px solid #e0e0e0;border-radius:6px}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:8px;border-bottom:1px solid #f0f0f0;text-align:left}</style>
