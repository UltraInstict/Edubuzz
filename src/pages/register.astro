---
import Layout from '../layouts/Layout.astro';
import { generateToken } from '../lib/csrf';
const csrfToken = generateToken();
const serverError = Astro.url.searchParams.get('error') || '';
---

<Layout title="Create employer account" description="Register on Edubuzz" canonicalUrl="/register">
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>Create employer account</h1>
      <div id="error-msg" class="error-msg" aria-live="polite" hidden={!serverError}>{serverError}</div>
      <form id="reg-form" action="/api/auth/register" method="post">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <label>Name<input type="text" name="name" required autocomplete="name" /></label>
        <label>Email<input type="email" name="email" required autocomplete="email" /></label>
        <label>Password<input type="password" name="password" required minlength="8" autocomplete="new-password" /></label>
        <label>Company name<input type="text" name="company" required autocomplete="organization" /></label>
        <button type="submit" id="submit-btn">Create account</button>
        <p>Already registered? <a href="/login">Login</a></p>
      </form>
    </div>
  </div>
</Layout>

<script>
document.getElementById('reg-form').addEventListener('submit', async e => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  const err = document.getElementById('error-msg');
  btn.disabled = true; btn.textContent = 'Creating account\u2026'; err.hidden = true;
  const res = await fetch('/api/auth/register', { method: 'POST', body: new FormData(e.target) });
  const d = await res.json();
  if (d.success) { location.href = '/employer/dashboard'; }
  else {
    err.textContent = d.error; err.hidden = false;
    btn.disabled = false; btn.textContent = 'Create account';
  }
});
</script>

<style>
  .auth-wrap { max-width: 480px; margin: 3rem auto; padding: 0 1rem; }
  .auth-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 6px; padding: 2rem; }
  h1 { font-size: 20px; font-weight: 600; margin: 0 0 1.5rem; letter-spacing: -0.3px; }
  .error-msg { background: #fcebeb; border: 1px solid #f09595; border-radius: 4px; padding: 10px 14px; font-size: 13px; color: #a32d2d; margin-bottom: 1rem; }
  label { display: block; color: #444; font-size: 13px; margin-bottom: 4px; }
  input { width: 100%; border: 1px solid #ddd; border-radius: 4px; padding: 8px 10px; font-size: 14px; margin: 4px 0 14px; }
  input:focus { border-color: #2d6a4f; outline: none; }
  button { width: 100%; background: #2d6a4f; color: #fff; border: 0; border-radius: 4px; padding: 10px; font-size: 14px; font-weight: 500; cursor: pointer; }
  p { font-size: 13px; color: #666; text-align: center; margin-top: 1rem; }
  a { color: #2d6a4f; }
</style>
