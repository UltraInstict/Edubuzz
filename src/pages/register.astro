---
import Layout from '../layouts/Layout.astro';
import { generateToken } from '../lib/csrf';
const csrfToken = generateToken();
const serverError = Astro.url.searchParams.get('error') || '';
---

<Layout title="Create employer account" description="Register on Edubuzz" canonicalUrl="/register">
  <div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-white border border-gray-200 rounded-md p-8">
      <h1 class="text-2xl font-bold text-gray-900 mb-6">Create employer account</h1>
      <div id="error-msg" class="bg-red-50 border border-red-200 rounded-md p-3 text-sm text-red-800 mb-4" hidden={!serverError}>{serverError}</div>
      <form id="reg-form" action="/api/auth/register" method="post" class="space-y-4">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <input type="hidden" name="terms" value="1" />
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Name</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="name" required autocomplete="name" /></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Email</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="email" name="email" required autocomplete="email" /></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Password</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="password" name="password" required minlength="8" autocomplete="new-password" /></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Company name</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="company" required autocomplete="organization" /></div>
        <button type="submit" id="submit-btn" class="w-full bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Create account</button>
        <p class="text-sm text-gray-600 text-center">Already registered? <a href="/login" class="text-green-800 hover:text-green-900 hover:underline font-medium">Login</a></p>
      </form>
    </div>
  </div>
</Layout>

<script>
document.getElementById('reg-form').addEventListener('submit', async e => {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const btn = form.querySelector('button') as HTMLButtonElement;
  const err = document.getElementById('error-msg') as HTMLDivElement;
  btn.disabled = true; btn.textContent = 'Creating account...'; err.hidden = true;
  const res = await fetch('/api/auth/register', { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
  const d = await res.json().catch(() => ({}));
  if (d.success) { location.href = '/employer/dashboard'; }
  else { err.textContent = d.error || 'Could not create account.'; err.hidden = false; btn.disabled = false; btn.textContent = 'Create account'; }
});
</script>
