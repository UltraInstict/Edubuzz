---
import Layout from '../layouts/Layout.astro';
import { PROVINCES } from '../lib/pocketbase';
import { JOBS_PUBLIC } from '../lib/featureFlags';

// AdSense phase: province index → career guides (province hubs remain at
// /province/[slug] where [slug] is a hubSlug like gauteng-careers).
if (!JOBS_PUBLIC) {
  return Astro.redirect('/careers', 301);
}

const provinceSlug = (p: string) => p.toLowerCase().replace(/\s+/g, '-');
---

<Layout title="Browse Jobs by Province" description="Browse jobs across all nine South African provinces on Edubuzz." canonicalUrl={Astro.url.href}>
  <div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Browse by province</h1>
    <p class="text-sm text-gray-600 mb-6">Find jobs in your province across all sectors.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {PROVINCES.map(p => (
        <a href={`/province/${provinceSlug(p)}`} class="bg-white border border-gray-200 rounded-md p-5 hover:border-green-800 transition-colors block">
          <span class="text-base font-semibold text-gray-900">{p}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
