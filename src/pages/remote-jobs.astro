---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCategoriesWithCounts, PROVINCES } from '../lib/pocketbase';
import { listPseoJobs } from '../services/jobService';

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
const perPage = 20;
const [{ items: jobs, totalItems, totalPages }, categories] = await Promise.all([
  listPseoJobs({ jobType: 'Remote', terms: ['remote', 'work from home', 'wfh'], fields: ['title', 'description'], page, perPage }),
  getCategoriesWithCounts(),
]);

const topCategories = categories.filter(c => c.count > 0).sort((a, b) => (b.count || 0) - (a.count || 0)).slice(0, 8);

const summaryText = `Work from anywhere with ${totalItems.toLocaleString('en-ZA')} remote job opportunities in South Africa. Browse remote positions across IT, marketing, customer service, education and more.`;
---

<Layout
  title="Remote Jobs in South Africa | Work From Home Jobs"
  description={summaryText}
  canonicalUrl={page > 1 ? Astro.url.href : Astro.url.origin + Astro.url.pathname}
  prevPage={page > 1 ? `${Astro.url.origin}/remote-jobs?page=${Math.max(1, page - 1)}` : undefined}
  nextPage={page < totalPages ? `${Astro.url.origin}/remote-jobs?page=${page + 1}` : undefined}
>
  <div class="bg-white border-b border-gray-200 py-10 px-6">
    <div class="max-w-6xl mx-auto">
      <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gray-900">Home</a> &rsaquo; <span class="text-gray-900 font-medium">Remote Jobs</span>
      </nav>
      <h1 class="text-2xl font-semibold text-gray-900">Remote Jobs in South Africa</h1>
      <p class="text-gray-500 text-sm mt-2">{totalItems.toLocaleString('en-ZA')} work-from-home and remote positions</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <div>
      {totalItems > 0 ? (
        <>
          <section class="card p-5 mb-6">
            <h2 class="text-sm font-semibold text-gray-900 mb-2">Popular Remote Job Categories</h2>
            <div class="flex flex-wrap gap-2">
              {topCategories.map(cat => (
                <a href={`/category/${cat.slug}`} class="inline-flex items-center px-3 py-1.5 bg-green-50 text-green-800 text-xs font-medium rounded-full hover:bg-green-100 transition-colors">
                  {cat.name} ({cat.count})
                </a>
              ))}
              <a href="/categories" class="inline-flex items-center px-3 py-1.5 border border-gray-200 text-gray-500 text-xs font-medium rounded-full hover:border-green-800 hover:text-green-800 transition-colors">
                All categories &rarr;
              </a>
            </div>
          </section>
          <div class="space-y-3">
            {jobs.map(job => <JobCard job={job} />)}
          </div>
        </>
      ) : (
        <div class="card text-center py-12">
          <h2 class="text-lg font-semibold text-gray-900 mb-2">No remote jobs available</h2>
          <p class="text-gray-500 text-sm mb-4">Check back soon or browse all jobs.</p>
          <a href="/jobs" class="inline-flex items-center px-4 py-2 bg-green-800 text-white text-sm font-medium rounded-md hover:bg-green-900 transition-colors">Browse All Jobs</a>
        </div>
      )}

      {totalPages > 1 && (
        <div class="flex gap-1.5 mt-6 flex-wrap">
          {page > 1 && <a href={`/remote-jobs?page=${page-1}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-green-800 hover:border-green-800 hover:text-green-900 bg-white">Previous</a>}
          {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
            const p = i + 1;
            return <a href={`/remote-jobs?page=${p}`} class={`px-3 py-1.5 rounded-md text-sm border ${p === page ? 'border-green-800 bg-green-800 text-white font-semibold' : 'border-gray-200 text-green-800 hover:border-green-800 hover:text-green-900 bg-white'}`}>{p}</a>;
          })}
          {page < totalPages && <a href={`/remote-jobs?page=${page+1}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-sm text-green-800 hover:border-green-800 hover:text-green-900 bg-white">Next</a>}
        </div>
      )}
    </div>
    <aside class="hidden lg:block"><Sidebar /></aside>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Remote Jobs in South Africa',
    description: summaryText,
    url: `${Astro.url.origin}/remote-jobs`,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: jobs.map((job, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${Astro.url.origin}/job/${job.slug}`,
      })),
    },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What are the most common remote jobs in South Africa?', acceptedAnswer: { '@type': 'Answer', text: 'Remote jobs in South Africa span IT and software development, digital marketing, customer service, virtual assistance, online tutoring, and content writing. The tech sector has the highest concentration of work-from-home positions.' } },
      { '@type': 'Question', name: 'How do I apply for remote jobs on Edubuzz?', acceptedAnswer: { '@type': 'Answer', text: 'Browse our remote job listings above, click on any position to view details, and use the quick apply feature to submit your application. Many remote positions allow direct application through the employer\'s website.' } },
      { '@type': 'Question', name: 'Do remote jobs on Edubuzz require South African residency?', acceptedAnswer: { '@type': 'Answer', text: 'Most remote jobs listed on Edubuzz require applicants to be based in South Africa. Some positions may be open to international candidates — check individual job descriptions for location requirements.' } },
    ],
  })} />
</Layout>
es — check individual job descriptions for location requirements.' } },
    ],
  })} />
</Layout>
