---
import Layout from '../layouts/Layout.astro';
import { JOBS_PUBLIC } from '../lib/featureFlags';

// AdSense phase: job-listing pricing is not applicable. JOBS_PUBLIC=true
// restores this page when the job platform returns.
if (!JOBS_PUBLIC) {
  return Astro.redirect('/about', 301);
}
---

<Layout title="Pricing | Edubuzz" description="Simple, transparent pricing for job listings on Edubuzz. No subscriptions. Pay only when you post." canonicalUrl={Astro.url.href}>
  <div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Simple, transparent pricing</h1>
    <p class="text-sm text-gray-600 leading-relaxed mb-8">No hidden fees. No subscriptions. Pay only when you post.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
      <div class="bg-white border border-gray-200 rounded-md p-5 flex flex-col gap-3">
        <h2 class="text-base font-semibold text-gray-900">Basic</h2>
        <p class="text-2xl font-bold text-green-800">Free</p>
        <ul class="text-sm text-gray-600 space-y-1.5 mb-4">
          <li>30-day listing</li><li>Standard placement</li><li>Apply by email or URL</li>
        </ul>
        <a href="/post-job" class="mt-auto inline-block bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors text-center">Post for free</a>
      </div>
      <div class="bg-white border-2 border-green-800 rounded-md p-5 flex flex-col gap-3">
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mb-1">Most popular</p>
        <h2 class="text-base font-semibold text-gray-900">Featured</h2>
        <p class="text-2xl font-bold text-green-800">R299</p>
        <ul class="text-sm text-gray-600 space-y-1.5 mb-4">
          <li>60-day listing</li><li>Top of results</li><li>Featured badge</li><li>Included in job alert emails</li>
        </ul>
        <a href="/employer/upgrade" class="mt-auto inline-block bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors text-center">Post featured job</a>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5 flex flex-col gap-3">
        <h2 class="text-base font-semibold text-gray-900">Sponsored Strip</h2>
        <p class="text-2xl font-bold text-green-800">R499<span class="text-sm font-normal text-gray-400">/week</span></p>
        <ul class="text-sm text-gray-600 space-y-1.5 mb-4">
          <li>Banner across homepage</li><li>50,000+ impressions per week</li><li>Ideal for high-volume hiring</li>
        </ul>
        <a href="/contact" class="mt-auto inline-block border border-green-800 text-green-800 text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-50 transition-colors text-center">Enquire now</a>
      </div>
    </div>
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Frequently asked questions</h2>
    <div class="space-y-4">
      <div><h3 class="text-base font-semibold text-gray-900 mb-1">How long does my listing stay live?</h3><p class="text-sm text-gray-600 leading-relaxed">Basic listings are active for 30 days. Featured listings stay live for 60 days. You can renew anytime.</p></div>
      <div><h3 class="text-base font-semibold text-gray-900 mb-1">Can I edit my job after posting?</h3><p class="text-sm text-gray-600 leading-relaxed">Yes. You can update the description, salary, or requirements. Changes are reviewed and published within one business day.</p></div>
      <div><h3 class="text-base font-semibold text-gray-900 mb-1">How do job seekers apply?</h3><p class="text-sm text-gray-600 leading-relaxed">Applicants apply directly through the link or email address you provide when posting your job.</p></div>
      <div><h3 class="text-base font-semibold text-gray-900 mb-1">Do you offer invoicing?</h3><p class="text-sm text-gray-600 leading-relaxed">Yes. Contact us at <a href="mailto:hello@edubuzz.co.za" class="text-green-800 hover:text-green-900 hover:underline font-medium">Inquiries</a> for invoicing and bulk pricing for multiple listings.</p></div>
    </div>
  </div>
</Layout>
