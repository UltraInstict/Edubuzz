---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing | Edubuzz" description="Simple, transparent pricing for job listings on Edubuzz. No subscriptions. Pay only when you post." canonicalUrl={Astro.url.href}>
  <main class="content-page">
    <h1>Simple, transparent pricing</h1>
    <p class="intro">No hidden fees. No subscriptions. Pay only when you post.</p>

    <div class="tiers">
      <div class="tier">
        <h2>Basic</h2>
        <p class="price">Free</p>
        <ul>
          <li>30-day listing</li>
          <li>Standard placement</li>
          <li>Apply by email or URL</li>
        </ul>
        <a href="/post-job" class="primary-btn">Post for free</a>
      </div>
      <div class="tier featured">
        <span class="badge">Most popular</span>
        <h2>Featured</h2>
        <p class="price">R299</p>
        <ul>
          <li>60-day listing</li>
          <li>Top of results</li>
          <li>Featured badge</li>
          <li>Included in job alert emails</li>
        </ul>
        <a href="/employer/upgrade" class="primary-btn">Post featured job</a>
      </div>
      <div class="tier">
        <h2>Sponsored Strip</h2>
        <p class="price">R499<span>/week</span></p>
        <ul>
          <li>Banner across homepage</li>
          <li>50,000+ impressions per week</li>
          <li>Ideal for high-volume hiring</li>
        </ul>
        <a href="/contact" class="secondary-btn">Enquire now</a>
      </div>
    </div>

    <h2>Frequently asked questions</h2>
    <h3>How long does my listing stay live?</h3>
    <p>Basic listings are active for 30 days. Featured listings stay live for 60 days. You can renew anytime.</p>
    <h3>Can I edit my job after posting?</h3>
    <p>Yes. You can update the description, salary, or requirements. Changes are reviewed and published within one business day.</p>
    <h3>How do job seekers apply?</h3>
    <p>Applicants apply directly through the link or email address you provide when posting your job.</p>
    <h3>Do you offer invoicing?</h3>
    <p>Yes. Contact us at hello@edubuzz.co.za for invoicing and bulk pricing for multiple listings.</p>
  </main>
</Layout>

<style>
  .intro { color: #6b7280; font-size: var(--text-base); margin: 0 0 1.5rem; }
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem; }
  .tier { background: #fff; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; position: relative; }
  .tier.featured { border-color: #166534; border-width: 2px; }
  .badge { position: absolute; top: -10px; right: 12px; background: #166534; color: #fff; border-radius: 0.375rem; font-size: 0.75rem; font-weight: 600; padding: 2px 10px; }
  .tier h2 { margin: 0; font-size: 1.125rem; font-weight: 700; }
  .price { font-size: 1.5rem; font-weight: 700; color: #166534; margin: 0; }
  .price span { font-size: 0.875rem; font-weight: 400; color: #9ca3af; }
  .tier ul { padding-left: 1.125rem; color: #6b7280; font-size: 0.875rem; display: grid; gap: 0.3125rem; margin: 0; }
  .tier .primary-btn, .tier .secondary-btn { margin-top: auto; text-align: center; }
  @media (max-width: 760px) { .tiers { grid-template-columns: 1fr; } }
</style>
