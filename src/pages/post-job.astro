---
import Layout from '../layouts/Layout.astro';
import { getCategories, JOB_TYPES, PROVINCES } from '../lib/pocketbase';
import { generateToken } from '../lib/csrf';

const categories = await getCategories();
const csrfToken = generateToken();
---

<Layout
  title="Post a Job"
  description="Reach thousands of South African job seekers. Basic listings are free. Featured listings from R299."
  canonicalUrl={Astro.url.href}
>
  <div class="hero">
    <div class="container">
      <h1>Post a job on Edubuzz</h1>
      <p>Reach thousands of South African job seekers. Basic listings are free. Featured listings from R299.</p>
    </div>
  </div>

  <div class="post-grid">
    <main class="panel">
      <form id="post-job-form">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <div class="field-grid">
          <label>Employer name <input class="form-field" type="text" name="employer_name" required /></label>
          <label>Employer email <input class="form-field" type="email" name="employer_email" required /></label>
        </div>
        <div class="field-grid">
          <label>Company name <input class="form-field" type="text" name="company" required /></label>
          <label>Job title <input class="form-field" type="text" name="title" required /></label>
        </div>
        <div class="field-grid">
          <label>
            Category
            <select class="form-field" name="category">
              <option value="">Select category</option>
              {categories.map((cat) => <option value={cat.name}>{cat.name}</option>)}
            </select>
          </label>
          <label>
            Province
            <select class="form-field" name="province" required>
              <option value="">Select province</option>
              {PROVINCES.map((province) => <option value={province}>{province}</option>)}
            </select>
          </label>
        </div>
        <div class="field-grid">
          <label>City <input class="form-field" type="text" name="city" /></label>
          <label>
            Job type
            <select class="form-field" name="job_type" required>
              <option value="">Select type</option>
              {JOB_TYPES.map((type) => <option value={type}>{type}</option>)}
            </select>
          </label>
        </div>
        <div class="salary-grid">
          <label>Salary min <span><b>R</b><input class="form-field" type="number" name="salary_min" min="0" /></span></label>
          <label>Salary max <span><b>R</b><input class="form-field" type="number" name="salary_max" min="0" /></span></label>
        </div>
        <fieldset>
          <legend>Application method</legend>
          <label><input type="radio" name="application_method" value="email" checked /> Email</label>
          <label><input type="radio" name="application_method" value="url" /> URL</label>
        </fieldset>
        <div class="field-grid">
          <label data-method="email">Apply email <input class="form-field" type="email" name="apply_email" /></label>
          <label data-method="url" hidden>Apply URL <input class="form-field" type="url" name="apply_url" placeholder="https://" /></label>
        </div>
        <label>
          Job description
          <textarea id="description-field" class="form-field" name="description" rows="10" required></textarea>
        </label>
        <div class="listing-type-row">
          <label><input type="radio" name="listing_type" value="basic" /> Basic listing &mdash; Free (30 days, standard placement)</label>
          <label><input type="radio" name="listing_type" value="featured" checked /> Featured listing &mdash; R299 (60 days, top of results, Featured badge)</label>
        </div>
        <div class="actions">
          <button type="button" id="draft-btn" class="secondary-btn">Save as draft</button>
          <button type="submit" id="post-btn" class="primary-btn">Post Job &mdash; R299</button>
        </div>
        <p id="post-message" hidden></p>
      </form>
    </main>

    <aside class="pricing-card">
      <div>
        <h2>Basic listing</h2>
        <strong>Free</strong>
        <p>Active 30 days</p>
        <p>Standard placement</p>
      </div>
      <div class="selected">
        <h2>Featured listing</h2>
        <strong>R299</strong>
        <p>Active 60 days</p>
        <p>Top of results</p>
        <p>Bold title</p>
        <p>"Featured" badge</p>
        <p>Included in job alerts</p>
      </div>
      <div>
        <h2>Sponsored strip</h2>
        <strong>R499/week</strong>
        <p>Banner across homepage</p>
        <p>50,000+ impressions</p>
      </div>
    </aside>
  </div>
</Layout>

<script>
  const form = document.getElementById('post-job-form') as HTMLFormElement;
  const message = document.getElementById('post-message') as HTMLParagraphElement;
  const postBtn = document.getElementById('post-btn') as HTMLButtonElement;

  form?.addEventListener('change', (event) => {
    const target = event.target as HTMLInputElement;
    if (target.name === 'application_method') {
      document.querySelector('[data-method="email"]')?.toggleAttribute('hidden', target.value !== 'email');
      document.querySelector('[data-method="url"]')?.toggleAttribute('hidden', target.value !== 'url');
    }
    if (target.name === 'listing_type') {
      postBtn.textContent = target.value === 'basic' ? 'Post Job \u2014 Free' : 'Post Job \u2014 R299';
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    message.hidden = true;
    const response = await fetch('/api/post-job', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(form))),
    });
    const body = await response.json().catch(() => ({}));
    message.textContent = response.ok ? 'Job submitted for review.' : (body.message || 'Could not submit job.');
    message.hidden = false;
    if (response.ok) form.reset();
  });

  document.getElementById('draft-btn')?.addEventListener('click', () => {
    const data = Object.fromEntries(new FormData(form));
    localStorage.setItem('edubuzz_job_draft', JSON.stringify(data));
    message.textContent = 'Draft saved locally.';
    message.hidden = false;
  });

  const saved = localStorage.getItem('edubuzz_job_draft');
  if (saved) {
    try {
      const draft = JSON.parse(saved);
      Object.entries(draft).forEach(([key, value]) => {
        const input = form.querySelector(`[name="${key}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
        if (input) input.value = value as string;
      });
    } catch {}
  }
</script>

<style>
  .hero { background: #fff; border-bottom: 1px solid #e5e7eb; padding: 1.5rem 0; }
  .hero h1 { margin: 0; color: #111827; font-size: 1.875rem; font-weight: 700; letter-spacing: -0.02em; }
  .hero p { margin: 0.25rem 0 0; color: #6b7280; font-size: 1rem; }
  .post-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 1rem; max-width: 1100px; margin: 1.5rem auto; padding: 0 1.5rem; }
  form { display: grid; gap: 0.875rem; }
  label { display: grid; gap: 0.25rem; color: #6b7280; font-size: 0.75rem; font-weight: 500; }
  .field-grid, .salary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .salary-grid span { display: flex; align-items: center; gap: 0.375rem; }
  .salary-grid b { color: #6b7280; font-weight: 500; }
  .listing-type-row { display: flex; flex-direction: column; gap: 0.375rem; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.5625rem 0.625rem; }
  .listing-type-row label { display: flex; align-items: center; gap: 0.375rem; font-size: 0.875rem; }
  .actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .pricing-card { display: grid; gap: 0.75rem; align-self: start; }
  .pricing-card > div { background: #fff; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 1rem 1.25rem; }
  .pricing-card .selected { border: 2px solid #166534; }
  .pricing-card h2 { margin: 0 0 0.25rem; font-size: 0.875rem; font-weight: 600; }
  .pricing-card strong { display: block; margin-bottom: 0.5rem; color: #166534; font-size: 0.875rem; font-weight: 600; }
  .pricing-card p, #post-message { margin: 0; color: #6b7280; font-size: 0.875rem; }
  @media (max-width: 860px) { .post-grid { grid-template-columns: 1fr; padding: 0 1rem; } }
  @media (max-width: 560px) { .field-grid, .salary-grid { grid-template-columns: 1fr; } }
</style>
