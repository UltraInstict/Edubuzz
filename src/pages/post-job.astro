---
import Layout from '../layouts/Layout.astro';
import { getCategories, JOB_TYPES, PROVINCES } from '../lib/pocketbase';
import { generateToken } from '../lib/csrf';
import { JOBS_PUBLIC } from '../lib/featureFlags';

// AdSense phase: job posting hidden from public nav. The employer dashboard
// route (/employer/post-job) and API remain fully operational.
if (!JOBS_PUBLIC) {
  return Astro.redirect('/companies', 301);
}

const categories = await getCategories();
const csrfToken = generateToken();
---

<Layout title="Post a Job" description="Reach thousands of South African job seekers. Basic listings are free. Featured listings from R299." canonicalUrl={Astro.url.href} noLeaderboard>
  <div class="bg-white border-b border-gray-200 py-8">
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Post a job on Edubuzz</h1>
      <p class="text-sm text-gray-600 leading-relaxed">Reach thousands of South African job seekers. Basic listings are free. Featured listings from R299.</p>
    </div>
  </div>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_240px] gap-6">
      <form id="post-job-form" class="space-y-5">
        <input type="hidden" name="_csrf" value={csrfToken} />
        <div class="grid grid-cols-2 gap-4">
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Employer name</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="employer_name" required /></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Employer email</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="email" name="employer_email" required /></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Company name</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="company" required /></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Job title</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="title" required /></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Category</label><select class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="category"><option value="">Select category</option>{categories.map(c => <option value={c.name}>{c.name}</option>)}</select></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Province</label><select class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="province" required><option value="">Select province</option>{PROVINCES.map(p => <option value={p}>{p}</option>)}</select></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="block text-sm font-medium text-gray-700 mb-1">City</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="city" /></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Job type</label><select class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="job_type" required><option value="">Select type</option>{JOB_TYPES.map(t => <option value={t}>{t}</option>)}</select></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Salary min</label><div class="flex items-center gap-2"><span class="text-sm text-gray-500">R</span><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="number" name="salary_min" min="0" /></div></div>
          <div><label class="block text-sm font-medium text-gray-700 mb-1">Salary max</label><div class="flex items-center gap-2"><span class="text-sm text-gray-500">R</span><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="number" name="salary_max" min="0" /></div></div>
        </div>
        <fieldset class="border border-gray-200 rounded-md p-3">
          <legend class="text-sm font-medium text-gray-700 mb-2">Application method</legend>
          <div class="flex gap-4">
            <label class="flex items-center gap-1.5 text-sm text-gray-600"><input type="radio" name="application_method" value="email" checked /> Email</label>
            <label class="flex items-center gap-1.5 text-sm text-gray-600"><input type="radio" name="application_method" value="url" /> URL</label>
          </div>
        </fieldset>
        <div class="grid grid-cols-2 gap-4">
          <div data-method="email"><label class="block text-sm font-medium text-gray-700 mb-1">Apply email</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="email" name="apply_email" /></div>
          <div data-method="url" hidden><label class="block text-sm font-medium text-gray-700 mb-1">Apply URL</label><input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="url" name="apply_url" placeholder="https://" /></div>
        </div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Job description</label><textarea class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="description" rows="10" required></textarea></div>
        <div class="border border-gray-200 rounded-md p-3 space-y-2">
          <label class="flex items-center gap-2 text-sm text-gray-600"><input type="radio" name="listing_type" value="basic" /> Basic listing — Free (30 days, standard placement)</label>
          <label class="flex items-center gap-2 text-sm text-gray-600"><input type="radio" name="listing_type" value="featured" checked /> Featured listing — R299 (60 days, top of results, Featured badge)</label>
        </div>
        <div class="flex gap-3">
          <button type="button" id="draft-btn" class="inline-block border border-green-800 text-green-800 text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-50 transition-colors">Save as draft</button>
          <button type="submit" id="post-btn" class="inline-block bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Post Job — R299</button>
        </div>
        <p id="post-message" hidden class="text-sm"></p>
      </form>
      <aside class="space-y-3">
        <div class="bg-white border border-gray-200 rounded-md p-5"><h3 class="text-sm font-semibold text-gray-900 mb-1">Basic listing</h3><p class="text-lg font-bold text-green-800">Free</p><p class="text-xs text-gray-500">Active 30 days · Standard placement</p></div>
        <div class="bg-white border-2 border-green-800 rounded-md p-5"><h3 class="text-sm font-semibold text-gray-900 mb-1">Featured listing</h3><p class="text-lg font-bold text-green-800">R299</p><p class="text-xs text-gray-500">Active 60 days · Top of results · Featured badge · Job alerts</p></div>
        <div class="bg-white border border-gray-200 rounded-md p-5"><h3 class="text-sm font-semibold text-gray-900 mb-1">Sponsored strip</h3><p class="text-lg font-bold text-green-800">R499/week</p><p class="text-xs text-gray-500">Banner across homepage · 50,000+ impressions</p></div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('post-job-form') as HTMLFormElement;
  const message = document.getElementById('post-message') as HTMLParagraphElement;
  const postBtn = document.getElementById('post-btn') as HTMLButtonElement;
  form?.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'application_method') { document.querySelector('[data-method="email"]')?.toggleAttribute('hidden', t.value !== 'email'); document.querySelector('[data-method="url"]')?.toggleAttribute('hidden', t.value !== 'url'); }
    if (t.name === 'listing_type') postBtn.textContent = t.value === 'basic' ? 'Post Job — Free' : 'Post Job — R299';
  });
  form?.addEventListener('submit', async (e) => {
    e.preventDefault(); message.hidden = true;
    const res = await fetch('/api/post-job', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
    const body = await res.json().catch(() => ({}));
    message.textContent = res.ok ? 'Job submitted for review.' : (body.message || 'Could not submit job.'); message.hidden = false;
    if (res.ok) form.reset();
  });
  document.getElementById('draft-btn')?.addEventListener('click', () => { localStorage.setItem('edubuzz_job_draft', JSON.stringify(Object.fromEntries(new FormData(form)))); message.textContent = 'Draft saved locally.'; message.hidden = false; });
  const saved = localStorage.getItem('edubuzz_job_draft');
  if (saved) try { const draft = JSON.parse(saved); Object.entries(draft).forEach(([k,v]) => { const i = form.querySelector(`[name="${k}"]`) as HTMLInputElement; if (i) i.value = v as string; }); } catch {}
</script>
