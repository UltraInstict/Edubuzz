---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Edubuzz" description="Edubuzz is a South African education and career information site helping people understand what to study, which careers exist and how to enter them." canonicalUrl={Astro.url.href}>
  <div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">About Edubuzz</h1>
    <p class="text-sm text-gray-600 leading-relaxed mb-4">Edubuzz is a South African education and career information website. We help school leavers, students and job seekers understand what to study, which careers exist, how to enter them, what they pay, and how to apply — in plain language.</p>
    <p class="text-sm text-gray-600 leading-relaxed mb-4">Our guides cover TVET colleges, universities, NSFAS funding, NATED programmes, career pathways, salary expectations and employer information — written specifically for South Africans.</p>
    <p class="text-sm text-gray-600 leading-relaxed mb-8">Our content is researched and original. We do not invent salary figures or requirements, and we always point you to official sources where you should confirm current details.</p>
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Our mission</h2>
    <p class="text-sm text-gray-600 leading-relaxed mb-6">To help South Africans make informed education and career decisions — regardless of where they live or what device they use.</p>
    <div class="flex gap-3 flex-wrap mt-6">
      <a href="/education" class="inline-block bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Education guides</a>
      <a href="/careers" class="inline-block border border-green-800 text-green-800 text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-50 transition-colors">Career guides</a>
    </div>
  </div>
</Layout>
