---
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../components/JobCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import MonetizationSlot from '../../components/MonetizationSlot.astro';
import { INDUSTRY_HUBS } from '../../content/industry-hubs';
import { SALARY_GUIDES } from '../../content/salary-guides';
import { ARTICLES } from '../../content/resources';
import { PROVINCE_HUBS } from '../../content/province-hubs';
import { getJobs, getEmployers } from '../../lib/pocketbase';
import { SITE_URL } from '../../lib/constants';

const { slug } = Astro.params;
const hub = INDUSTRY_HUBS.find(h => h.slug === slug);
if (!hub) return Astro.redirect('/404');

// Live data
let jobs: any[] = [];
let totalItems = 0;
if (hub.categorySlug) {
  const res = await getJobs({ category: hub.categorySlug, perPage: 6 });
  jobs = res.items;
  totalItems = res.totalItems;
}
const employersResult = await getEmployers({ perPage: 8 }).catch(() => ({ items: [] as any[] }));
const employers = (employersResult as any).items || [];

// Related content resolved from slugs
const salaryPicks = hub.salarySlugs.map(s => SALARY_GUIDES.find(g => g.slug === s)).filter(Boolean) as any[];
const articlePicks = hub.resourceSlugs.map(s => ARTICLES.find(a => a.slug === s)).filter(Boolean) as any[];

const canonical = `${SITE_URL}/industry/${hub.slug}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: `${SITE_URL}/industry/${hub.slug}` },
    { '@type': 'ListItem', position: 3, name: `${hub.name} Careers` },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Careers in ${hub.name} in South Africa`,
  description: hub.description,
  dateModified: '2026-07-01',
  datePublished: '2026-07-01',
  author: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'Edubuzz', url: SITE_URL },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hub.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={hub.title} description={hub.description} canonicalUrl={canonical} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <main>
      <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gray-900">Home</a> &rsaquo;
        <a href="/categories" class="hover:text-gray-900">Industries</a> &rsaquo;
        <span class="text-gray-900 font-medium">{hub.name} Careers</span>
      </nav>

      <header class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Careers in {hub.name} in South Africa</h1>
        {totalItems > 0 && <p class="text-sm text-gray-500">{totalItems.toLocaleString()} live {hub.name.toLowerCase()} jobs on Edubuzz</p>}
      </header>

      <MonetizationSlot zone="content-top" />

      <section class="prose prose-sm max-w-none prose-p:text-gray-700 mb-8" set:html={hub.overview} />

      <!-- Salary range -->
      <div class="bg-green-50 border border-green-200 rounded-md p-4 mb-8">
        <h2 class="text-sm font-semibold text-green-900 mb-1">Typical salary range</h2>
        <p class="text-sm text-green-900">{hub.salaryRange}</p>
      </div>

      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Qualifications &amp; requirements</h2>
        <div class="prose prose-sm max-w-none prose-li:text-gray-700" set:html={hub.qualifications} />
      </section>

      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Entry-level routes</h2>
        <div class="prose prose-sm max-w-none prose-p:text-gray-700" set:html={hub.entryRoutes} />
        <div class="flex flex-wrap gap-2 mt-3">
          <a href="/learnerships" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">Learnerships</a>
          <a href="/internships" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">Internships</a>
          <a href="/graduate-jobs" class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">Graduate Jobs</a>
        </div>
      </section>

      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Career progression</h2>
        <div class="prose prose-sm max-w-none prose-p:text-gray-700" set:html={hub.progression} />
      </section>

      <MonetizationSlot zone="in-content" />

      <!-- Live jobs -->
      {jobs.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Latest {hub.name} jobs</h2>
          <div class="space-y-3">
            {jobs.map(job => <JobCard job={job} />)}
          </div>
          {hub.categorySlug && (
            <a href={`/category/${hub.categorySlug}`} class="inline-block mt-3 text-sm text-green-800 hover:underline font-medium">View all {hub.name.toLowerCase()} jobs &rarr;</a>
          )}
        </section>
      )}

      <!-- Related salary guides -->
      {salaryPicks.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">{hub.name} salary guides</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {salaryPicks.map(g => (
              <a href={`/salary/${g.slug}`} class="border border-gray-200 rounded-md p-3 hover:border-green-800">
                <span class="text-sm font-semibold text-gray-900">{g.occupation}</span>
                <span class="block text-xs text-green-800">{g.averageSalary}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Related resources -->
      {articlePicks.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Helpful guides</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {articlePicks.map(a => (
              <a href={`/resources/${a.slug}`} class="border border-gray-200 rounded-md p-3 hover:border-green-800">
                <span class="text-sm font-semibold text-gray-900">{a.h1}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Companies hiring -->
      {employers.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Companies on Edubuzz</h2>
          <div class="flex flex-wrap gap-2">
            {employers.map((emp: any) => (
              <a href={`/company/${emp.company_slug}`} class="inline-block px-3 py-1.5 bg-green-50 border border-green-200 rounded-full text-xs text-green-800 hover:bg-green-100">{emp.company_name}</a>
            ))}
          </div>
        </section>
      )}

      <!-- FAQ -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {hub.faqs.map(faq => (
            <details class="border border-gray-200 rounded-md p-4 group">
              <summary class="font-medium text-sm text-gray-900 cursor-pointer group-open:mb-2">{faq.q}</summary>
              <p class="text-sm text-gray-600 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Other industries -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Explore other industries</h2>
        <div class="flex flex-wrap gap-2">
          {INDUSTRY_HUBS.filter(i => i.slug !== hub.slug).map(i => (
            <a href={`/industry/${i.slug}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">{i.name}</a>
          ))}
        </div>
      </section>

      <!-- Province hubs -->
      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">Careers by province</h2>
        <div class="flex flex-wrap gap-2">
          {PROVINCE_HUBS.map(p => (
            <a href={`/province/${p.hubSlug}`} class="px-3 py-1.5 border border-gray-200 rounded-md text-xs text-green-800 hover:border-green-800">{p.name}</a>
          ))}
        </div>
      </section>

      <MonetizationSlot zone="content-bottom" />
    </main>

    <aside class="hidden lg:block"><Sidebar /></aside>
  </div>
</Layout>
