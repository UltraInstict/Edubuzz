---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { INDUSTRY_HUBS } from '../../content/industry-hubs';
import { SITE_URL } from '../../lib/constants';
---
<Layout title="Careers by Industry in South Africa" description="Explore career areas, qualifications and entry routes across South African industries." canonicalUrl={SITE_URL + '/industry'} adsEligible={true}>
<main class="shell"><header class="collection-intro"><span class="eyebrow">CAREER DISCOVERY / INDUSTRIES</span><h1>A world of work<br />worth exploring.</h1><p>From healthcare to engineering, get to know the industries behind everyday life. Explore the work, the qualifications and the different ways to get started.</p></header><div class="editorial-grid" style="padding-bottom:65px">{INDUSTRY_HUBS.map(h => <GuideCard href={'/industry/' + h.slug} title={h.name} description={h.description} label="Industry guide" />)}</div></main></Layout>
