---
import Layout from '../../layouts/Layout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { CAREER_GUIDES } from '../../content/career-guides';
import { SITE_URL } from '../../lib/constants';
---
<Layout title="Career pathways in South Africa" description="Discover what the work involves, what to study and how to get started. Your future has more than one route." canonicalUrl={SITE_URL + '/careers'} adsEligible={true}>
<main class="shell">
<header class="collection-intro"><span class="eyebrow">CAREERS / YOUR NEXT CHAPTER</span><h1>Turn your curiosity into a career.</h1><p>Discover what the work involves, what to study and how to get started. Your future has more than one route.</p></header>
<div class="editorial-grid" style="padding-bottom:65px">{CAREER_GUIDES.map(g => <GuideCard href={'/careers/' + g.slug} title={g.h1} description={g.description} label="Career pathways" readMins={g.readMins} />)}</div>
<section class="feature-banner" style="margin-bottom:65px"><div><span class="eyebrow">KEEP EXPLORING</span><h2>Get ready to take the next step.</h2><p>Prepare your CV, understand applications and approach interviews with more confidence.</p><a class="button-primary" href="/resources">Explore resources ↗</a></div><span class="banner-art" aria-hidden="true">↗</span></section>
</main></Layout>
