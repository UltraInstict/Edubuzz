---
import Layout from '../../../layouts/Layout.astro';
import { getUser } from '../../../lib/auth';
import { getEmployerByUserId, getJobForEmployer } from '../../../services/jobService';
import { getCategories, JOB_TYPES, PROVINCES } from '../../../lib/pocketbase';
const user = await getUser(Astro.request);
if (!user) return Astro.redirect('/login?next=' + Astro.url.pathname);
const employer = await getEmployerByUserId((user as any).id);
if (!employer) return Astro.redirect('/register');
const job = await getJobForEmployer(Astro.params.id || '', employer.id);
if (!job) return new Response('Not found', { status: 404 });
const categories = await getCategories();
---
<Layout title={`Edit ${job.title}`} description="Edit a job listing." canonicalUrl={Astro.url.href}>
<main class="max-w-2xl mx-auto px-6 py-6">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">Edit job</h1>
  <form id="job-form" class="grid gap-3">
    <input type="hidden" name="id" value={job.id}/><input type="hidden" name="company" value={job.company}/>
    <label class="grid gap-1 text-xs font-medium text-gray-700">Job title <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="title" value={job.title} required /></label>
    <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1"><label class="grid gap-1 text-xs font-medium text-gray-700">Category <select class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="category">{categories.map((c: any) => <option value={c.name} selected={c.name===job.category}>{c.name}</option>)}</select></label><label class="grid gap-1 text-xs font-medium text-gray-700">Province <select class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="province" required>{PROVINCES.map((p: string) => <option value={p} selected={p===job.province}>{p}</option>)}</select></label></div>
    <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1"><label class="grid gap-1 text-xs font-medium text-gray-700">City <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="city" value={job.city} /></label><label class="grid gap-1 text-xs font-medium text-gray-700">Job type <select class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="job_type" required>{JOB_TYPES.map((t: string) => <option value={t} selected={t===job.job_type}>{t}</option>)}</select></label></div>
    <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1"><label class="grid gap-1 text-xs font-medium text-gray-700">Salary min <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="number" name="salary_min" value={job.salary_min} /></label><label class="grid gap-1 text-xs font-medium text-gray-700">Salary max <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="number" name="salary_max" value={job.salary_max} /></label></div>
    <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1"><label class="grid gap-1 text-xs font-medium text-gray-700">Apply email <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="email" name="apply_email" value={job.apply_email} /></label><label class="grid gap-1 text-xs font-medium text-gray-700">Apply URL <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="url" name="apply_url" value={job.apply_url} /></label></div>
    <label class="grid gap-1 text-xs font-medium text-gray-700">Description <textarea class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="description" rows="10" required>{job.description}</textarea></label>
    <p id="message" hidden aria-live="polite"></p>
    <button class="border border-green-800 bg-green-800 text-white rounded px-4 py-2.5 text-sm font-semibold w-fit">Save changes</button>
  </form>
</main>
</Layout>
<script>document.getElementById('job-form')?.addEventListener('submit',async(e)=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const res=await fetch('/api/employer/save-job',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form)))});const msg=document.getElementById('message') as HTMLParagraphElement;msg.textContent=res.ok?'Changes saved and sent for review.':'Could not save job.';msg.hidden=false;});</script>
