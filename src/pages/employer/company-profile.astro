---
import Layout from '../../layouts/Layout.astro';
import { getUser } from '../../lib/auth';
import { getEmployerByUserId } from '../../services/jobService';
import { PROVINCES } from '../../lib/pocketbase';
import { generateToken } from '../../lib/csrf';
const user = await getUser(Astro.request);
if (!user) return Astro.redirect('/login?next=' + Astro.url.pathname);
const employer = await getEmployerByUserId((user as any).id);
if (!employer) return Astro.redirect('/register');
const csrfToken = generateToken();
---
<Layout title="Company Profile" description="Edit your public company profile." canonicalUrl={Astro.url.href}>
<main class="max-w-2xl mx-auto px-6 py-6">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">Company profile</h1>
  <form id="profile-form" enctype="multipart/form-data" class="grid gap-3">
    <input type="hidden" name="_csrf" value={csrfToken} />
    <label class="grid gap-1 text-xs font-medium text-gray-700">Company name <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="company_name" value={employer.company_name} required /></label>
    <label class="grid gap-1 text-xs font-medium text-gray-700">Slug <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="company_slug" value={employer.company_slug} required /></label>
    <label class="grid gap-1 text-xs font-medium text-gray-700">Website <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="website" value={employer.website} placeholder="https://" /></label>
    <label class="grid gap-1 text-xs font-medium text-gray-700">Description <textarea class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="description" rows="6">{employer.description}</textarea></label>
    <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1"><label class="grid gap-1 text-xs font-medium text-gray-700">Province <select class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="province"><option value="">Select province</option>{PROVINCES.map((p: string) => <option value={p} selected={p===employer.province}>{p}</option>)}</select></label><label class="grid gap-1 text-xs font-medium text-gray-700">City <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="city" value={employer.city} /></label></div>
    <label class="grid gap-1 text-xs font-medium text-gray-700">Logo <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="file" name="logo" accept="image/*" /></label>
    <p id="message" hidden aria-live="polite"></p>
    <button class="border border-green-800 bg-green-800 text-white rounded px-4 py-2.5 text-sm font-semibold w-fit">Save profile</button>
  </form>
</main>
</Layout>
<script>document.getElementById('profile-form')?.addEventListener('submit',async(e)=>{e.preventDefault();const res=await fetch('/api/employer/company-profile',{method:'POST',body:new FormData(e.currentTarget as HTMLFormElement)});const msg=document.getElementById('message') as HTMLParagraphElement;msg.textContent=res.ok?'Profile saved.':'Could not save profile.';msg.hidden=false;});</script>
