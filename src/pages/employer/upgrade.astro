---
import Layout from '../../layouts/Layout.astro';
import { getUser } from '../../lib/auth';
const user = await getUser(Astro.request);
if (!user) return Astro.redirect('/login?next=' + Astro.url.pathname);
const jobId = Astro.url.searchParams.get('job') || '';
---
<Layout title="Upgrade Listing" description="Boost a job listing on Edubuzz." canonicalUrl={Astro.url.href}>
<main class="max-w-3xl mx-auto px-6 py-6">
  <h1 class="text-2xl font-bold text-gray-900 mb-3">Upgrade your listing</h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
    <div class="bg-white border border-gray-200 rounded-md p-4">
      <h2 class="text-sm font-semibold text-gray-900 mb-1">Basic</h2>
      <b class="text-green-800 text-lg">Free</b>
      <p class="text-sm text-gray-600">Standard listing</p>
    </div>
    <div class="bg-white border-2 border-green-800 rounded-md p-4">
      <h2 class="text-sm font-semibold text-gray-900 mb-1">Featured</h2>
      <b class="text-green-800 text-lg">R299</b>
      <p class="text-sm text-gray-600">Top of results for 60 days</p>
      <form method="post" action="/api/payments/initiate">
        <input type="hidden" name="jobId" value={jobId}/>
        <button class="border border-green-800 bg-green-800 text-white rounded px-3 py-2 text-sm font-semibold">Pay now</button>
      </form>
    </div>
    <div class="bg-white border border-gray-200 rounded-md p-4">
      <h2 class="text-sm font-semibold text-gray-900 mb-1">Sponsored</h2>
      <b class="text-green-800 text-lg">R499/week</b>
      <p class="text-sm text-gray-600">Homepage sponsored strip</p>
    </div>
  </div>
</main>
</Layout>
