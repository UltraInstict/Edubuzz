---
import Layout from '../../layouts/Layout.astro';
import { getUser } from '../../lib/auth';
const user = getUser(Astro.request);
if (!user) return Astro.redirect('/login?next=' + Astro.url.pathname);
const jobId = Astro.url.searchParams.get('job') || '';
---
<Layout title="Upgrade Listing" description="Boost a job listing on Edubuzz." canonicalUrl={Astro.url.href}>
<main class="wrap"><h1>Upgrade your listing</h1><section class="tiers"><div><h2>Basic</h2><b>Free</b><p>Standard listing</p></div><div class="selected"><h2>Featured</h2><b>R299</b><p>Top of results for 60 days</p><form method="post" action="/api/payments/initiate"><input type="hidden" name="jobId" value={jobId}/><button>Pay now</button></form></div><div><h2>Sponsored</h2><b>R499/week</b><p>Homepage sponsored strip</p></div></section></main>
</Layout>
<style>.wrap{max-width:900px;margin:1.5rem auto;padding:0 1.5rem}h1{font-size:22px;margin:0 0 12px;font-weight:600;letter-spacing:-0.3px}.tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.tiers div{background:#fff;border:1px solid #e0e0e0;border-radius:6px;padding:1rem}.selected{border:2px solid #2d6a4f!important}h2{font-size:14px;margin:0 0 4px}b{color:#2d6a4f}p{font-size:13px;color:#666}button{border:1px solid #2d6a4f;background:#2d6a4f;color:#fff;border-radius:4px;padding:9px 12px}@media(max-width:760px){.tiers{grid-template-columns:1fr}}</style>
