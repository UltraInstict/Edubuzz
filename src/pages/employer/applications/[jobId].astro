---
import Layout from '../../../layouts/Layout.astro';
import { getUser } from '../../../lib/auth';
import { getEmployerByUserId, getJobForEmployer, listJobApplicationsFiltered } from '../../../services/jobService';
const user = await getUser(Astro.request);
if (!user) return Astro.redirect('/login?next=' + Astro.url.pathname);
const employer = await getEmployerByUserId((user as any).id);
if (!employer) return Astro.redirect('/register');
const job = await getJobForEmployer(Astro.params.jobId || '', employer.id);
if (!job) return new Response('Not found', { status: 404 });
const status = Astro.url.searchParams.get('status') || '';
const items = await listJobApplicationsFiltered(job.id, status);
const apps = { items };
const statuses = ['pending','reviewed','shortlisted','rejected'];
---
<Layout title={`Applications for ${job.title}`} description="Review job applications." canonicalUrl={Astro.url.href}>
<main class="wrap"><h1>Applications: {job.title}</h1><nav>{['','pending','shortlisted','rejected'].map(s=><a href={s?`?status=${s}`:'?'} class={s===status?'active':''}>{s || 'All'}</a>)}</nav><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Applied</th><th>CV</th><th>Status</th></tr></thead><tbody>{apps.items.map((app:any)=><tr><td>{app.applicant_name || app.name}</td><td>{app.applicant_email || app.email}</td><td>{app.applicant_phone || app.phone}</td><td>{app.created?.slice(0,10)}</td><td>{app.cv_file ? <a href={`${import.meta.env.PB_URL || 'http://127.0.0.1:8090'}/api/files/applications/${app.id}/${app.cv_file}`}>Download</a> : '-'}</td><td><select data-app={app.id}>{statuses.map(s=><option value={s} selected={(app.status || 'pending')===s}>{s}</option>)}</select></td></tr>)}</tbody></table></div></main>
</Layout>
<script>document.querySelectorAll('[data-app]').forEach((select)=>select.addEventListener('change',async()=>{const el=select as HTMLSelectElement;await fetch('/api/employer/update-application-status',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({applicationId:el.dataset.app,status:el.value})});}));</script>
<style>.wrap{max-width:1100px;margin:1.5rem auto;padding:0 1.5rem}h1{font-size:22px;margin:0 0 10px;font-weight:600;letter-spacing:-0.3px}nav{display:flex;gap:8px;margin-bottom:12px}a{color:#166534;font-size:13px}.active{font-weight:600}.table-wrap{overflow:auto;background:#fff;border:1px solid #e5e7eb;border-radius:6px}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:8px;border-bottom:1px solid #e5e7eb;text-align:left}select{border:1px solid #e5e7eb;border-radius:4px;background:#fff;padding:5px}</style>
