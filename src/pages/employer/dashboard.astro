---
import Layout from '../../layouts/Layout.astro';
import { getEmployerSession } from '../../lib/auth';
import { formatSalary } from '../../lib/pocketbase';
import { getEmployerMetrics, listEmployerJobs } from '../../services/jobService';

const session = await getEmployerSession(Astro.request);
if (!session) return Astro.redirect('/login?next=' + Astro.url.pathname);
const { employer } = session;

const [metrics, jobsList] = await Promise.all([
  getEmployerMetrics(employer.id),
  listEmployerJobs(employer.id),
]);
const jobs = { items: jobsList };
---

<Layout title="Employer Dashboard" description="Manage your Edubuzz listings." canonicalUrl={Astro.url.href}>
  <main class="max-w-6xl mx-auto px-6 py-6 grid grid-cols-[1fr_240px] gap-4">
    <section>
      <h1 class="text-2xl font-bold text-gray-900 mb-3">Employer dashboard</h1>
      <div class="grid grid-cols-3 gap-2.5 mb-4">
        <div class="bg-white border border-gray-200 rounded-md p-5">
          <b class="block text-xl font-semibold text-gray-900">{metrics.activeJobs}</b>
          <span class="text-xs text-gray-500">Active listings</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-md p-5">
          <b class="block text-xl font-semibold text-gray-900">{metrics.viewsThisMonth}</b>
          <span class="text-xs text-gray-500">Views this month</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-md p-5">
          <b class="block text-xl font-semibold text-gray-900">{metrics.totalApplications}</b>
          <span class="text-xs text-gray-500">Applications</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-md p-5">
          <b class="block text-xl font-semibold text-gray-900">{metrics.ctr}%</b>
          <span class="text-xs text-gray-500">Click-through rate</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-md p-5">
          <b class="block text-xl font-semibold text-gray-900">{employer.plan || 'free'}</b>
          <span class="text-xs text-gray-500">Plan status</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-md p-5">
          <b class="block text-xl font-semibold text-gray-900">{employer.verified ? 'Yes' : 'Pending'}</b>
          <span class="text-xs text-gray-500">Verified</span>
        </div>
      </div>
      <div class="overflow-auto bg-white border border-gray-200 rounded-md">
        <table class="w-full border-collapse text-xs">
          <thead>
            <tr>
              <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Job title</th>
              <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Status</th>
              <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Views</th>
              <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Applications</th>
              <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Salary</th>
              <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Expires</th>
              <th class="px-2 py-2 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200">Actions</th>
            </tr>
          </thead>
          <tbody>
            {jobs.items.map((job: any) => (
              <tr class="border-b border-gray-200">
                <td class="px-2 py-2 text-gray-600">{job.title}</td>
                <td class="px-2 py-2 text-gray-600">{job.active ? 'Active' : 'Review'}</td>
                <td class="px-2 py-2 text-gray-600">{job.views || 0}</td>
                <td class="px-2 py-2"><a href={`/employer/applications/${job.id}`} class="text-green-800 text-xs">View</a></td>
                <td class="px-2 py-2 text-gray-600">{formatSalary(job.salary_min, job.salary_max)}</td>
                <td class="px-2 py-2 text-gray-600">{job.expires?.slice(0, 10) || '-'}</td>
                <td class="px-2 py-2">
                  <span class="flex gap-1.5 text-xs">
                    <a href={`/employer/edit-job/${job.id}`} class="text-green-800">Edit</a>
                    <a href={`/employer/analytics/${job.id}`} class="text-green-800">Analytics</a>
                    <a href={`/employer/upgrade?job=${job.id}`} class="text-green-800">Boost</a>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    <aside class="space-y-2">
      <h2 class="text-base font-semibold text-gray-900">{employer.company_name}</h2>
      <a href="/employer/post-job" class="block text-sm text-green-800 hover:underline">Post a job</a>
      <a href="/employer/company-profile" class="block text-sm text-green-800 hover:underline">Company profile</a>
      <a href="/logout" class="block text-sm text-green-800 hover:underline">Logout</a>
    </aside>
  </main>
</Layout>

<style>
  @media (max-width: 820px) {
    main { grid-template-columns: 1fr; }
  }
</style>
