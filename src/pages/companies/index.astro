---
import Layout from '../../layouts/Layout.astro';
import { getEmployers, PROVINCES } from '../../lib/pocketbase';
import { COMPANY_GUIDES } from '../../content/company-guides';
import { SITE_URL } from '../../lib/constants';
import { JOBS_PUBLIC } from '../../lib/featureFlags';
const province = Astro.url.searchParams.get('province') || '';
// The education hub needs no database query to display its editorial guides.
const employers = JOBS_PUBLIC ? await getEmployers({ page: 1, perPage: 100, province, verifiedOnly: true }).catch(() => ({ items: [] })) : { items: [] };
---
<Layout title="Employer Guides in South Africa: How to Apply at Top Companies" description="Get to know major South African employers, their career areas and official application routes." canonicalUrl={SITE_URL + '/companies'} adsEligible={true}>
<main class="shell">
<header class="collection-intro"><span class="eyebrow">THE WORKING WORLD / EMPLOYER GUIDES</span><h1>Meet your possible<br />next workplace.</h1><p>Learn about South Africa’s major employers, their career areas and how to apply through official channels. A little research can make your next application more focused.</p></header>
<div class="editorial-grid" style="padding-bottom:65px">{COMPANY_GUIDES.map(g => <a class="company-card" href={'/company/' + g.slug}><div class="company-card__top"><span class="company-monogram" aria-hidden="true">{g.name.charAt(0)}</span><span class="eyebrow">{g.sector}</span></div><h2>{g.name}</h2><p>{g.description}</p><span class="button-text">Explore employer guide ↗</span></a>)}</div>
{JOBS_PUBLIC && <section style="padding-bottom:65px"><h2 class="text-2xl font-semibold mb-4">Other verified employers</h2><nav aria-label="Filter employers by province" class="flex gap-2 flex-wrap mb-6">{['', ...PROVINCES].map(p => <a href={p ? '/companies?province=' + encodeURIComponent(p) : '/companies'} class="border rounded-full px-4 py-2 text-sm" aria-current={p === province ? 'page' : undefined}>{p || 'All provinces'}</a>)}</nav>{employers.items.length ? <div class="editorial-grid">{employers.items.map((emp:any) => <a class="company-card" href={'/company/' + emp.company_slug}><h2>{emp.company_name}</h2><p>{[emp.city,emp.province].filter(Boolean).join(', ')}</p></a>)}</div> : <p>No verified employers listed for this filter.</p>}</section>}
</main></Layout>
