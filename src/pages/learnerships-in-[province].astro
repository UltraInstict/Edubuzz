---
import Layout from '../layouts/Layout.astro';
import JobCard from '../components/JobCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getJobs, getCategoriesWithCounts, PROVINCES } from '../lib/pocketbase';
import { provinceName, slugify } from '../lib/slugify';
import { JOBS_PUBLIC } from '../lib/featureFlags';

// AdSense phase: thin doorway template → the comprehensive learnership guide.
if (!JOBS_PUBLIC) {
  return Astro.redirect('/resources/what-is-a-learnership', 301);
}

const { province: provinceSlug } = Astro.params;
const province = provinceName(provinceSlug || '');
if (!province || !PROVINCES.includes(province)) return Astro.redirect('/404');

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
const perPage = 10;
const [{ items: jobs, totalItems }, categories] = await Promise.all([
  getJobs({ page, perPage, search: 'learnership', province }),
  getCategoriesWithCounts(),
]);

const otherProvinces = PROVINCES.filter(p => p !== province && p !== 'Remote');

const faq = [
  { q: `What learnerships are available in ${province}?`, a: `Learnerships in ${province} are available across various sectors including government, health, IT, finance, engineering, and retail. These are SETA-accredited programmes that combine theoretical training with practical work experience.` },
  { q: `How do I apply for a learnership in ${province}?`, a: `Applications are typically submitted directly to employers or training providers. Browse current learnership opportunities above and follow the application instructions for each listing.` },
  { q: `Do learnerships in ${province} pay a stipend?`, a: `Yes, all registered learnerships in South Africa provide a learner stipend. The amount varies depending on the sector and level of the learnership programme.` },
  { q: `What are the entry requirements for learnerships in ${province}?`, a: `Entry requirements vary but typically include a Grade 12/Matric certificate. Some learnerships may require specific subject passes or previous relevant experience.` },
];
---

<Layout
  title={`Learnerships in ${province} 2026 | Apply for Training Programmes`}
  description={`Find ${province} learnership applications for 2026. Browse SETA-accredited learnerships, apprenticeships, and skills programmes in ${province}. Apply today!`}
  canonicalUrl={Astro.url.href}
  adsEligible={false}
>
  <div class="bg-white border-b border-gray-200 py-10 px-6">
    <div class="max-w-6xl mx-auto">
      <nav class="text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gray-900">Home</a> &rsaquo; <a href="/learnerships" class="hover:text-gray-900">Learnerships</a> &rsaquo; <span class="text-gray-900 font-medium">Learnerships in {province}</span>
      </nav>
      <h1 class="text-2xl font-semibold text-gray-900">Learnerships in {province}</h1>
      <p class="text-gray-500 text-sm mt-2">{totalItems.toLocaleString('en-ZA')} learnership opportunities in {province}</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
    <div>
      <article class="prose max-w-none mb-8">
        <p class="text-gray-500">Learnerships in {province} offer an excellent pathway to gain valuable work experience while earning a qualification. These SETA-accredited programmes combine structured learning with on-the-job training, making them ideal for school leavers and career changers.</p>

        <h2 class="text-lg font-semibold text-gray-900 mt-6">Popular Learnership Fields in {province}</h2>
        <p class="text-gray-500">The most in-demand learnership sectors in {province} include government administration, health sciences, information technology, financial services, engineering, and retail management.</p>
      </article>

      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Learnerships by Province</h2>
        <div class="flex flex-wrap gap-2">
          {otherProvinces.map(p => (
            <a href={`/learnerships-in-${slugify(p)}`} class="inline-flex items-center px-3 py-1.5 bg-green-50 text-green-800 text-xs font-medium rounded-full hover:bg-green-100 transition-colors">
              Learnerships in {p}
            </a>
          ))}
        </div>
      </section>

      <section class="mb-8">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4" itemscope itemtype="https://schema.org/FAQPage">
          {faq.map(item => (
            <div class="card p-5" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <h3 class="font-medium text-gray-900 text-sm mb-1" itemprop="name">{item.q}</h3>
              <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p class="text-gray-500 text-xs" itemprop="text">{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      {totalItems > 0 && (
        <section>
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Learnerships in {province}</h2>
          <div class="space-y-3">{jobs.map(job => <JobCard job={job} />)}</div>
        </section>
      )}

      {totalItems === 0 && (
        <div class="card text-center py-12">
          <h2 class="text-lg font-semibold text-gray-900 mb-2">No learnerships currently listed in {province}</h2>
          <p class="text-gray-500 text-sm mb-4">Check back soon or browse learnerships in other provinces.</p>
          <a href="/learnerships" class="inline-flex items-center px-4 py-2 bg-green-800 text-white text-sm font-medium rounded-md hover:bg-green-900 transition-colors">All Learnerships</a>
        </div>
      )}
    </div>

    <aside><Sidebar /></aside>
  </div>
</Layout>
