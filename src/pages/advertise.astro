---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Advertise on Edubuzz" description="Reach thousands of job seekers in South Africa. Choose from free basic listings, featured placements, or sponsored banners." canonicalUrl={Astro.url.href}>
  <main class="page-wrap">
    <h1>Advertise on Edubuzz</h1>
    <p class="intro">Choose the right plan to reach the candidates you need.</p>

    <div class="tiers">
      <div class="tier">
        <h2>Basic listing</h2>
        <p class="price">Free</p>
        <ul>
          <li>Active for 30 days</li>
          <li>Standard placement in search results</li>
          <li>Applications via email</li>
        </ul>
        <a href="/post-job" class="primary-btn">Post a job</a>
      </div>

      <div class="tier featured">
        <span class="badge">Popular</span>
        <h2>Featured listing</h2>
        <p class="price">R299</p>
        <ul>
          <li>Active for 60 days</li>
          <li>Bold title &amp; "Featured" badge</li>
          <li>Top of search results</li>
          <li>Included in job alert emails</li>
          <li>Priority support</li>
        </ul>
        <a href="/employer/upgrade" class="primary-btn">Upgrade listing</a>
      </div>

      <div class="tier">
        <h2>Sponsored strip</h2>
        <p class="price">R499<span>/week</span></p>
        <ul>
          <li>Banner across homepage</li>
          <li>50&thinsp;000+ monthly impressions</li>
          <li>Target by province or category</li>
          <li>Dedicated account manager</li>
        </ul>
        <a href="/contact" class="primary-btn">Get in touch</a>
      </div>
    </div>

    <div class="contact-cta">
      <p>To book a sponsored strip or discuss bulk pricing, email <a href="mailto:advertise@edubuzz.co.za">advertise@edubuzz.co.za</a></p>
    </div>

    <div class="stats-cta">
      <span>50&thinsp;000+ monthly impressions</span>
      <span>1&thinsp;000+ active job seekers</span>
      <span>Updated daily</span>
    </div>
  </main>
</Layout>

<style>
  .page-wrap { max-width: 900px; margin: 0 auto; padding: 1.5rem; }
  h1 { font-size: 22px; font-weight: 600; letter-spacing: -0.3px; margin: 0 0 4px; }
  .intro { color: #666; font-size: 14px; margin: 0 0 20px; }
  .tiers { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; margin-bottom: 24px; }
  .tier { background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 20px; display: flex; flex-direction: column; gap: 10px; position: relative; }
  .tier.featured { border-color: #2d6a4f; border-width: 2px; }
  .badge { position: absolute; top: -10px; right: 12px; background: #2d6a4f; color: #fff; border-radius: 10px; font-size: 11px; font-weight: 600; padding: 2px 10px; }
  .tier h2 { margin: 0; font-size: 16px; font-weight: 600; }
  .price { font-size: 24px; font-weight: 700; color: #2d6a4f; margin: 0; }
  .price span { font-size: 13px; font-weight: 400; color: #888; }
  .tier ul { padding-left: 18px; color: #666; font-size: 13px; display: grid; gap: 5px; margin: 0; }
  .primary-btn { display: inline-flex; align-items: center; justify-content: center; border: 1px solid #2d6a4f; border-radius: 4px; background: #2d6a4f; color: #fff; font-size: 13px; font-weight: 500; padding: 9px 12px; margin-top: auto; }
  .primary-btn:hover { background: #245a42; border-color: #245a42; }
  .contact-cta { background: #e8f4f0; border: 1px solid #2d6a4f; border-radius: 6px; padding: 14px 18px; text-align: center; margin-bottom: 20px; }
  .contact-cta p { color: #2d6a4f; font-size: 13px; font-weight: 500; margin: 0; }
  .contact-cta a { color: #2d6a4f; font-weight: 600; }
  .stats-cta { display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; }
  .stats-cta span { color: #888; font-size: 13px; font-weight: 500; }
</style>
