---
import Layout from '../layouts/Layout.astro';
import { ADS_ENABLED } from '../lib/featureFlags';

// AdSense phase: advertising packages are not offered. ADS_ENABLED=true
// restores this page when advertising returns.
if (!ADS_ENABLED) {
  return Astro.redirect('/about', 301);
}
---

<Layout title="Advertise on Edubuzz" description="Reach thousands of active South African job seekers. Banner ads, category sponsorships, and featured employer placements." canonicalUrl={Astro.url.href}>
  <div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Advertise on Edubuzz</h1>
    <p class="text-sm text-gray-600 leading-relaxed mb-8">Reach thousands of active South African job seekers daily. Edubuzz offers targeted advertising options for recruitment agencies, training providers, and employers.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="bg-white border border-gray-200 rounded-md p-5 flex flex-col gap-3">
        <h2 class="text-base font-semibold text-gray-900">Banner Ad</h2>
        <p class="text-2xl font-bold text-green-800">R499<span class="text-sm font-normal text-gray-400">/week</span></p>
        <ul class="text-sm text-gray-600 space-y-1.5 mb-4"><li>728x90 leaderboard on homepage</li><li>Top of page placement</li><li>50,000+ impressions per week</li></ul>
        <a href="mailto:advertise@edubuzz.co.za" class="mt-auto inline-block bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors text-center">Book this slot</a>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5 flex flex-col gap-3">
        <h2 class="text-base font-semibold text-gray-900">Category Sponsor</h2>
        <p class="text-2xl font-bold text-green-800">R299<span class="text-sm font-normal text-gray-400">/month</span></p>
        <ul class="text-sm text-gray-600 space-y-1.5 mb-4"><li>Your brand on a category page</li><li>Target IT, Government, Health, more</li><li>Sidebar placement</li></ul>
        <a href="mailto:advertise@edubuzz.co.za" class="mt-auto inline-block bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors text-center">Book this slot</a>
      </div>
      <div class="bg-white border border-gray-200 rounded-md p-5 flex flex-col gap-3">
        <h2 class="text-base font-semibold text-gray-900">Featured Employer</h2>
        <p class="text-2xl font-bold text-green-800">R199<span class="text-sm font-normal text-gray-400">/month</span></p>
        <ul class="text-sm text-gray-600 space-y-1.5 mb-4"><li>Company logo and link in sidebar</li><li>Featured on all listing pages</li><li>Direct link to your company page</li></ul>
        <a href="mailto:advertise@edubuzz.co.za" class="mt-auto inline-block bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors text-center">Book this slot</a>
      </div>
    </div>
    <div class="bg-green-50 border border-green-200 rounded-md p-5 text-center">
      <p class="text-sm text-green-800 font-medium">Email us at <a href="mailto:advertise@edubuzz.co.za" class="text-green-800 hover:text-green-900 hover:underline">advertise@edubuzz.co.za</a> to book your slot or discuss custom advertising packages.</p>
    </div>
  </div>
</Layout>
