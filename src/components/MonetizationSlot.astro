---
/**
 * MonetizationSlot — unified ad slot driven by the Monetization Engine.
 *
 * Zones: strip, sidebar, infeed, jobs-top, homepage-hero
 *
 * Pages render this component with ZERO monetization logic:
 *   <MonetizationSlot zone="sidebar" category={job.category} />
 *
 * The engine resolves priority, scheduling, category targeting, and
 * content. AdSense and affiliate rendering rules are fully separated.
 */
import { resolveSlot } from '../services/monetizationService';
import type { ResolvedSlot, AffiliateContent, HouseAdContent, SponsoredJobContent, SponsoredEmployerContent, AdSenseContent } from '../services/monetizationService';

export interface Props {
  zone: 'strip' | 'sidebar' | 'infeed' | 'jobs-top' | 'homepage-hero';
  category?: string;
}

const { zone, category } = Astro.props;

const result: ResolvedSlot = await resolveSlot(zone, { category }).catch(() => ({ type: 'empty' as const, content: null }));

// ── Extract content by type ───────────────────────────────────────────────
const affiliate = result.type.startsWith('affiliate_') ? (result.content as AffiliateContent | null) : null;
const houseAd = result.type === 'house_ad' ? (result.content as HouseAdContent | null) : null;
const sponsoredJob = result.type === 'sponsored_job' ? (result.content as SponsoredJobContent | null) : null;
const sponsoredEmployer = result.type === 'sponsored_employer' ? (result.content as SponsoredEmployerContent | null) : null;
const adsense = result.type === 'adsense_manual' ? (result.content as AdSenseContent | null) : null;

const campaignId = result.campaignId ?? '';

// Affiliate display flags
const affImage = affiliate && affiliate.display_type === 'image' && (affiliate.bannerFileUrl || affiliate.image_url);
const affHtml  = affiliate && affiliate.display_type === 'html' && !!affiliate.banner_html;
const affText  = affiliate && !affImage && !affHtml;

// Text ad subtitle
let textSubtitle = '';
if (affText && affiliate) {
  const desc = (affiliate.description || '').trim();
  if (desc) {
    textSubtitle = desc;
  } else if (affiliate.name && affiliate.name.length > 40) {
    textSubtitle = affiliate.name.length > 80 ? affiliate.name.slice(0, 80).trim() + '\u2026' : affiliate.name;
  }
}

const ctaLabel = zone === 'jobs-top' ? 'Claim offer' : 'Learn more';

// Banner dimensions
const bw = affiliate?.banner_width;
const bh = affiliate?.banner_height;
const imgStyle = bw || bh ? `width:${bw || ''}${bw ? 'px' : ''};height:${bh ? bh + 'px' : 'auto'}` : '';
const frameClass = zone === 'sidebar' ? 'smart-ad__frame smart-ad__frame--sidebar' : 'smart-ad__frame smart-ad__frame--flexible';

// AdSense dimensions (NEVER force width/height — responsive only)
const dims: Record<string, { format: string; style: string }> = {
  strip:          { format: 'horizontal', style: 'display:block;width:100%;min-height:90px' },
  sidebar:        { format: 'rectangle',  style: 'display:block;width:100%;min-height:250px' },
  infeed:         { format: 'fluid',      style: 'display:block;width:100%;min-height:90px' },
  'jobs-top':     { format: 'horizontal', style: 'display:block;width:100%;min-height:90px' },
  'homepage-hero':{ format: 'horizontal', style: 'display:block;width:100%;min-height:90px' },
};
const dim = dims[zone];
---

{/* ─── SPONSORED JOB ──────────────────────────────────── */}
{sponsoredJob && (
  <div class={`smart-ad smart-ad--${zone}`} data-ad-type="sponsored-job" data-campaign-id={campaignId}>
    <span class="smart-ad__label">SPONSORED</span>
    <a href={`/job/${sponsoredJob.slug}`} class="text-ad text-ad--sponsored" data-campaign-id={campaignId}>
      <div class="text-ad__body">
        <span class="text-ad__title">{sponsoredJob.title}</span>
        <span class="text-ad__subtitle">{sponsoredJob.company}{sponsoredJob.city ? ` · ${sponsoredJob.city}` : ''}</span>
      </div>
      <span class="text-ad__cta">Apply now</span>
    </a>
  </div>
)}

{/* ─── SPONSORED EMPLOYER ──────────────────────────────── */}
{sponsoredEmployer && (
  <div class={`smart-ad smart-ad--${zone}`} data-ad-type="sponsored-employer" data-campaign-id={campaignId}>
    <span class="smart-ad__label">FEATURED EMPLOYER</span>
    <a href={`/company/${sponsoredEmployer.company_slug}`} class="employer-ad" data-campaign-id={campaignId}>
      <div class="employer-ad__body">
        <span class="employer-ad__name">{sponsoredEmployer.company_name}</span>
        {sponsoredEmployer.description && <span class="employer-ad__desc">{sponsoredEmployer.description}</span>}
      </div>
      <span class="text-ad__cta">View jobs</span>
    </a>
  </div>
)}

{/* ─── HOUSE AD ────────────────────────────────────────── */}
{houseAd && (
  <div class={`smart-ad smart-ad--${zone}`} data-ad-type="house-ad" data-campaign-id={campaignId}>
    <span class="smart-ad__label">EDUBUZZ</span>
    <a href={houseAd.link_url} class="text-ad text-ad--house" data-campaign-id={campaignId}>
      <div class="text-ad__body">
        <span class="text-ad__title">{houseAd.title}</span>
        {houseAd.description && <span class="text-ad__subtitle">{houseAd.description}</span>}
      </div>
      <span class="text-ad__cta">{houseAd.cta_text}</span>
    </a>
  </div>
)}

{/* ─── AFFILIATE IMAGE ─────────────────────────────────── */}
{affImage && affiliate && (
  <div class={`smart-ad smart-ad--${zone} smart-ad--image`} data-ad-type="affiliate-image" data-campaign-id={campaignId}>
    <span class="smart-ad__label">SPONSORED</span>
    <a
      href={affiliate.url}
      target="_blank"
      rel="nofollow sponsored noopener noreferrer"
      class={frameClass}
      data-campaign-id={campaignId}
      data-affiliate-id={affiliate.id}
    >
      <img
        src={affiliate.bannerFileUrl || affiliate.image_url}
        alt={affiliate.name}
        style={imgStyle}
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
)}

{/* ─── AFFILIATE HTML ──────────────────────────────────── */}
{affHtml && affiliate && (
  <div class={`smart-ad smart-ad--${zone} smart-ad--html`} data-ad-type="affiliate-html" data-campaign-id={campaignId}>
    <span class="smart-ad__label">SPONSORED</span>
    <div class="smart-ad__banner" set:html={affiliate.banner_html} />
  </div>
)}

{/* ─── AFFILIATE TEXT ──────────────────────────────────── */}
{affText && affiliate && (
  <a
    href={affiliate.url}
    target="_blank"
    rel="nofollow sponsored noopener noreferrer"
    class={`text-ad text-ad--${zone}`}
    data-ad-type="affiliate-text"
    data-campaign-id={campaignId}
    data-affiliate-id={affiliate.id}
  >
    <div class="text-ad__body">
      <span class="text-ad__label">SPONSORED</span>
      <span class="text-ad__title">{affiliate.name}</span>
      {textSubtitle && <span class="text-ad__subtitle">{textSubtitle}</span>}
    </div>
    <span class="text-ad__cta">{ctaLabel}</span>
  </a>
)}

{/* ─── ADSENSE ─────────────────────────────────────────── */}
{adsense && (
  <div class={`smart-ad smart-ad--${zone}`} data-ad-type="adsense">
    <span class="smart-ad__label">SPONSORED</span>
    <ins
      class="adsbygoogle"
      style={dim.style}
      data-ad-client={adsense.publisher_id}
      data-ad-slot={adsense.slot_id}
      data-ad-format={adsense.format}
      data-full-width-responsive="true"
    ></ins>
    <script>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}

<script>
  document.querySelectorAll('[data-affiliate-id]').forEach((el) => {
    el.addEventListener('click', () => {
      const linkId = (el as HTMLElement).dataset.affiliateId;
      const cId = (el as HTMLElement).dataset.campaignId;
      if (!linkId) return;
      fetch('/api/track-affiliate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ linkId, campaignId: cId }),
        keepalive: true,
      }).catch(() => {});
    });
  });
</script>

<style>
  .smart-ad {
    display: block;
    margin: 0 0 12px;
  }
  .smart-ad--infeed { margin: 0 0 12px; }
  .smart-ad--sidebar { max-width: 300px; margin-top: 0; }
  .smart-ad--jobs-top { width: 100%; }
  .smart-ad--homepage-hero { width: 100%; }

  .smart-ad__label {
    display: block;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9ca3af;
    margin-bottom: 4px;
  }

  /* ─── FLEXIBLE FRAME (strip, infeed, jobs-top, homepage-hero) ─── */
  .smart-ad__frame--flexible {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .smart-ad__frame--flexible img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
  }

  /* ─── SIDEBAR FRAME ─── */
  .smart-ad__frame--sidebar {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
    background: #f9fafb;
    border-radius: 4px;
    aspect-ratio: 300 / 250;
  }
  .smart-ad__frame--sidebar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ─── TEXT AD (shared by affiliate text, sponsored job, house ad) ─── */
  .text-ad {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: #ffffff;
    border-left: 3px solid #166534;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 150ms ease, transform 150ms ease;
    margin: 0 0 12px;
  }
  .text-ad:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    transform: translateY(-1px);
  }
  .text-ad--sponsored { border-left-color: #d97706; }
  .text-ad--house { border-left-color: #166534; }

  .text-ad__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .text-ad__title {
    font-size: 15px;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
  }
  .text-ad__subtitle {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.4;
  }
  .text-ad__cta {
    flex-shrink: 0;
    background: #166534;
    color: #ffffff;
    border-radius: 20px;
    padding: 0.4rem 1rem;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: background 150ms ease;
  }
  .text-ad:hover .text-ad__cta {
    background: #14532d;
  }
  .text-ad--sponsored .text-ad__cta { background: #d97706; }
  .text-ad--sponsored:hover .text-ad__cta { background: #b45309; }

  .text-ad--strip { width: 100%; }
  .text-ad--homepage-hero { width: 100%; }

  .text-ad--sidebar {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    max-width: 100%;
  }
  .text-ad--sidebar .text-ad__title { font-size: 14px; }
  .text-ad--sidebar .text-ad__subtitle { font-size: 12px; }
  .text-ad--sidebar .text-ad__cta {
    text-align: center;
    width: 100%;
    padding: 0.5rem 1rem;
  }

  .text-ad--infeed {
    padding: 0.6rem 1rem;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
    border-left: 3px solid #166534;
    border-radius: 6px;
  }
  .text-ad--infeed .text-ad__title { font-size: 14px; }

  .text-ad--jobs-top { background: #f0fdf4; }

  /* ─── EMPLOYER AD ─── */
  .employer-ad {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: #ffffff;
    border-left: 3px solid #0891b2;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 150ms ease, transform 150ms ease;
    margin: 0 0 12px;
  }
  .employer-ad:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    transform: translateY(-1px);
  }
  .employer-ad__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .employer-ad__name {
    font-size: 15px;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
  }
  .employer-ad__desc {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.4;
  }

  @media (max-width: 560px) {
    .text-ad--strip,
    .text-ad--jobs-top,
    .text-ad--infeed,
    .text-ad--homepage-hero,
    .employer-ad {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .text-ad--strip .text-ad__cta,
    .text-ad--jobs-top .text-ad__cta,
    .text-ad--infeed .text-ad__cta,
    .text-ad--homepage-hero .text-ad__cta,
    .employer-ad .text-ad__cta {
      text-align: center;
      width: 100%;
      padding: 0.5rem 1rem;
    }
  }

  /* ─── HTML ad ─── */
  .smart-ad__banner { display: block; max-width: 100%; }
  .smart-ad__banner :global(iframe),
  .smart-ad__banner :global(img) { max-width: 100%; height: auto; }
</style>
