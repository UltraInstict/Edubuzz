---
interface Props {
  current: string;
}
const { current } = Astro.props;

const links = [
  { href: '/admin', label: 'Dashboard', key: 'dashboard' },
  { href: '/admin/jobs', label: 'Jobs', key: 'jobs' },
  { href: '/admin/employers', label: 'Employers', key: 'employers' },
  { href: '/admin/applications', label: 'Applications', key: 'applications' },
  { href: '/admin/monetization', label: 'Monetization', key: 'monetization' },
  { href: '/admin/affiliates', label: 'Affiliates', key: 'affiliates' },
  { href: '/admin/import', label: 'Import', key: 'import' },
  { href: '/admin/feeds', label: 'Feeds', key: 'feeds' },
  { href: '/admin/alerts', label: 'Alerts', key: 'alerts' },
  { href: '/admin/settings', label: 'Settings', key: 'settings' },
];
---

<nav class="flex flex-wrap gap-1 sticky top-0 z-10 bg-white py-2 border-b border-gray-200 mb-1">
  {links.map((link) => (
    <a
      href={link.href}
      class={`text-xs font-medium px-2.5 py-1 border-b-2 transition-colors ${
        link.key === current
          ? 'text-green-800 font-semibold border-green-800'
          : 'text-gray-500 border-transparent hover:text-gray-900'
      }`}
    >{link.label}</a>
  ))}
</nav>
