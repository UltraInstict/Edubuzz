---
/**
 * SmartAdSlot — single ad slot driven by admin settings.
 *
 * Zones:
 *   - strip      Full-width banner
 *   - sidebar    Vertical native card, max 300px wide
 *   - infeed     Compact horizontal card between job cards
 *   - jobs-top   Same as strip but with subtle green tint
 *
 * AdSense and affiliate rendering are fully independent — each
 * checks its own conditions and never references the other's state.
 */
import { getAdminSettings } from '../services/jobService';
import { getAffiliateLinkByCategory, getCategoryForAffiliate, PB_FILE_BASE } from '../services/affiliateService';

export interface Props {
  zone: 'strip' | 'sidebar' | 'infeed' | 'jobs-top';
  category?: string;
}

const { zone, category } = Astro.props;

const settings = await getAdminSettings([
  'adsense_enabled',
  'adsense_publisher_id',
  'adsense_slot_strip',
  'adsense_slot_sidebar',
  'adsense_slot_infeed',
  'adsense_slot_jobs_top',
  'adsense_preview_mode',
]).catch(() => ({} as Record<string, string>));

const adsenseEnabled = settings.adsense_enabled === 'true';
const publisherId = (settings.adsense_publisher_id || '').trim();
const slotKey = `adsense_slot_${zone.replace('-', '_')}`;
const slotId = (settings[slotKey] || '').trim();
const previewMode = settings.adsense_preview_mode === 'true';

type AffiliateRender = {
  id: string;
  name: string;
  description?: string;
  url: string;
  display_type: 'text' | 'image' | 'html';
  banner_html?: string;
  image_url?: string;
  banner_file?: string;
  banner_width?: number;
  banner_height?: number;
  collectionId?: string;
};

let affiliate: AffiliateRender | null = null;
const matchCategory = getCategoryForAffiliate(category);
const link = await getAffiliateLinkByCategory(matchCategory, zone).catch(() => null);
if (link) {
  const l = link as any;
  let display: 'text' | 'image' | 'html' = (l.display_type as any) || 'text';
  if (!['text', 'image', 'html'].includes(display)) display = 'text';
  affiliate = {
    id: l.id,
    name: l.name,
    description: l.description,
    url: l.url,
    display_type: display,
    banner_html: l.banner_html,
    image_url: l.image_url,
    banner_file: l.banner_file,
    banner_width: l.banner_width,
    banner_height: l.banner_height,
    collectionId: l.collectionId,
  };
}

let bannerFileUrl = '';
if (affiliate?.banner_file && affiliate?.id && affiliate?.collectionId) {
  const filename = Array.isArray(affiliate.banner_file) ? affiliate.banner_file[0] : affiliate.banner_file;
  if (filename) {
    bannerFileUrl = `${PB_FILE_BASE}/files/${affiliate.collectionId}/${affiliate.id}/${filename}`;
  }
}

// Subtitle for text ads
let textSubtitle = '';
if (affiliate?.display_type === 'text') {
  const desc = (affiliate.description || '').trim();
  if (desc) {
    textSubtitle = desc;
  } else if (affiliate.name && affiliate.name.length > 0) {
    if (affiliate.name.length > 40) {
      textSubtitle = affiliate.name.length > 80 ? affiliate.name.slice(0, 80).trim() + '…' : affiliate.name;
    }
  }
}

const ctaLabel = zone === 'jobs-top' ? 'Claim offer' : 'Learn more';

const previewDims: Record<string, { width: string; height: string; label: string }> = {
  strip:      { width: '728px', height: '90px',  label: 'Leaderboard 728×90' },
  sidebar:    { width: '300px', height: '250px', label: 'Medium Rectangle 300×250' },
  infeed:     { width: '468px', height: '60px',  label: 'Banner 468×60' },
  'jobs-top': { width: '728px', height: '90px',  label: 'Leaderboard 728×90' },
};
const preview = previewDims[zone];

const dims: Record<string, { format: string; style: string }> = {
  strip:      { format: 'horizontal', style: 'display:block;width:100%;min-height:90px' },
  sidebar:    { format: 'rectangle',  style: 'display:block;width:100%;min-height:250px' },
  infeed:     { format: 'fluid',      style: 'display:block;width:100%;min-height:90px' },
  'jobs-top': { format: 'horizontal', style: 'display:block;width:100%;min-height:90px' },
};
const dim = dims[zone];

// ── Affiliate render flags (independent of AdSense) ────────────────────
const affImage = affiliate && affiliate.display_type === 'image' && (bannerFileUrl || affiliate.image_url);
const affHtml  = affiliate && affiliate.display_type === 'html' && !!affiliate.banner_html;
const affText  = affiliate && !affImage && !affHtml;
const showPreview = !affiliate && previewMode;

// Explicit dimension helpers
const bw = affiliate?.banner_width;
const bh = affiliate?.banner_height;
const imgStyle = bw || bh ? `width:${bw || ''}${bw ? 'px' : ''};height:${bh ? bh + 'px' : 'auto'}` : '';
const frameClass = zone === 'sidebar' ? 'smart-ad__frame smart-ad__frame--sidebar' : 'smart-ad__frame smart-ad__frame--flexible';
---

{/* ─── AFFILIATE IMAGE ────────────────────────────────── */}
{affImage && (
  <div class={`smart-ad smart-ad--${zone} smart-ad--image`} data-ad-type="affiliate-image">
    <span class="smart-ad__label">SPONSORED</span>
    <a
      href={affiliate!.url}
      target="_blank"
      rel="nofollow sponsored noopener noreferrer"
      class={frameClass}
      data-affiliate-id={affiliate!.id}
    >
      <img
        src={bannerFileUrl || affiliate!.image_url}
        alt={affiliate!.name}
        style={imgStyle}
        loading="lazy"
      />
    </a>
  </div>
)}

{/* ─── AFFILIATE HTML ─────────────────────────────────── */}
{affHtml && (
  <div class={`smart-ad smart-ad--${zone} smart-ad--html`} data-ad-type="affiliate-html">
    <span class="smart-ad__label">SPONSORED</span>
    <div class="smart-ad__banner" set:html={affiliate!.banner_html} />
  </div>
)}

{/* ─── AFFILIATE TEXT ─────────────────────────────────── */}
{affText && (
  <a
    href={affiliate!.url}
    target="_blank"
    rel="nofollow sponsored noopener noreferrer"
    class={`text-ad text-ad--${zone}`}
    data-ad-type="affiliate-text"
    data-affiliate-id={affiliate!.id}
  >
    <div class="text-ad__body">
      <span class="text-ad__label">SPONSORED</span>
      <span class="text-ad__title">{affiliate!.name}</span>
      {textSubtitle && <span class="text-ad__subtitle">{textSubtitle}</span>}
    </div>
    <span class="text-ad__cta">{ctaLabel}</span>
  </a>
)}

{/* ─── AdSense (fully independent of affiliate state) ──── */}
{adsenseEnabled && !!publisherId && !!slotId && (
  <div class={`smart-ad smart-ad--${zone}`} data-ad-type="adsense">
    <span class="smart-ad__label">SPONSORED</span>
    <ins
      class="adsbygoogle"
      style={dim.style}
      data-ad-client={publisherId}
      data-ad-slot={slotId}
      data-ad-format={dim.format}
      data-full-width-responsive="true"
    ></ins>
    <script>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}

{/* ─── PREVIEW PLACEHOLDER ─────────────────────────────── */}
{showPreview && (
  <div class={`smart-ad smart-ad--${zone} smart-ad--preview`} data-ad-type="preview">
    <span class="smart-ad__label">SPONSORED</span>
    <div class="smart-ad__placeholder" style={`max-width:${preview.width};height:${preview.height}`}>
      <span class="smart-ad__placeholder-label">Advertisement</span>
      <span class="smart-ad__placeholder-size">{preview.label}</span>
    </div>
  </div>
)}

<script>
  document.querySelectorAll('[data-affiliate-id]').forEach((el) => {
    el.addEventListener('click', () => {
      const linkId = (el as HTMLElement).dataset.affiliateId;
      if (!linkId) return;
      fetch('/api/track-affiliate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ linkId }),
        keepalive: true,
      }).catch(() => {});
    });
  });
</script>

<style>
  .smart-ad {
    display: block;
    margin: 0 0 12px;
  }
  .smart-ad--infeed { margin: 0 0 12px; }
  .smart-ad--sidebar { max-width: 300px; margin-top: 0; }
  .smart-ad--jobs-top { width: 100%; }

  /* Sponsored label used by all render types */
  .smart-ad__label {
    display: block;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9ca3af;
    margin-bottom: 4px;
  }

  /* ─── FLEXIBLE FRAME (strip, infeed, jobs-top) ──────
   * Centers the image but imposes no shape — the image
   * keeps its natural aspect ratio, constrained only by
   * max-width: 100%. Explicit sizing from banner_width/
   * banner_height is applied as an inline style.
   */
  .smart-ad__frame--flexible {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .smart-ad__frame--flexible img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
  }

  /* ─── SIDEBAR FRAME (shape-constrained, unchanged) ─── */
  .smart-ad__frame--sidebar {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
    background: #f9fafb;
    border-radius: 4px;
    aspect-ratio: 300 / 250;
  }
  .smart-ad__frame--sidebar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ─── TEXT AD — high-conversion native card ───────── */
  .text-ad {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: #ffffff;
    border-left: 3px solid #166534;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 150ms ease, transform 150ms ease;
    margin: 0 0 12px;
  }
  .text-ad:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    transform: translateY(-1px);
  }

  .text-ad__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .text-ad__label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #9ca3af;
  }
  .text-ad__title {
    font-size: 15px;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
  }
  .text-ad__subtitle {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.4;
  }
  .text-ad__cta {
    flex-shrink: 0;
    background: #166534;
    color: #ffffff;
    border-radius: 20px;
    padding: 0.4rem 1rem;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: background 150ms ease;
  }
  .text-ad:hover .text-ad__cta {
    background: #14532d;
  }

  .text-ad--strip { width: 100%; }

  .text-ad--sidebar {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    max-width: 100%;
  }
  .text-ad--sidebar .text-ad__title { font-size: 14px; }
  .text-ad--sidebar .text-ad__subtitle { font-size: 12px; }
  .text-ad--sidebar .text-ad__cta {
    text-align: center;
    width: 100%;
    padding: 0.5rem 1rem;
  }

  .text-ad--infeed {
    padding: 0.6rem 1rem;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
    border-left: 3px solid #166534;
    border-radius: 6px;
  }
  .text-ad--infeed .text-ad__title { font-size: 14px; }

  .text-ad--jobs-top { background: #f0fdf4; }

  @media (max-width: 560px) {
    .text-ad--strip,
    .text-ad--jobs-top,
    .text-ad--infeed {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .text-ad--strip .text-ad__cta,
    .text-ad--jobs-top .text-ad__cta,
    .text-ad--infeed .text-ad__cta {
      text-align: center;
      width: 100%;
      padding: 0.5rem 1rem;
    }
  }

  /* ─── HTML ad ───────────────────────── */
  .smart-ad__banner { display: block; max-width: 100%; }
  .smart-ad__banner :global(iframe),
  .smart-ad__banner :global(img) { max-width: 100%; height: auto; }

  /* ─── Preview placeholder ─── */
  .smart-ad__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 100%;
    background: #f9fafb;
    border: 2px dashed #d1d5db;
    border-radius: 6px;
  }
  .smart-ad__placeholder-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #9ca3af;
  }
  .smart-ad__placeholder-size { font-size: 10px; color: #d1d5db; }

  @media (max-width: 480px) {
    .smart-ad__placeholder {
      max-width: 100% !important;
      height: auto !important;
      min-height: 60px;
      padding: 12px;
    }
  }
</style>
