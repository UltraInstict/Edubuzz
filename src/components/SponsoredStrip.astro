---
interface Props {
  message: string;
  url: string;
  cta: string;
}

const { message, url, cta } = Astro.props;
---

<div class="sponsored-strip">
  <div>
    <p class="sponsored-label">Sponsored</p>
    <p class="sponsored-text">{message}</p>
  </div>
  <a href={url} class="sponsored-cta">{cta}</a>
</div>

<style>
  .sponsored-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #fffbe6;
    border: 1px solid #f0d070;
    border-radius: 6px;
    padding: 10px 14px;
    margin: 1rem 0;
  }

  .sponsored-label {
    margin: 0 0 2px;
    color: #7a5e00;
    font-size: 12px;
    font-weight: 500;
  }

  .sponsored-text {
    margin: 0;
    color: #444444;
    font-size: 13px;
  }

  .sponsored-cta {
    flex-shrink: 0;
    color: #2d6a4f;
    font-size: 13px;
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .sponsored-strip {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
