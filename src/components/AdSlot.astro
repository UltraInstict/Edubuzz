---
interface Props {
  size: 'leaderboard' | 'rectangle' | 'inline-sponsored';
  label?: string;
}

const { size, label = 'Advertisement' } = Astro.props;
const dims = {
  leaderboard: { w: 728, h: 90 },
  rectangle: { w: 300, h: 250 },
};
const dim = dims[size as keyof typeof dims];
---

<div class="ad-slot" data-size={size}>
  <p class="ad-label">{label}</p>
  {dim && (
    <ins
      class="adsbygoogle"
      style={`display:block;width:${dim.w}px;height:${dim.h}px`}
      data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
      data-ad-slot="XXXXXXXXXX">
    </ins>
  )}
</div>

<style>
  .ad-slot {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background: #f9f9f9;
    border: 1px dashed #cccccc;
    border-radius: 6px;
    padding: 10px;
    text-align: center;
  }

  .ad-slot[data-size='leaderboard'] {
    min-height: 112px;
    margin-bottom: 16px;
  }

  .ad-slot[data-size='rectangle'] {
    min-height: 272px;
    margin-bottom: 16px;
  }

  .ad-label {
    margin: 0 0 6px;
    color: #888888;
    font-size: 12px;
    display: block;
    width: 100%;
    text-align: center;
  }

  @media (max-width: 760px) {
    .ad-slot ins {
      max-width: 100%;
    }
  }
</style>
