---
interface Crumb {
  label: string;
  href?: string;
}

const { items } = Astro.props as { items: Crumb[] };
const origin = Astro.url?.origin || 'https://edubuzz.co.za';
---

<nav aria-label="Breadcrumb" class="text-xs">
  <ol class="list-none m-0 p-0 flex flex-wrap items-center gap-1">
    {items.map((crumb, i) => (
      <li>
        {crumb.href ? (
          <a href={crumb.href} class="text-green-800 hover:text-green-900 hover:underline">{crumb.label}</a>
        ) : (
          <span class="text-gray-900 font-medium" aria-current="page">{crumb.label}</span>
        )}
        {i < items.length - 1 && <span class="text-gray-500 mx-0.5" aria-hidden="true">&rsaquo;</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: crumb.href ? (crumb.href.startsWith('http') ? crumb.href : `${origin}${crumb.href}`) : undefined,
  })),
})} />
