---
interface Crumb {
  label: string;
  href?: string;
}

const { items } = Astro.props as { items: Crumb[] };
const origin = Astro.url?.origin || 'https://edubuzz.co.za';
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {items.map((crumb, i) => (
      <li>
        {crumb.href ? (
          <a href={crumb.href}>{crumb.label}</a>
        ) : (
          <span class="current" aria-current="page">{crumb.label}</span>
        )}
        {i < items.length - 1 && <span class="sep" aria-hidden="true">&rsaquo;</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: crumb.href ? (crumb.href.startsWith('http') ? crumb.href : `${origin}${crumb.href}`) : undefined,
  })),
})} />

<style>
  .breadcrumbs {
    font-size: 12px;
    color: #666;
    padding: 0;
  }
  .breadcrumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }
  .breadcrumbs a {
    color: #666;
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: #2d6a4f;
    text-decoration: underline;
  }
  .breadcrumbs .current {
    color: #1a1a1a;
    font-weight: 500;
  }
  .breadcrumbs .sep {
    color: #aaa;
    margin: 0 2px;
  }
</style>
