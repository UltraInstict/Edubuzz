---
import type { Job } from '../lib/pocketbase';
import { formatSalary, isSalaryDisclosed } from '../lib/pocketbase';
import { timeAgo } from '../lib/timeAgo';
import { stripHtml } from '../lib/utils';

interface Props {
  job: Job;
  compact?: boolean;
}

const { job, compact = false } = Astro.props;
const created = new Date(job.created).getTime();
const isNew = Date.now() - created <= 3 * 86400000;
const plainDescription = stripHtml(job.description || '', 160);
const shortDescription = (job.description || '').length > plainDescription.length ? `${plainDescription.replace(/\.+$/, '')}...` : plainDescription;
---

<a href={`/job/${job.slug}`} class={`job-card ${compact ? 'compact' : ''}`} data-job-id={job.id}>
  <article>
    <div class="job-top">
      <div>
        <h2 class="job-title">{job.title}</h2>
        <p class="job-company">{job.company} &middot; {job.city || job.province}</p>
      </div>
      <div class="badges">
        {job.featured && <span class="badge featured">Featured</span>}
        {isNew && <span class="badge new">New</span>}
      </div>
    </div>

    {!compact && (
      <>
        <div class="job-meta">
          <span>{job.category}</span>
          <span>{job.job_type}</span>
          <span>{job.city ? `${job.city}, ${job.province}` : job.province}</span>
          <span>{timeAgo(job.created)}</span>
        </div>
        <p class="job-desc">{shortDescription}</p>
      </>
    )}

    <div class="job-footer">
      <span class={`job-salary ${isSalaryDisclosed(job.salary_min, job.salary_max) ? '' : 'muted'}`}>
        {formatSalary(job.salary_min, job.salary_max)}
      </span>
      {!compact && <span class="apply-btn">View job &rarr;</span>}
    </div>
  </article>
</a>

<style>
  .job-card {
    display: block;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 14px;
    margin-bottom: 8px;
    color: #1a1a1a;
  }

  .job-card:hover {
    border-color: #2d6a4f;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  }

  .job-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .job-title {
    margin: 0;
    color: #1a1a1a;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  .job-company {
    margin: 3px 0 0;
    color: #666666;
    font-size: 13px;
    line-height: 1.4;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 5px;
    flex-shrink: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 2px 7px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }

  .featured {
    background: #fff8e1;
    border: 1px solid #f0c040;
    color: #7a5e00;
  }

  .new {
    background: #e8f4f0;
    border: 1px solid #2d6a4f;
    color: #1d5c3a;
  }

  .job-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-top: 8px;
    color: #666666;
    font-size: 13px;
  }

  .job-desc {
    margin: 8px 0 0;
    color: #444444;
    font-size: 13px;
    line-height: 1.6;
  }

  .job-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
  }

  .job-salary {
    color: #1a1a1a;
    font-size: 13px;
    font-weight: 500;
  }

  .job-salary.muted {
    color: #888888;
  }

  .apply-btn {
    color: #2d6a4f;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .compact {
    padding: 10px;
  }

  .compact .job-footer {
    margin-top: 6px;
  }
</style>

<script>
  document.querySelectorAll('[data-job-id]').forEach((card) => {
    card.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
      const jobId = (card as HTMLElement).dataset.jobId;
      if (jobId) {
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ jobId, event: 'click' }),
          keepalive: true,
        }).catch(() => {});
      }
    });
  });
</script>
