---
import type { Job } from '../lib/pocketbase';
import { formatSalary, isSalaryDisclosed } from '../lib/pocketbase';
import { timeAgo } from '../lib/timeAgo';
import { stripHtml } from '../lib/utils';

interface Props {
  job: Job;
  compact?: boolean;
}

const { job, compact = false } = Astro.props;
const created = new Date(job.created).getTime();
const isNew = Date.now() - created <= 3 * 86400000;
const plainDescription = stripHtml(job.description || '', 160);
const shortDescription = (job.description || '').length > plainDescription.length ? `${plainDescription.replace(/\.+$/, '')}...` : plainDescription;
---

<a href={`/job/${job.slug}`} class="block bg-white border border-gray-200 rounded-md p-5 hover:border-green-800 transition-colors cursor-pointer mb-2" data-job-id={job.id}>
  <article>
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="text-base font-semibold text-gray-900">{job.title}</h2>
        <p class="text-sm text-gray-600 mt-0.5">{job.company} · {job.city || job.province}</p>
      </div>
      <div class="flex gap-1 flex-shrink-0">
        {job.featured && <span class="text-xs bg-green-50 text-green-800 px-2 py-0.5 rounded-md font-medium">Featured</span>}
        {isNew && <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-md font-medium">New</span>}
      </div>
    </div>

    {!compact && (
      <>
        <div class="text-xs text-gray-500 flex flex-wrap gap-x-3 gap-y-1 mt-3">
          <span>{job.category}</span>
          <span>{job.job_type}</span>
          <span>{job.city ? `${job.city}, ${job.province}` : job.province}</span>
          <span>{timeAgo(job.created)}</span>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed mt-2">{shortDescription}</p>
      </>
    )}

    <div class="flex items-center justify-between gap-3 mt-3">
      <span class="text-sm font-medium text-gray-900">
        {formatSalary(job.salary_min, job.salary_max)}
      </span>
      {!compact && <span class="text-sm text-green-800 hover:underline font-medium">View job</span>}
    </div>
  </article>
</a>

<script>
  document.querySelectorAll('[data-job-id]').forEach((card) => {
    card.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
      const jobId = (card as HTMLElement).dataset.jobId;
      if (jobId) {
        fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ jobId, event: 'click' }), keepalive: true }).catch(() => {});
      }
    });
  });
</script>
