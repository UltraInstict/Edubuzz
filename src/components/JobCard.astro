---
import type { Job } from '../lib/pocketbase';
import { formatSalary, isSalaryDisclosed } from '../lib/pocketbase';
import { timeAgo } from '../lib/timeAgo';
import { stripHtml } from '../lib/utils';

interface Props {
  job: Job;
  compact?: boolean;
}

const { job, compact = false } = Astro.props;
const created = new Date(job.created).getTime();
const isNew = Date.now() - created <= 3 * 86400000;
const plainDescription = stripHtml(job.description || '', 160);
const shortDescription = (job.description || '').length > plainDescription.length ? `${plainDescription.replace(/\.+$/, '')}...` : plainDescription;
---

<a href={`/job/${job.slug}`} class={`job-card ${compact ? 'compact' : ''}`} data-job-id={job.id}>
  <article>
    <div class="job-top">
      <div>
        <h2 class="job-title">{job.title}</h2>
        <p class="job-company">{job.company} · {job.city || job.province}</p>
      </div>
      <div class="badges">
        {job.featured && <span class="badge featured">Featured</span>}
        {isNew && <span class="badge new">New</span>}
      </div>
    </div>

    {!compact && (
      <>
        <div class="job-meta">
          <span>{job.category}</span>
          <span>{job.job_type}</span>
          <span>{job.city ? `${job.city}, ${job.province}` : job.province}</span>
          <span>{timeAgo(job.created)}</span>
        </div>
        <p class="job-desc">{shortDescription}</p>
      </>
    )}

    <div class="job-footer">
      <span class={`job-salary ${isSalaryDisclosed(job.salary_min, job.salary_max) ? '' : 'muted'}`}>
        {formatSalary(job.salary_min, job.salary_max)}
      </span>
      {!compact && <span class="apply-btn">View job &rarr;</span>}
    </div>
  </article>
</a>

<style>
  .job-card {
    display: block;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.375rem;
    padding: 1rem;
    margin-bottom: 0.5rem;
    color: #111827;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .job-card:hover {
    border-color: #166534;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  }

  .job-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .job-title {
    margin: 0;
    color: #111827;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .job-company {
    margin: 0.25rem 0 0;
    color: #6b7280;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: 0.375rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .featured {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
  }

  .new {
    background: #f0fdf4;
    border: 1px solid #166534;
    color: #14532d;
  }

  .job-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
    margin-top: 0.5rem;
    color: #6b7280;
    font-size: 0.875rem;
  }

  .job-desc {
    margin: 0.5rem 0 0;
    color: #6b7280;
    font-size: 0.875rem;
    line-height: 1.625;
  }

  .job-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.625rem;
  }

  .job-salary {
    color: #111827;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .job-salary.muted { color: #9ca3af; }

  .apply-btn {
    color: #166534;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .compact { padding: 0.625rem; }
  .compact .job-footer { margin-top: 0.375rem; }
</style>

<script>
  document.querySelectorAll('[data-job-id]').forEach((card) => {
    card.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
      const jobId = (card as HTMLElement).dataset.jobId;
      if (jobId) {
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ jobId, event: 'click' }),
          keepalive: true,
        }).catch(() => {});
      }
    });
  });
</script>
