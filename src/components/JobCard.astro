---
import type { Job } from '../lib/pocketbase';
import { formatSalary, timeAgo } from '../lib/pocketbase';

interface Props {
  job: Job;
  compact?: boolean;
}
const { job, compact = false } = Astro.props;

const initials = job.company?.slice(0, 1).toUpperCase() || '?';
const logoColors = ['text-accent', 'text-success', 'text-purple', 'text-warn', 'text-danger'];
const colorIdx = job.company?.charCodeAt(0) % logoColors.length || 0;
---

<article class={`bg-white border border-border rounded-xl p-5 hover:border-accent hover:shadow-sm transition-all cursor-pointer relative group ${job.featured ? 'border-blue-200 bg-blue-50/30' : ''}`}>
  {job.featured && <div class="absolute top-0 left-0 right-0 h-0.5 bg-accent rounded-t-xl"></div>}

  <!-- Top row -->
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="flex items-center gap-3">
      <!-- Logo -->
      <div class="w-10 h-10 rounded-lg border border-border bg-surface flex items-center justify-center font-serif text-base shrink-0 text-navy">
        {initials}
      </div>
      <div>
        <div class="text-xs text-muted mb-0.5">{job.company}</div>
        <h2 class="text-[15px] font-bold text-navy leading-tight group-hover:text-accent transition-colors">
          <a href={`/job/${job.slug}`} class="after:absolute after:inset-0">
            {job.title}
          </a>
        </h2>
      </div>
    </div>

    <!-- Badges -->
    <div class="flex flex-col gap-1 items-end shrink-0">
      {job.featured && <span class="badge bg-accent-light text-accent">Featured</span>}
      {job.ai_written && <span class="badge bg-purple-light text-purple">AI Written</span>}
      {!job.featured && !job.ai_written && timeAgo(job.created) === 'Today' && <span class="badge bg-success-light text-success">New</span>}
    </div>
  </div>

  <!-- Meta -->
  <div class="flex flex-wrap gap-x-4 gap-y-1 mb-3">
    <span class="flex items-center gap-1 text-xs text-muted">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      {job.city ? `${job.city}, ${job.province}` : job.province}
    </span>
    <span class="flex items-center gap-1 text-xs text-muted">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
      {job.job_type}
    </span>
    {job.category && (
      <span class="flex items-center gap-1 text-xs text-muted">{job.category}</span>
    )}
  </div>

  {!compact && (
    <div class="flex flex-wrap gap-1.5 mb-3">
      {[job.category, job.job_type, job.province].filter(Boolean).map(tag => (
        <span class="text-[11px] px-2 py-0.5 bg-surface border border-border rounded-full text-muted">{tag}</span>
      ))}
    </div>
  )}

  <!-- Footer -->
  <div class="flex items-center justify-between pt-3 border-t border-border">
    <span class="text-sm font-bold text-success">{formatSalary(job.salary_min, job.salary_max)}</span>
    <div class="flex items-center gap-3">
      <span class="text-[11px] text-muted">{timeAgo(job.created)}</span>
      <span class="text-xs font-bold text-accent opacity-0 group-hover:opacity-100 transition-opacity">View →</span>
    </div>
  </div>
</article>
