---
export interface Props {
  variant?: 'verified' | 'featured' | 'new' | 'urgent';
}

const { variant = 'verified' } = Astro.props;

const labels: Record<string, string> = {
  verified: 'Verified Employer',
  featured: 'Featured',
  new: 'New',
  urgent: 'Urgent',
};

const variants: Record<string, string> = {
  verified: 'bg-blue-50 text-blue-800',
  featured: 'bg-green-50 text-green-800',
  new: 'bg-amber-50 text-amber-800',
  urgent: 'bg-red-50 text-red-800',
};
---

<span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-semibold uppercase tracking-wide ${variants[variant]}`} role="status">
  <span class={`w-1.5 h-1.5 rounded-full inline-block ${variant === 'verified' ? 'bg-blue-600' : variant === 'featured' ? 'bg-green-800' : variant === 'new' ? 'bg-amber-600' : 'bg-red-600'}`} aria-hidden="true"></span>
  {labels[variant]}
</span>
