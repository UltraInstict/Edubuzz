---
export interface Column {
  key: string;
  label: string;
  render?: 'text' | 'badge' | 'date' | 'number' | 'link' | 'actions';
  width?: string;
  align?: 'left' | 'center' | 'right';
}

export interface Props {
  columns: Column[];
  rows: Record<string, any>[];
  emptyMessage?: string;
}

const { columns, rows, emptyMessage = 'No data found.' } = Astro.props;

function renderCell(value: unknown, render?: string): string {
  const v = value ?? '';
  if (render === 'date') return String(v).slice(0, 10);
  if (render === 'number') return Number(v).toLocaleString('en-ZA');
  return String(v);
}
---

<div class="overflow-x-auto bg-white border border-gray-200 rounded-md">
  <table class="w-full border-collapse text-sm">
    <thead>
      <tr>
        {columns.map((col) => (
          <th
            style={col.width ? `width:${col.width}` : ''}
            class={`px-3 py-2.5 text-left font-semibold text-gray-900 bg-gray-50 border-b-2 border-gray-200 whitespace-nowrap text-xs ${col.align === 'center' ? 'text-center' : col.align === 'right' ? 'text-right' : ''}`}
          >
            {col.label}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.length === 0 ? (
        <tr>
          <td colspan={columns.length} class="py-12 px-4 text-center text-gray-500">{emptyMessage}</td>
        </tr>
      ) : (
        rows.map((row) => (
          <tr class="border-b border-gray-200 last:border-b-0 hover:bg-green-50/50">
            {columns.map((col) => (
              <td class={`px-3 py-2.5 text-gray-600 whitespace-nowrap ${col.align === 'center' ? 'text-center' : col.align === 'right' ? 'text-right' : ''}`}>
                <slot name={`cell-${col.key}`} row={row}>
                  <slot name="cell" row={row} column={col.key}>
                    {renderCell(row[col.key], col.render)}
                  </slot>
                </slot>
              </td>
            ))}
          </tr>
        ))
      )}
    </tbody>
  </table>
</div>
