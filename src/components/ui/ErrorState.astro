---
export interface Props {
  message?: string;
  retry?: string;
}

const { message = 'Something went wrong. Please try again.', retry } = Astro.props;
---

<div class="flex flex-col items-center justify-center py-10 px-6 text-center bg-red-50 border border-red-200 rounded-md" role="alert">
  <p class="text-sm text-red-800 max-w-md leading-relaxed mb-3">{message}</p>
  {retry && (
    <button class="bg-white text-red-600 border border-red-300 rounded-md text-sm font-medium px-4 py-2 hover:bg-red-100 transition-colors cursor-pointer" onclick="location.reload()">
      {retry}
    </button>
  )}
</div>
