---
export interface Props {
  title?: string;
  description?: string;
  action?: { label: string; href: string };
  icon?: 'search' | 'job' | 'application' | 'general' | 'none' | null;
}

const {
  title = 'Nothing here yet',
  description = 'Check back soon or try a different search.',
  action,
  icon = 'none',
} = Astro.props;

const icons: Record<string, string> = {
  search: '🔍',
  job: '💼',
  application: '📋',
  general: '📭',
};

const iconChar = icon && icon !== 'none' ? icons[icon] : '';
---

<div class="flex flex-col items-center justify-center py-12 px-6 text-center bg-white border border-gray-200 rounded-md">
  {iconChar && <span class="text-4xl mb-3" aria-hidden="true">{iconChar}</span>}
  <h2 class="text-base font-semibold text-gray-900 mb-1">{title}</h2>
  <p class="text-sm text-gray-600 max-w-sm leading-relaxed mb-4">{description}</p>
  {action && (
    <a href={action.href} class="inline-flex items-center bg-green-800 text-white rounded-md text-sm font-medium px-4 py-2 hover:bg-green-900 transition-colors">
      {action.label}
    </a>
  )}
</div>
