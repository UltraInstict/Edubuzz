---
export interface Props {
  width?: string;
  height?: string;
  count?: number;
  variant?: 'text' | 'card' | 'circle';
}

const { width = '100%', height = '1rem', count = 1, variant = 'text' } = Astro.props;

const style = variant === 'card'
  ? 'width: 100%; height: 96px; border-radius: var(--radius-md);'
  : variant === 'circle'
    ? `width: ${height}; height: ${height}; border-radius: 50%;`
    : `width: ${width}; height: ${height}; border-radius: var(--radius-sm);`;
---

{Array.from({ length: count }).map(() => (
  <div class="skeleton" style={style} aria-hidden="true" />
))}

<style>
  .skeleton {
    background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>
