---
export interface Props {
  width?: string;
  height?: string;
  count?: number;
  variant?: 'text' | 'card' | 'circle';
}

const { width = '100%', height = '1rem', count = 1, variant = 'text' } = Astro.props;

const cls = variant === 'card'
  ? 'w-full h-24 rounded-md'
  : variant === 'circle'
    ? `w-[${height}] h-[${height}] rounded-full`
    : `w-[${width}] h-[${height}] rounded`;
---

{Array.from({ length: count }).map(() => (
  <div
    class={`skeleton bg-gradient-to-r from-gray-200 via-gray-300 to-gray-200 bg-[length:200%_100%] ${cls}`}
    aria-hidden="true"
  />
))}

<style>
  .skeleton { animation: shimmer 1.5s ease-in-out infinite; }
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>
