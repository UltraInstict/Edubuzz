---
import MonetizationSlot from './MonetizationSlot.astro';
import { getCategoriesWithCounts, PROVINCES, slugify } from '../lib/pocketbase';
import { generateToken } from '../lib/csrf';
import { JOBS_PUBLIC } from '../lib/featureFlags';
import { EDUCATION_GUIDES } from '../content/education-guides';
import { CAREER_GUIDES } from '../content/career-guides';

interface Props { category?: string; }
const { category } = Astro.props;
const categories = JOBS_PUBLIC ? await getCategoriesWithCounts() : [];
const csrfToken = generateToken();

const BROWSE_LINKS = [
  { label: 'Education Guides', href: '/education' },
  { label: 'Career Guides', href: '/careers' },
  { label: 'Salary Guides', href: '/salary' },
  { label: 'Employer Guides', href: '/companies' },
];
const POPULAR_CAREERS = CAREER_GUIDES.filter(c => c.popular).slice(0, 6);
---

<div class="space-y-4">
  <div class="bg-white border border-gray-200 rounded-md p-5">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Explore</h3>
    <div class="space-y-1">
      {BROWSE_LINKS.map(l => <a href={l.href} class="block text-sm text-green-800 hover:text-green-900">{l.label}</a>)}
    </div>
  </div>

  <MonetizationSlot zone="sidebar" category={category} />

  {JOBS_PUBLIC && categories.length > 0 && (
    <div class="bg-white border border-gray-200 rounded-md p-5">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Browse by category</h3>
      <div class="space-y-0.5">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}`} class="flex justify-between text-sm text-green-800 hover:text-green-900 py-0.5">
            <span>{cat.name}</span>
            <span class="text-xs text-gray-400">{cat.count}</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="bg-white border border-gray-200 rounded-md p-5">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Popular career guides</h3>
    <div class="space-y-1">
      {POPULAR_CAREERS.map(c => (
        <a href={`/careers/${c.slug}`} class="block text-sm text-green-800 hover:text-green-900">{c.occupation}</a>
      ))}
      <a href="/careers" class="block text-sm text-green-800 font-medium mt-2 pt-1 border-t border-gray-200">View all career guides</a>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-md p-5">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Education guides</h3>
    <div class="space-y-1">
      {EDUCATION_GUIDES.slice(0, 5).map(g => (
        <a href={`/education/${g.slug}`} class="block text-sm text-green-800 hover:text-green-900">{g.h1}</a>
      ))}
      <a href="/education" class="block text-sm text-green-800 font-medium mt-2 pt-1 border-t border-gray-200">View all education guides</a>
    </div>
  </div>
</div>
