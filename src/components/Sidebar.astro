---
import AdSlot from './AdSlot.astro';
import { getCategories, PROVINCES, slugify } from '../lib/pocketbase';

const categories = await getCategories(7);
---

<div class="sidebar-stack">
  <AdSlot size="rectangle" />

  <section class="side-card">
    <h2>Browse by category</h2>
    <div class="category-list">
      {categories.map((cat) => (
        <a href={`/category/${cat.slug}`} class="category-row">
          <span>{cat.name}</span>
          <span class="count">{cat.job_count || 0}</span>
        </a>
      ))}
      <a href="/categories" class="view-all">View all</a>
    </div>
  </section>

  <section class="side-card">
    <h2>Browse by province</h2>
    <div class="province-grid">
      {PROVINCES.map((province) => (
        <a href={`/province/${slugify(province)}`}>{province}</a>
      ))}
    </div>
  </section>

  <section class="side-card">
    <h2>Job alert signup</h2>
    <form id="alert-form" action="/api/alerts" method="post" novalidate>
      <label>
        Email
        <input class="form-field" type="email" name="email" required />
      </label>
      <label>
        Keyword
        <input class="form-field" type="text" name="keyword" />
      </label>
      <label>
        Province
        <select class="form-field" name="province">
          <option value="">Any province</option>
          {PROVINCES.map((province) => <option value={province}>{province}</option>)}
        </select>
      </label>
      <p id="alert-error" class="alert-error" hidden>Email is required.</p>
      <p id="alert-status" class="alert-status" hidden></p>
      <button type="submit">Create alert</button>
    </form>
  </section>

  <AdSlot size="rectangle" />
</div>

<script>
  document.getElementById('alert-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const email = form.email.value.trim();
    const error = document.getElementById('alert-error') as HTMLParagraphElement;
    const status = document.getElementById('alert-status') as HTMLParagraphElement;

    error.hidden = true;
    status.hidden = true;

    if (!email) {
      error.hidden = false;
      return;
    }

    const response = await fetch('/api/alerts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(form))),
    });
    const body = await response.json().catch(() => ({}));
    status.textContent = response.ok ? 'Alert created.' : (body.message || 'Could not create alert.');
    status.hidden = false;
    if (response.ok) form.reset();
  });
</script>

<style>
  .sidebar-stack {
    display: grid;
    gap: 16px;
  }

  .side-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 1rem 1.25rem;
  }

  .side-card h2 {
    margin: 0 0 10px;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 600;
  }

  .category-list {
    display: grid;
    gap: 2px;
  }

  .category-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: #444444;
    font-size: 13px;
    padding: 5px 0;
  }

  .category-row:hover,
  .view-all:hover,
  .province-grid a:hover {
    color: #2d6a4f;
  }

  .count {
    background: #f3f2ee;
    border-radius: 10px;
    color: #888888;
    font-size: 11px;
    padding: 1px 6px;
  }

  .view-all {
    color: #2d6a4f;
    font-size: 12px;
    font-weight: 500;
    margin-top: 6px;
  }

  .province-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .province-grid a {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    color: #444444;
    font-size: 12px;
    line-height: 1.3;
    padding: 6px 7px;
    text-align: center;
  }

  form {
    display: grid;
    gap: 8px;
  }

  label {
    display: grid;
    gap: 4px;
    color: #444444;
    font-size: 12px;
    font-weight: 500;
  }

  button {
    width: 100%;
    border: 1px solid #2d6a4f;
    border-radius: 4px;
    background: #2d6a4f;
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    padding: 9px 12px;
  }

  button:hover {
    background: #245a42;
    border-color: #245a42;
  }

  .alert-error,
  .alert-status {
    margin: 0;
    font-size: 12px;
  }

  .alert-error {
    color: #9b1c1c;
  }

  .alert-status {
    color: #2d6a4f;
  }
</style>
