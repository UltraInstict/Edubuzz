---
import MonetizationSlot from './MonetizationSlot.astro';
import { getCategoriesWithCounts, PROVINCES, slugify } from '../lib/pocketbase';
import { generateToken } from '../lib/csrf';

interface Props { category?: string; }
const { category } = Astro.props;
const categories = await getCategoriesWithCounts();
const csrfToken = generateToken();

const BROWSE_LINKS = [
  { label: 'Remote Jobs', href: '/remote-jobs' },
  { label: 'Internships', href: '/internships' },
  { label: 'Graduate Jobs', href: '/graduate-jobs' },
  { label: 'Learnerships', href: '/learnerships' },
  { label: 'Bursaries', href: '/bursaries' },
];
const MOST_SEARCHED = ['General Worker','Admin','Security','Cashier','Driver','Cleaner','Warehouse','Receptionist','Data Capturer','Call Centre'];
---

<div class="space-y-4">
  <div class="bg-white border border-gray-200 rounded-md p-5">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Browse Jobs</h3>
    <div class="space-y-1">
      {BROWSE_LINKS.map(l => <a href={l.href} class="block text-sm text-green-800 hover:text-green-900">{l.label}</a>)}
    </div>
  </div>

  <MonetizationSlot zone="sidebar" category={category} />

  <div class="bg-white border border-gray-200 rounded-md p-5">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Browse by category</h3>
    <div class="space-y-0.5">
      {categories.map(cat => (
        <a href={`/category/${cat.slug}`} class="flex justify-between text-sm text-green-800 hover:text-green-900 py-0.5">
          <span>{cat.name}</span>
          <span class="text-xs text-gray-400">{cat.count}</span>
        </a>
      ))}
      <a href="/categories" class="block text-sm text-green-800 font-medium mt-2 pt-1 border-t border-gray-200">View all categories</a>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-md p-5">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Browse by province</h3>
    <div class="grid grid-cols-2 gap-1">
      {PROVINCES.map(p => (
        <a href={`/province/${slugify(p)}`} class="border border-gray-200 rounded-md px-3 py-2 text-sm text-green-800 hover:text-green-900 text-center">{p}</a>
      ))}
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-md p-5">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Most Searched</h3>
    <div class="space-y-1">
      {MOST_SEARCHED.map(term => (
        <a href={`/jobs?q=${encodeURIComponent(term)}`} class="block text-sm text-green-800 hover:text-green-900">{term} Jobs</a>
      ))}
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-md p-5">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Job alert signup</h3>
    <form id="alert-form" action="/api/alerts" method="post" novalidate class="space-y-3">
      <input type="hidden" name="_csrf" value={csrfToken} />
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="email" name="email" required />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Keyword</label>
        <input class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" type="text" name="keyword" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Province</label>
        <select class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:border-green-800" name="province">
          <option value="">Any province</option>
          {PROVINCES.map(p => <option value={p}>{p}</option>)}
        </select>
      </div>
      <button type="submit" class="w-full bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Create alert</button>
    </form>
  </div>
</div>

<script>
  document.getElementById('alert-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const res = await fetch('/api/alerts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
    const body = await res.json().catch(() => ({}));
    if (body.success) form.reset();
  });
</script>
ipt>
