---
import SmartAdSlot from './SmartAdSlot.astro';
import { getCategoriesWithCounts, PROVINCES, slugify } from '../lib/pocketbase';
import { generateToken } from '../lib/csrf';

interface Props {
  category?: string;
}

const { category } = Astro.props;

const categories = await getCategoriesWithCounts();
const csrfToken = generateToken();

// Static "Most Searched" jobs — hard-coded per spec
const MOST_SEARCHED = [
  'General Worker Jobs',
  'Admin Jobs',
  'Security Jobs',
  'Cashier Jobs',
  'Driver Jobs',
  'Cleaner Jobs',
  'Warehouse Jobs',
  'Receptionist Jobs',
  'Data Capturer Jobs',
  'Call Centre Jobs',
];

// Static Browse Jobs links — hard-coded per spec
const BROWSE_LINKS = [
  { label: 'Remote Jobs', href: '/remote-jobs' },
  { label: 'Internships', href: '/internships' },
  { label: 'Graduate Jobs', href: '/graduate-jobs' },
  { label: 'Learnerships', href: '/learnerships' },
  { label: 'Bursaries', href: '/bursaries' },
];
---

<div class="sidebar-stack">
  <!-- Section 1: Browse Jobs (static) -->
  <section class="side-card">
    <h2>Browse Jobs</h2>
    <div class="link-list">
      {BROWSE_LINKS.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>
  </section>

  <!-- Section 2: Sponsored affiliate slot (between Browse Jobs and Most Searched) -->
  <SmartAdSlot zone="sidebar" category={category} />

  <!-- Browse by category (kept for SEO + navigation) -->
  <section class="side-card">
    <h2>Browse by category</h2>
    <div class="category-list">
      {categories.map((cat) => (
        <a href={`/category/${cat.slug}`} class="category-row">
          <span>{cat.name}</span>
          <span class="count">{cat.count}</span>
        </a>
      ))}
      <a href="/categories" class="view-all">View all</a>
    </div>
  </section>

  <!-- Browse by province (kept for SEO + navigation) -->
  <section class="side-card">
    <h2>Browse by province</h2>
    <div class="province-grid">
      {PROVINCES.map((province) => (
        <a href={`/province/${slugify(province)}`}>{province}</a>
      ))}
    </div>
  </section>

  <!-- Section 3: Most Searched (static) -->
  <section class="side-card">
    <h2>Most Searched</h2>
    <div class="link-list">
      {MOST_SEARCHED.map((term) => (
        <a href={`/jobs?q=${encodeURIComponent(term.replace(/ Jobs$/, ''))}`}>{term}</a>
      ))}
    </div>
  </section>

  <!-- Section 4: Job Alerts subscription form (unchanged behaviour) -->
  <section class="side-card">
    <h2>Job alert signup</h2>
    <form id="alert-form" action="/api/alerts" method="post" novalidate>
      <input type="hidden" name="_csrf" value={csrfToken} />
      <label>
        Email
        <input class="form-field" type="email" name="email" required />
      </label>
      <label>
        Keyword
        <input class="form-field" type="text" name="keyword" />
      </label>
      <label>
        Province
        <select class="form-field" name="province">
          <option value="">Any province</option>
          {PROVINCES.map((province) => <option value={province}>{province}</option>)}
        </select>
      </label>
      <p id="alert-error" class="alert-error" hidden>Email is required.</p>
      <p id="alert-status" class="alert-status" hidden></p>
      <button type="submit">Create alert</button>
    </form>
  </section>
</div>

<script>
  document.getElementById('alert-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const email = form.email.value.trim();
    const error = document.getElementById('alert-error') as HTMLParagraphElement;
    const status = document.getElementById('alert-status') as HTMLParagraphElement;

    error.hidden = true;
    status.hidden = true;

    if (!email) {
      error.hidden = false;
      return;
    }

    const response = await fetch('/api/alerts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(form))),
    });
    const body = await response.json().catch(() => ({}));
    const okResponse = response.ok && body.success !== false;
    status.textContent = okResponse ? 'Alert created.' : (body.error || body.message || 'Could not create alert.');
    status.hidden = false;
    if (okResponse) form.reset();
  });
</script>

<style>
  .sidebar-stack {
    display: grid;
    gap: 16px;
  }

  .side-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 1rem 1.25rem;
  }

  .side-card h2 {
    margin: 0 0 10px;
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 600;
  }

  .category-list {
    display: grid;
    gap: 2px;
  }

  .category-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: #444444;
    font-size: 13px;
    padding: 5px 0;
  }

  .category-row:hover,
  .view-all:hover,
  .province-grid a:hover {
    color: #2d6a4f;
  }

  .count {
    background: #f3f2ee;
    border-radius: 10px;
    color: #888888;
    font-size: 11px;
    padding: 1px 6px;
  }

  .view-all {
    color: #2d6a4f;
    font-size: 12px;
    font-weight: 500;
    margin-top: 6px;
  }

  .province-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .province-grid a {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    color: #444444;
    font-size: 12px;
    line-height: 1.3;
    padding: 6px 7px;
    text-align: center;
  }

  form {
    display: grid;
    gap: 8px;
  }

  label {
    display: grid;
    gap: 4px;
    color: #444444;
    font-size: 12px;
    font-weight: 500;
  }

  button {
    width: 100%;
    border: 1px solid #2d6a4f;
    border-radius: 4px;
    background: #2d6a4f;
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    padding: 9px 12px;
  }

  button:hover {
    background: #245a42;
    border-color: #245a42;
  }

  .alert-error,
  .alert-status {
    margin: 0;
    font-size: 12px;
  }

  .alert-error {
    color: #9b1c1c;
  }

  .alert-status {
    color: #2d6a4f;
  }

  .link-list {
    display: grid;
    gap: 3px;
  }

  .link-list a {
    color: #444;
    font-size: 13px;
    padding: 5px 0;
  }

  .link-list a:hover {
    color: #2d6a4f;
  }

  /* Mobile: ensure sidebar stacks comfortably */
  @media (max-width: 480px) {
    .side-card {
      padding: 0.75rem 1rem;
    }
    .province-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
