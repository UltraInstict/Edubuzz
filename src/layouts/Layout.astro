---
import '../styles/global.css';
import { getSiteStats } from '../lib/pocketbase';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  noindex?: boolean;
  prevPage?: string;
  nextPage?: string;
}

const stats = await getSiteStats();
const {
  title = 'Find Jobs in South Africa',
  description = 'Search thousands of jobs across government, health, IT, education and more.',
  canonicalUrl = Astro.url.href,
  ogImage = 'https://edubuzz.co.za/og-default.png',
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  noindex = false,
  prevPage,
  nextPage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Edubuzz.co.za</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Edubuzz" />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    {prevPage && <link rel="prev" href={prevPage} />}
    {nextPage && <link rel="next" href={nextPage} />}
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    <!-- AdSense: add your ca-pub-XXXXXXXXXX ID above -->
    <script>
      window.googletag = window.googletag || {cmd:[]};
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Edubuzz',
      url: Astro.url.origin,
      description: 'South African job marketplace connecting employers with qualified candidates across all sectors.',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${Astro.url.origin}/?search={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Edubuzz',
        url: Astro.url.origin,
        logo: {
          '@type': 'ImageObject',
          url: `${Astro.url.origin}/favicon.svg`,
        },
      },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Edubuzz',
      url: Astro.url.origin,
      logo: {
        '@type': 'ImageObject',
        url: `${Astro.url.origin}/favicon.svg`,
      },
      description: 'South African job board connecting employers with qualified candidates across government, health, IT, and education sectors.',
      sameAs: [
        'https://www.facebook.com/edubuzzsa',
        'https://www.linkedin.com/company/edubuzzsa',
        'https://twitter.com/edubuzzsa',
      ],
    })} />
    <slot name="head" />
  </head>
  <body class="site-body">
    <div class="stats-bar">
      {stats.jobs === 1 ? '1 active job' : `${stats.jobs.toLocaleString('en-ZA')} active jobs`} across South Africa — updated daily
    </div>

    <nav class="site-nav" aria-label="Main navigation">
      <div class="container nav-inner">
        <a href="/" class="logo" aria-label="Edubuzz home"><span>Edu</span><span>buzz</span></a>
        <div class="nav-links">
          <a href="/jobs">Browse Jobs</a>
          <a href="/companies">Companies</a>
          <a href="/post-job">Post a Job</a>
        </div>
        <a href="/post-job" class="post-link">Post a Job</a>
        <details class="mobile-menu">
          <summary aria-label="Open menu"><span></span><span></span><span></span></summary>
          <div class="mobile-drawer">
            <a href="/jobs">Browse Jobs</a>
            <a href="/companies">Companies</a>
            <a href="/post-job">Post a Job</a>
          </div>
        </details>
      </div>
    </nav>

    <div class="page-wrapper">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-grid">
          <div>
            <a href="/" class="logo footer-logo"><span>Edu</span><span>buzz</span></a>
            <p>South African jobs, updated daily.</p>
          </div>
          <div>
            <h2>Job seekers</h2>
            <a href="/jobs">Browse jobs</a>
            <a href="/categories">By category</a>
            <a href="/provinces">By province</a>
            <a href="/resources">Resources</a>
          </div>
          <div>
            <h2>Employers</h2>
            <a href="/post-job">Post a job</a>
            <a href="/pricing">Pricing</a>
            <a href="/advertise">Advertise</a>
          </div>
          <div>
            <h2>Company</h2>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/privacy">Privacy policy</a>
            <a href="/terms">Terms of use</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Edubuzz.co.za</p>
          <p><a href="/advertise">Advertise with us</a> · <a href="/sitemap.xml">Sitemap</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
  }

  .site-body>.page-wrapper {
    flex: 1;
  }

  .stats-bar {
    width: 100%;
    background: #2d6a4f;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    line-height: 1.4;
    padding: 6px 1rem;
    min-height: 30px;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 52px;
    background: #ffffff;
    border-bottom: 1px solid #e0e0e0;
  }

  .nav-inner {
    height: 52px;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .logo {
    display: inline-flex;
    align-items: baseline;
    font-size: 19px;
    font-weight: 700;
    line-height: 1;
  }

  .logo span:first-child {
    color: #1a1a1a;
  }

  .logo span:last-child {
    color: #2d6a4f;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 8px;
  }

  .nav-links a,
  .mobile-drawer a {
    color: #444444;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 9px;
  }

  .nav-links a:hover,
  .mobile-drawer a:hover {
    background: #f3f2ee;
  }

  .post-link {
    margin-left: auto;
    background: #2d6a4f;
    color: #ffffff;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
  }

  .post-link:hover {
    background: #245a42;
  }

  .mobile-menu {
    display: none;
    margin-left: auto;
    position: relative;
  }

  .mobile-menu summary {
    display: grid;
    gap: 4px;
    width: 34px;
    height: 34px;
    align-content: center;
    justify-content: center;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    list-style: none;
    cursor: pointer;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu span {
    width: 16px;
    height: 2px;
    background: #444444;
  }

  .mobile-drawer {
    position: absolute;
    right: 0;
    top: 41px;
    display: grid;
    min-width: 190px;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 6px;
  }

  .site-footer {
    margin-top: 2rem;
    background: #ffffff;
    border-top: 1px solid #e0e0e0;
  }

  .footer-inner {
    padding-top: 2rem;
    padding-bottom: 1.25rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .footer-grid h2 {
    margin: 0 0 8px;
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 600;
  }

  .footer-grid p,
  .footer-grid a,
  .footer-bottom {
    color: #666666;
    font-size: 12px;
  }

  .footer-grid p {
    margin: 8px 0 0;
  }

  .footer-grid a {
    display: block;
    margin-top: 6px;
  }

  .footer-grid a:hover,
  .footer-bottom a:hover {
    color: #2d6a4f;
  }

  .footer-logo {
    font-size: 19px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #f0f0f0;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .nav-links,
    .post-link {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
