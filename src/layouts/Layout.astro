---
import '../styles/global.css';
import { getSiteStats } from '../lib/pocketbase';
import MonetizationSlot from '../components/MonetizationSlot.astro';
import { getAdminSettings } from '../services/jobService';
import { SITE_NAME, SITE_DESCRIPTION, SITE_TAGLINE, SITE_LOCALE, SITE_LANG, DEFAULT_OG_IMAGE, TWITTER_HANDLE, SOCIAL_URLS } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  noindex?: boolean;
  prevPage?: string;
  nextPage?: string;
  /**
   * Whether this page may serve ads. Defaults to `!noindex`. Set false on
   * thin/replicated/low-value screens (empty listings, doorway pSEO templates,
   * utility pages) so Google-served ads never appear on them — the exact
   * AdSense policy issue ("ads on screens with replicated/low value content").
   */
  adsEligible?: boolean;
}

const stats = await getSiteStats();
const {
  title = 'Find Jobs in South Africa',
  description = SITE_DESCRIPTION,
  canonicalUrl = Astro.url.href,
  ogImage = DEFAULT_OG_IMAGE,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  noindex = false,
  prevPage,
  nextPage,
  adsEligible = !noindex,
} = Astro.props;

const siteDomain = `${SITE_NAME}.co.za`;

// Canonical + og:url MUST be the production https origin. nginx proxies to the
// Node app over http, so Astro.url.href is http:// — never emit that as canonical.
// Rebuild from the configured SITE_URL origin, preserving path + query.
const SITE_ORIGIN = (import.meta.env.SITE_URL || process.env.SITE_URL || 'https://edubuzz.co.za').replace(/\/+$/, '');
let canonicalHref = `${SITE_ORIGIN}/`;
try {
  const u = new URL(canonicalUrl, SITE_ORIGIN);
  canonicalHref = `${SITE_ORIGIN}${u.pathname}${u.search}`;
} catch { /* keep origin root */ }

const paginationHead = [
  prevPage ? `<link rel="prev" href="${prevPage}" />` : '',
  nextPage ? `<link rel="next" href="${nextPage}" />` : '',
].filter(Boolean).join('\n    ');

const isAdmin = Astro.url.pathname.startsWith('/admin');
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || process.env.PUBLIC_ADSENSE_CLIENT || '';
const gaId = import.meta.env.PUBLIC_GA_ID || process.env.PUBLIC_GA_ID || '';

// Additional analytics + tag managers — all env-gated (inert until an ID is set).
const gtmId = import.meta.env.PUBLIC_GTM_ID || process.env.PUBLIC_GTM_ID || '';
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || process.env.PUBLIC_CLARITY_ID || '';
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || process.env.PUBLIC_META_PIXEL_ID || '';
const linkedInPartnerId = import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID || process.env.PUBLIC_LINKEDIN_PARTNER_ID || '';

// Search-engine ownership verification meta tags — env-gated.
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || process.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '';
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION || process.env.PUBLIC_BING_SITE_VERIFICATION || '';
const yandexVerification = import.meta.env.PUBLIC_YANDEX_VERIFICATION || process.env.PUBLIC_YANDEX_VERIFICATION || '';

// Analytics/tag scripts should never run on admin routes.
const enableAnalytics = !isAdmin;

// Gate AdSense script on admin settings (not just env var). Never load ad code
// on ad-ineligible screens (thin/replicated/low-value) — AdSense policy.
let showAdsenseScript = Boolean(adsenseClient && !isAdmin && adsEligible);
if (showAdsenseScript) {
  try {
    const ms = await getAdminSettings(['monetization_enabled', 'adsense_enabled']);
    // Only block if explicitly disabled; missing/unset defaults to enabled for revenue
    if (ms.monetization_enabled === 'false') showAdsenseScript = false;
    else if (ms.adsense_enabled !== 'true') showAdsenseScript = false;
  } catch {
    // PB unreachable — default to showing ads (revenue preservation)
  }
}
---

<!doctype html>
<html lang={SITE_LANG}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteDomain}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {bingSiteVerification && <meta name="msvalidate.01" content={bingSiteVerification} />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    {paginationHead && <Fragment set:html={paginationHead} />}
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    <script>
      window.googletag = window.googletag || {cmd:[]};
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_NAME,
      url: Astro.url.origin,
      description: SITE_DESCRIPTION,
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${Astro.url.origin}/?search={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
      publisher: { '@type': 'Organization', name: SITE_NAME, url: Astro.url.origin, logo: { '@type': 'ImageObject', url: `${Astro.url.origin}/favicon.svg` } },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: SITE_NAME,
      url: Astro.url.origin,
      logo: { '@type': 'ImageObject', url: `${Astro.url.origin}/favicon.svg` },
      description: SITE_DESCRIPTION,
      sameAs: [SOCIAL_URLS.facebook, SOCIAL_URLS.linkedin, SOCIAL_URLS.twitter],
    })} />
    <slot name="head" />
    {showAdsenseScript && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
    {enableAnalytics && gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    {enableAnalytics && gtmId && (
      <script define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      </script>
    )}
    {enableAnalytics && clarityId && (
      <script define:vars={{ clarityId }}>
        (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script",clarityId);
      </script>
    )}
    {enableAnalytics && metaPixelId && (
      <script define:vars={{ metaPixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init',metaPixelId);fbq('track','PageView');
      </script>
    )}
    {enableAnalytics && linkedInPartnerId && (
      <script define:vars={{ linkedInPartnerId }}>
        window._linkedin_partner_id=linkedInPartnerId;window._linkedin_data_partner_ids=window._linkedin_data_partner_ids||[];window._linkedin_data_partner_ids.push(linkedInPartnerId);(function(l){if(!l){window.lintrk=function(a,b){window.lintrk.q.push([a,b])};window.lintrk.q=[]}var s=document.getElementsByTagName("script")[0];var b=document.createElement("script");b.type="text/javascript";b.async=true;b.src="https://snap.licdn.com/li.lms-analytics/insight.min.js";s.parentNode.insertBefore(b,s);})(window.lintrk);
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    {enableAnalytics && gtmId && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    {enableAnalytics && metaPixelId && (
      <noscript set:html={`<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1" />`} />
    )}
    <div class="bg-green-800 text-white text-center text-xs py-1.5">
      {stats.jobs === 1 ? '1 active job' : `${stats.jobs.toLocaleString('en-ZA')} active jobs`} across South Africa — updated daily
    </div>

    <nav class="sticky top-0 z-50 bg-white border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center gap-6">
        <a href="/" class="text-lg font-bold text-gray-900">{SITE_NAME}</a>
        <div class="hidden md:flex items-center gap-6">
          <a href="/jobs" class="text-sm text-green-800 hover:text-green-900">Browse Jobs</a>
          <a href="/companies" class="text-sm text-green-800 hover:text-green-900">Companies</a>
        </div>
        <a href="/post-job" class="hidden md:inline-block ml-auto bg-green-800 text-white text-sm font-medium px-5 py-2.5 rounded-md hover:bg-green-900 transition-colors">Post a Job</a>
        <details class="md:hidden ml-auto">
          <summary class="text-sm text-gray-600 cursor-pointer list-none">Menu</summary>
          <div class="absolute right-4 top-14 bg-white border border-gray-200 rounded-md p-3 space-y-2 shadow-sm">
            <a href="/jobs" class="block text-sm text-green-800 hover:text-green-900">Browse Jobs</a>
            <a href="/companies" class="block text-sm text-green-800 hover:text-green-900">Companies</a>
            <a href="/post-job" class="block text-sm text-green-800 font-medium">Post a Job</a>
          </div>
        </details>
      </div>
    </nav>

    <div class="flex-1">
      <slot />
    </div>

    {!isAdmin && adsEligible && <MonetizationSlot zone="strip" />}

    <footer class="border-t border-gray-200 bg-white py-10">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div>
            <a href="/" class="text-lg font-bold text-gray-900">{SITE_NAME}</a>
            <p class="text-sm text-gray-500 mt-1">{SITE_TAGLINE}</p>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Job seekers</h3>
            <div class="space-y-2">
              <a href="/jobs" class="block text-sm text-green-800 hover:text-green-900">Browse jobs</a>
              <a href="/categories" class="block text-sm text-green-800 hover:text-green-900">By category</a>
              <a href="/provinces" class="block text-sm text-green-800 hover:text-green-900">By province</a>
              <a href="/resources" class="block text-sm text-green-800 hover:text-green-900">Resources</a>
            </div>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Employers</h3>
            <div class="space-y-2">
              <a href="/post-job" class="block text-sm text-green-800 hover:text-green-900">Post a job</a>
              <a href="/pricing" class="block text-sm text-green-800 hover:text-green-900">Pricing</a>
              <a href="/advertise" class="block text-sm text-green-800 hover:text-green-900">Advertise</a>
            </div>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Company</h3>
            <div class="space-y-2">
              <a href="/about" class="block text-sm text-green-800 hover:text-green-900">About</a>
              <a href="/contact" class="block text-sm text-green-800 hover:text-green-900">Contact</a>
              <a href="/privacy" class="block text-sm text-green-800 hover:text-green-900">Privacy policy</a>
              <a href="/cookie-policy" class="block text-sm text-green-800 hover:text-green-900">Cookie policy</a>
              <a href="/terms" class="block text-sm text-green-800 hover:text-green-900">Terms of use</a>
            </div>
          </div>
        </div>
        <div class="border-t border-gray-200 mt-8 pt-6 flex flex-col sm:flex-row justify-between gap-2">
          <p class="text-xs text-gray-400">&copy; {new Date().getFullYear()} {siteDomain}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
