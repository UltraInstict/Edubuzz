# ─── Edubuzz Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# PocketBase URL (local dev)
PB_URL=http://127.0.0.1:8090

# Site URL (used for sitemap, OG tags, canonical URLs)
SITE_URL=https://edubuzz.co.za

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CSRF_SECRET=generate-a-random-64-char-hex-string-here

# PocketBase admin credentials (REQUIRED — no hardcoded fallback)
# These are for the PocketBase _superusers collection
PB_ADMIN_EMAIL=admin@edubuzz.co.za
PB_ADMIN_PASSWORD=strong-admin-password-here

# IndexNow key for Bing/Yandex indexing
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=generate-a-random-32-char-hex-string-here

# ─── SMTP ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=465
SMTP_USER=noreply@edubuzz.co.za
SMTP_PASS=your-smtp-password

# ─── Ads ─────────────────────────────────────────────────────────────────────
# PUBLIC_PB_URL — public-facing PocketBase URL for browser-side file requests
# (must match a reverse-proxied path, e.g. /pb-api/ in your nginx config)
PUBLIC_PB_URL=https://edubuzz.co.za/pb-api

# Google AdSense client ID — only set this AFTER AdSense is approved
# Format: ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_CLIENT=

# Google Analytics 4 measurement ID — optional
# Format: G-XXXXXXXXXX
PUBLIC_GA_ID=

# ─── Analytics & Tag Managers (all optional — inert until set) ───────────────
# Google Tag Manager container ID — Format: GTM-XXXXXXX
PUBLIC_GTM_ID=
# Microsoft Clarity project ID — Format: 10-char alphanumeric (e.g. abcde12345)
PUBLIC_CLARITY_ID=
# Meta (Facebook) Pixel ID — Format: 15-16 digit number
PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag partner ID — Format: numeric partner ID
PUBLIC_LINKEDIN_PARTNER_ID=

# ─── Search Engine Ownership Verification (optional meta tags) ───────────────
# Google Search Console — content value of the google-site-verification meta tag
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools — content value of the msvalidate.01 meta tag
PUBLIC_BING_SITE_VERIFICATION=
# Yandex Webmaster — content value of the yandex-verification meta tag
PUBLIC_YANDEX_VERIFICATION=

# PayFast passphrase
PAYFAST_PASSPHRASE=your-payfast-passphrase

# ─── Job Import ──────────────────────────────────────────────────────────────
# Firecrawl API key for job scraping (https://firecrawl.dev)
FIRECRAWL_API_KEY=<placeholder>
