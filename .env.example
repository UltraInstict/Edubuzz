# ─── Edubuzz Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# PocketBase URL (local dev)
PB_URL=http://127.0.0.1:8090

# Anthropic API key — get from console.anthropic.com
# Used for AI job description generation
ANTHROPIC_API_KEY=sk-ant-...

# Production PocketBase URL (VPS)
# PB_URL=https://edubuzz.co.za/pb

# Site URL (used for sitemap, OG tags)
SITE=https://edubuzz.co.za
